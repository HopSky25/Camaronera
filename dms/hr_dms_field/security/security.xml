<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Technical group: in 19.0 a group without privilege_id is hidden
             from the user form, which replaces the old
             category_id="base.module_category_hidden". -->
        <record id="group_hr_public_dms" model="res.groups">
            <field name="name">DMS Is accessible publicly on employee profile</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="base.group_user" model="res.groups">
            <field
                name="implied_ids"
                eval="[(4, ref('hr_dms_field.group_hr_public_dms'))]"
            />
        </record>
    </data>
</odoo>
