<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70" />
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- 19.0: hr dropped the "employee_rights_setting_container" block;
                 the setting now lives in "employees_setting_container". -->
            <block name="employees_setting_container" position="inside">
                <setting
                    id="dms_public_employee_setting"
                    help="Allow employees to access their DMS Documents."
                >
                    <field name="group_hr_public_dms" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
