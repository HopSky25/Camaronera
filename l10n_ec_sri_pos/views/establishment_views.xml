<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista de establecimientos (sucursales = res.company) -->
    <record id="view_sri_establishment_list" model="ir.ui.view">
        <field name="name">ec.sri.establishment.list</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list string="Establecimientos">
                <field name="ec_sri_establishment_code"/>
                <field name="name"/>
                <field name="parent_id" string="Matriz"/>
                <field name="ec_sri_pos_count" string="POS"/>
            </list>
        </field>
    </record>

    <!-- Formulario del establecimiento: datos + sus puntos de venta -->
    <record id="view_sri_establishment_form" model="ir.ui.view">
        <field name="name">ec.sri.establishment.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="Establecimiento">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre del establecimiento"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ec_sri_establishment_code"/>
                            <field name="parent_id" string="Matriz (empresa padre)"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Puntos de venta" name="pos">
                            <field name="pos_config_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="ec_sri_point_id"/>
                                    <field name="ec_sri_final_consumer_id"/>
                                    <field name="invoice_journal_id"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Cada punto de venta emite Factura electrónica usando su
                                Punto de emisión SRI. Para mover un POS a otro establecimiento,
                                cambie su compañía desde el propio POS.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sri_establishments" model="ir.actions.act_window">
        <field name="name">Establecimientos</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_sri_establishment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_sri_establishment_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay establecimientos</p>
            <p>Los establecimientos son las sucursales (compañías) del RUC. La matriz es el establecimiento 001.</p>
        </field>
    </record>

    <menuitem id="menu_sri_establishments" name="Sucursales / POS"
              parent="l10n_ec_sri_community.menu_sri_locations"
              action="action_sri_establishments" sequence="10"
              groups="account.group_account_manager"/>
</odoo>
