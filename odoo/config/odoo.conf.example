[options]
; Append this directory to your existing addons_path; preserve your core addons.
addons_path = /opt/odoo/odoo/addons,/opt/odoo/custom-addons
; Cron must have time for bounded SOAP requests.
max_cron_threads = 1
limit_time_real_cron = 300
; Configure database and other server settings in your real config.
