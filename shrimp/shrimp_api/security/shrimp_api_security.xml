<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
         Reglas que hacen posible que la API lea SIN sudo.

         Todas son de SOLO LECTURA y con los cuatro perm_* declarados: una
         ir.rule que los calla vale para escribir y borrar también, y este
         proyecto ya tropezó con eso. El portal no gana escritura sobre nada:
         las escrituras siguen yendo por los métodos de negocio, en sudo, tras
         comprobar la propiedad (igual que los controladores del portal).

         El dominio es siempre user.partner_id, el mismo criterio que el resto
         de reglas del proyecto (no commercial_partner_id): los técnicos de
         campo son contactos hijos de su empresa verificadora y NO deben ver lo
         que ve la empresa.
         ================================================================= -->
    <record id="rule_api_key_portal_own" model="ir.rule">
        <field name="name">Claves de API: solo las propias (portal)</field>
        <field name="model_id" ref="shrimp_marketplace.model_shrimp_api_key"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_api_key_user_own" model="ir.rule">
        <field name="name">Claves de API: solo las propias (internos)</field>
        <field name="model_id" ref="shrimp_marketplace.model_shrimp_api_key"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_api_key_system_all" model="ir.rule">
