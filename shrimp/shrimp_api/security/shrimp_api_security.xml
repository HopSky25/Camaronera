<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
         Reglas que hacen posible que la API lea SIN sudo.

         Todas son de SOLO LECTURA y con los cuatro perm_* declarados: una
         ir.rule que los calla vale para escribir y borrar también, y este
         proyecto ya tropezó con eso. El portal no gana escritura sobre nada:
         las escrituras siguen yendo por los métodos de negocio, en sudo, tras
         comprobar la propiedad (igual que los controladores del portal).

         El dominio es siempre el socio por el que actúa el usuario
         (user.shrimp_actor_partner_id: un subusuario actúa en nombre de su
         empresa), no commercial_partner_id: los técnicos de campo actúan con
         su propio contacto y NO deben ver lo que ve la empresa.
         ================================================================= -->
    <record id="rule_api_key_portal_own" model="ir.rule">
        <field name="name">Claves de API: solo las propias (portal)</field>
        <field name="model_id" ref="shrimp_marketplace.model_shrimp_api_key"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_api_key_user_own" model="ir.rule">
        <field name="name">Claves de API: solo las propias (internos)</field>
        <field name="model_id" ref="shrimp_marketplace.model_shrimp_api_key"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_api_key_system_all" model="ir.rule">
        <field name="name">Claves de API: el administrador ve todas</field>
        <field name="model_id" ref="shrimp_marketplace.model_shrimp_api_key"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_api_device_portal_own" model="ir.rule">
        <field name="name">Dispositivos de la app: solo los propios (portal)</field>
        <field name="model_id" ref="model_shrimp_api_device"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- Supervisor de la app (interno): sus propios dispositivos. Como el
         grupo lo tiene todo administrador, hace falta la regla «todos» del
         administrador: las reglas de grupo se combinan con O. -->
    <record id="rule_api_device_app_supervisor_own" model="ir.rule">
