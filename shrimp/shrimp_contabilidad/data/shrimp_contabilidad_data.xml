<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lectura de verificaciones y órdenes de empaque para el área contable
         si shrimp_verification / shrimp_copacking están instalados. Se repite
         en cada actualización (-u) por si se instalaron después. -->
    <function model="shrimp.contabilidad.setup" name="_ensure_optional_access"/>
    <!-- Diarios de fábrica con nombre en inglés, al español (idempotente). -->
    <function model="shrimp.contabilidad.setup" name="_traducir_diarios_fabrica"/>
</odoo>
