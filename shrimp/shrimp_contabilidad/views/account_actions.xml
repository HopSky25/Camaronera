<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retenciones emitidas (comprobante 07 del SRI): mismas vistas del
         módulo l10n_ec_sri_community, filtradas por tipo. -->
    <record id="action_sri_retenciones" model="ir.actions.act_window">
        <field name="name">Retenciones emitidas</field>
        <field name="res_model">ec.sri.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('document_type', '=', '07')]</field>
        <field name="context">{'default_document_type': '07'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No hay retenciones emitidas.</p>
            <p>Las retenciones se crean desde la factura de proveedor con el botón
               «Crear retención».</p>
        </field>
    </record>

    <!-- Conciliación: apuntes con saldo pendiente en cuentas conciliables
         (bancos, clientes, proveedores). Seleccione los apuntes que se
         compensan y use Acción › Conciliar. -->
    <record id="action_apuntes_por_conciliar" model="ir.actions.act_window">
        <field name="name">Apuntes por conciliar</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note'))]</field>
        <field name="context">{'search_default_unreconciled': 1, 'search_default_posted': 1, 'search_default_group_by_account': 1}</field>
    </record>
</odoo>
