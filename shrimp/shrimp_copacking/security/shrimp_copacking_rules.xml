<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- TODAS estas reglas son de SOLO LECTURA, y el desglose por permiso
             es deliberado.

             En Odoo, una ir.rule sin perm_* declarados vale para las cuatro
             operaciones, asi que el dominio de lectura se convierte tambien en
             dominio de escritura y borrado. Este proyecto ya tropezo con eso en
             shrimp_packer: la camaronera que RECIBIA una lista de precios podia
             cambiarle los precios a la empacadora que se la mando.

             Aqui el portal no necesita escribir nada: el controlador hace todas
             las mutaciones en sudo, despues de comprobar la propiedad del
             registro. Por eso el ACL le da write/create/unlink = 0 y estas
             reglas solo abren lectura.
        -->


        <!-- === DIRECTORIO ===
             Odoo solo deja a un usuario de portal ver contactos ligados a sus
             propios registros, asi que sin esto el directorio sale vacio y la
             camaronera no puede ni elegir a quien pedirle.
             Se abre lo minimo: maquiladores, y solo los que activaron la
             casilla de aparecer. Un directorio es publico por definicion; lo
             que no se abre son las tarifas, que viven en otro modelo con sus
             propias reglas. -->
        <record id="rule_copack_directorio" model="ir.rule">
            <field name="name">Directorio: maquiladores que quieren aparecer</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <!-- Varios perfiles: maquilador activo o con el perfil aprobado. -->
            <field name="domain_force">['|', ('shrimp_user_type', '=', 'maquilador'), ('shrimp_role_ids', 'any', [('role', '=', 'maquilador'), ('state', '=', 'approved')]), ('pack_en_directorio', '=', True)]</field>
        </record>


        <!-- Leer al contacto de la contraparte. La regla nativa de Odoo solo
             deja a un usuario de portal ver los contactos ligados a SUS
             registros, asi que el maquilador recibia un 403 nada mas pintar el
             nombre del cliente en su lista de ordenes.
             Se abre lo justo: quien publico una solicitud que yo puedo ver, y
             con quien tengo una orden. Ni un contacto mas. -->
        <record id="rule_copack_contrapartes" model="ir.rule">
            <field name="name">Empaque: contactos de mi contraparte</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                ['|', '|',
                 '&amp;', ('copack_request_ids.state', '=', 'published'),
                          '|', ('copack_request_ids.is_open', '=', True),
                               ('copack_request_ids.copacker_partner_id', '=', user.shrimp_actor_partner_id.id),
                 ('copack_order_client_ids.copacker_partner_id', '=', user.shrimp_actor_partner_id.id),
                 ('copack_order_copacker_ids.client_partner_id', '=', user.shrimp_actor_partner_id.id)]
            </field>
        </record>

        <!-- === SOLICITUDES ===
             El cliente ve las suyas. El maquilador ve las publicadas, que es
             justo lo que tiene que poder ver para ofertar: si no viera las
             ajenas no habria bandeja. -->
        <record id="rule_copack_request_cliente" model="ir.rule">
            <field name="name">Solicitudes de empaque: las propias del cliente</field>
            <field name="model_id" ref="model_shrimp_copack_request"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('client_partner_id', '=', user.shrimp_actor_partner_id.id)]</field>
        </record>

        <!-- Las reglas del mismo grupo se suman con O, asi que esta AMPLIA la
             anterior. El maquilador ve:
             - las solicitudes en las que ya participa, en cualquier estado: la
               que se le adjudico (la orden es suya) y aquellas en las que
               oferto. Sin esto, la bandeja de la app con ?state=assigned o
               done salia vacia aunque el trabajo fuera suyo.
             - la bandeja: las publicadas abiertas a todos o dirigidas a el.
             La bandeja de publicadas exige actuar como maquilador: el perfil de
             la peticion (shrimp_role: la API con X-Shrimp-Role, validado en
             ir.rule) o, si no hay, el perfil activo del usuario
             (shrimp_active_role, CR-12); con otro perfil solo se
             ve aquello en lo que se participa, nunca las publicadas de otros ni
             las adjudicadas a otra planta. Todo con el socio por el que actua
             el usuario (shrimp_actor_partner_id: subusuarios).
             El registro esta en un bloque noupdate: en una base ya instalada
             el dominio lo reescribe migrations/19.0.1.18.0. -->
        <record id="rule_copack_request_bandeja" model="ir.rule">
            <field name="name">Solicitudes de empaque: bandeja del maquilador</field>
            <field name="model_id" ref="model_shrimp_copack_request"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                (['|', '|',
                  ('order_id.copacker_partner_id', '=', user.shrimp_actor_partner_id.id),
                  ('offer_ids.copacker_partner_id', '=', user.shrimp_actor_partner_id.id),
                  '&amp;', ('state', '=', 'published'),
                           '|', ('is_open', '=', True),
                                ('copacker_partner_id', '=', user.shrimp_actor_partner_id.id)]
                 if (shrimp_role or user.shrimp_active_role) == 'maquilador' else
                 ['|',
                  ('order_id.copacker_partner_id', '=', user.shrimp_actor_partner_id.id),
                  ('offer_ids.copacker_partner_id', '=', user.shrimp_actor_partner_id.id)])
            </field>
        </record>


        <!-- === TARIFAS ===
             Mismo criterio que las listas de precios: cada cliente ve solo la
             que le dirigieron, nunca la del vecino. -->
        <record id="rule_copack_tariff_emisor" model="ir.rule">
            <field name="name">Tarifas de empaque: las que publica el maquilador</field>
            <field name="model_id" ref="model_shrimp_copack_tariff"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('copacker_partner_id', '=', user.shrimp_actor_partner_id.id)]</field>
        </record>

        <record id="rule_copack_tariff_destinatario" model="ir.rule">
            <field name="name">Tarifas de empaque: las dirigidas al cliente</field>
            <field name="model_id" ref="model_shrimp_copack_tariff"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">['&amp;', ('state', '=', 'published'), ('recipient_ids', 'in', user.shrimp_actor_partner_id.shrimp_grupo_ids())]</field>
        </record>

        <record id="rule_copack_tariff_line" model="ir.rule">
            <field name="name">Renglones: siguen a su tarifa</field>
            <field name="model_id" ref="model_shrimp_copack_tariff_line"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">['|', ('tariff_id.copacker_partner_id', '=', user.shrimp_actor_partner_id.id), '&amp;', ('tariff_id.state', '=', 'published'), ('tariff_id.recipient_ids', 'in', user.shrimp_actor_partner_id.shrimp_grupo_ids())]</field>
        </record>

        <!-- === OFERTAS ===
             El maquilador ve las suyas; el cliente ve las que recibio. -->
        <record id="rule_copack_offer_partes" model="ir.rule">
            <field name="name">Ofertas de empaque: solo las partes</field>
            <field name="model_id" ref="model_shrimp_copack_offer"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                ['|',
                 ('copacker_partner_id', '=', user.shrimp_actor_partner_id.id),
                 ('request_id.client_partner_id', '=', user.shrimp_actor_partner_id.id)]
            </field>
        </record>

        <!-- === ORDENES === -->
        <record id="rule_copack_order_partes" model="ir.rule">
            <field name="name">Órdenes de empaque: solo las partes</field>
            <field name="model_id" ref="model_shrimp_copack_order"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                ['|',
                 ('client_partner_id', '=', user.shrimp_actor_partner_id.id),
                 ('copacker_partner_id', '=', user.shrimp_actor_partner_id.id)]
            </field>
        </record>

        <!-- === FIRMAS DEL ACTA === -->
        <record id="rule_copack_acceptance_partes" model="ir.rule">
            <field name="name">Firmas del acta: solo las partes</field>
            <field name="model_id" ref="model_shrimp_copack_acceptance"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                ['|',
                 ('order_id.client_partner_id', '=', user.shrimp_actor_partner_id.id),
                 ('order_id.copacker_partner_id', '=', user.shrimp_actor_partner_id.id)]
            </field>
        </record>

        <!-- === CANCELACIONES CON EL CAMARON EN PLANTA (D-34) === -->
        <record id="rule_copack_cancellation_partes" model="ir.rule">
            <field name="name">Cancelaciones de empaque: solo las partes</field>
            <field name="model_id" ref="model_shrimp_copack_cancellation"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                ['|',
                 ('order_id.client_partner_id', '=', user.shrimp_actor_partner_id.id),
                 ('order_id.copacker_partner_id', '=', user.shrimp_actor_partner_id.id)]
            </field>
        </record>

    </data>

    <!-- ================================================================
         App «Copacking» del backoffice (19.0.1.13.0). Fuera del bloque
         noupdate: los grupos se actualizan con el módulo.

         Quién VE la app y su configuración. El acceso a los datos no cambia:
         «Usuario» implica Operador y «Administrador» implica Administrador de
         los datos de la plataforma (shrimp_marketplace).
         ================================================================ -->
    <record id="res_groups_privilege_copacking" model="res.groups.privilege">
        <field name="name">CamaronMarket · Copacking</field>
        <field name="sequence">62</field>
    </record>

    <record id="group_copacking_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_copacking"/>
        <field name="implied_ids" eval="[(4, ref('shrimp_marketplace.group_shrimp_user'))]"/>
        <field name="comment">Ve la app Copacking: órdenes y solicitudes de empaque, maquiladores y sus tarifas.</field>
    </record>

    <record id="group_copacking_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_copacking"/>
        <field name="implied_ids" eval="[(4, ref('group_copacking_user')), (4, ref('shrimp_marketplace.group_shrimp_manager'))]"/>
        <field name="comment">Además: configuración de la app (ajustes de empaque).</field>
    </record>

    <!-- Todo administrador del sistema administra también Copacking. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_copacking_manager'))]"/>
    </record>
</odoo>
