<odoo>

  <!-- ================================================================
       LISTA DE ORDENES. Sirve a las dos partes: la regla de acceso ya
       devuelve solo las propias, asi que la plantilla no filtra nada.
       ================================================================ -->
  <template id="copack_orders" name="Órdenes de empaque">
    <t t-call="website.layout">
      <div class="shrimp-bg">
        <div class="shrimp-page shrimp-page--full py-4">

          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h2 class="mb-0">Órdenes de empaque</h2>
            <t t-if="not soy_maquilador">
              <a href="/marketplace/empaque" class="btn btn-outline-secondary">Directorio</a>
            </t>
          </div>

          <t t-if="mensaje"><div class="alert alert-success">Listo.</div></t>

          <t t-if="not ordenes">
            <div class="alert alert-light border">Todavía no hay órdenes de empaque.</div>
          </t>
          <t t-else="">
            <table class="table table-hover bg-white align-middle">
              <thead>
                <tr>
                  <th>Referencia</th>
                  <th><t t-if="soy_maquilador">Cliente</t><t t-else="">Planta</t></th>
                  <th class="text-end">Acordadas</th>
                  <th class="text-end">Recibidas</th>
                  <th class="text-end">Empacadas</th>
                  <th class="text-end">Diferencia</th>
                  <th>Estado</th><th>Acta</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="ordenes" t-as="o">
                  <tr>
                    <td>
                      <a t-attf-href="/marketplace/empaque/orden/#{o.uuid_ref}"><t t-esc="o.name"/></a>
                    </td>
                    <td>
                      <t t-if="soy_maquilador"><t t-esc="o.client_partner_id.name"/></t>
                      <t t-else=""><t t-esc="o.copacker_partner_id.name"/></t>
                    </td>
                    <td class="text-end"><t t-esc="int(o.agreed_qty_lb)"/></td>
                    <td class="text-end"><t t-esc="int(o.received_lb)"/></td>
                    <td class="text-end"><t t-esc="int(o.packed_lb)"/></td>
                    <td class="text-end">
                      <t t-if="o.packed_lb">
                        <span t-att-class="'text-success' if o.cuadra else 'text-danger fw-bold'">
                          <t t-esc="round(o.difference_lb, 2)"/> lb
                        </span>
                      </t>
                      <t t-else="">—</t>
                    </td>
                    <td>
                      <span class="badge text-bg-secondary">
                        <t t-esc="dict(o._fields['state'].selection).get(o.state)"/>
                      </span>
                    </td>
                    <td>
                      <t t-if="o.acceptance_state == 'open'">
                        <span class="badge text-bg-warning">A la firma</span>
                      </t>
                      <t t-elif="o.acceptance_state == 'closed'">
                        <span class="badge text-bg-success">Firmada</span>
                      </t>
                      <t t-elif="o.acceptance_state == 'disputed'">
                        <span class="badge text-bg-danger">En disputa</span>
                      </t>
                      <t t-else=""><span class="text-muted small">—</span></t>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>
          </t>

        </div>
      </div>
    </t>
  </template>

  <!-- ================================================================
       DETALLE DE LA ORDEN Y FIRMA DEL ACTA
       ================================================================ -->
  <template id="copack_order_detail" name="Orden de empaque">
    <t t-call="website.layout">
      <div class="shrimp-bg">
        <div class="shrimp-page py-4">

          <!-- La pantalla es la misma para las dos partes, pero la vuelta no:
               al maquilador se le manda aqui tras registrar recepcion o empaque
               y esta migaja lo soltaba en la zona del cliente. -->
          <a t-att-href="volver_url" class="btn btn-sm btn-link mb-2">&#8592; <t t-esc="volver_txt"/></a>
          <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
              <h2 class="mb-1"><t t-esc="orden.name"/></h2>
              <p class="text-muted mb-0">
                <t t-esc="orden.client_partner_id.name"/>
                &#160;&#8594;&#160;
                <t t-esc="orden.copacker_partner_id.name"/>
                <t t-if="orden.copacker_partner_id.pack_codigo_establecimiento">
                  &#160;·&#160; Establecimiento <b><t t-esc="orden.copacker_partner_id.pack_codigo_establecimiento"/></b>
                </t>
              </p>
            </div>
            <span class="badge text-bg-secondary fs-6">
              <t t-esc="dict(orden._fields['state'].selection).get(orden.state)"/>
            </span>
          </div>

          <t t-if="mensaje == 'reabierta'">
            <div class="alert alert-warning mt-3">
              Acta reabierta. La orden vuelve a «recibida»: hay que rectificar el empaque
              y firmarla de nuevo las dos partes.
            </div>
          </t>
          <t t-elif="mensaje == 'cerrada'">
            <div class="alert alert-success mt-3">Trabajo cerrado.</div>
          </t>
          <t t-elif="mensaje"><div class="alert alert-success mt-3">Listo.</div></t>
          <t t-if="error"><div class="alert alert-danger mt-3"><t t-esc="error"/></div></t>

          <!-- EL CUADRE: es lo que la gente viene a mirar, asi que va arriba -->
          <div class="card my-3">
            <div class="card-body">
              <h6 class="text-uppercase text-muted small mb-3">El cuadre</h6>
              <div class="row text-center">
                <div class="col-4">
                  <div class="text-muted small">Recibidas</div>
                  <div class="fs-4 fw-bold"><t t-esc="int(orden.received_lb)"/></div>
                  <div class="text-muted small">lb</div>
                </div>
                <div class="col-4">
                  <div class="text-muted small">Empacadas</div>
                  <div class="fs-4 fw-bold"><t t-esc="int(orden.packed_lb)"/></div>
                  <div class="text-muted small">lb</div>
                </div>
                <div class="col-4">
                  <div class="text-muted small">Diferencia</div>
                  <div t-att-class="'fs-4 fw-bold ' + ('text-success' if orden.cuadra else 'text-danger')">
                    <t t-esc="round(orden.difference_lb, 2)"/>
                  </div>
                  <div class="text-muted small">
                    <t t-esc="round(orden.difference_pct, 2)"/> % · tolerancia <t t-esc="orden.tolerance_pct"/> %
                  </div>
                </div>
              </div>
              <t t-if="orden.packed_lb">
                <div class="mt-3">
                  <t t-if="orden.cuadra">
                    <div class="alert alert-success mb-0 py-2">
                      Cuadra: la diferencia está dentro de la tolerancia pactada.
                    </div>
                  </t>
                  <t t-else="">
                    <div class="alert alert-danger mb-0 py-2">
                      No cuadra: la diferencia se pasa de la tolerancia. Antes de firmar,
                      aclárenlo entre las partes.
                    </div>
                  </t>
                </div>
              </t>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-body">
                  <h6 class="text-uppercase text-muted small mb-3">El trabajo</h6>
                  <dl class="row mb-0 small">
                    <dt class="col-6">Libras acordadas</dt>
                    <dd class="col-6 text-end"><t t-esc="int(orden.agreed_qty_lb)"/></dd>
                    <dt class="col-6">Tarifa</dt>
                    <dd class="col-6 text-end">$ <t t-esc="round(orden.rate_per_lb, 3)"/> / lb</dd>
                    <dt class="col-6">Cajas / masters</dt>
                    <dd class="col-6 text-end"><t t-esc="orden.boxes or '—'"/></dd>
                    <dt class="col-6">Presentación empacada</dt>
                    <dd class="col-6 text-end"><t t-esc="orden.packed_presentation or '—'"/></dd>
                    <dt class="col-6">Recepción</dt>
                    <dd class="col-6 text-end"><t t-esc="orden.received_date or '—'"/></dd>
                    <dt class="col-6">Entrega</dt>
                    <dd class="col-6 text-end"><t t-esc="orden.packed_date or '—'"/></dd>
                    <dt class="col-6 border-top pt-2">A cobrar por el empaque</dt>
                    <dd class="col-6 text-end border-top pt-2 fw-bold">
                      $ <t t-esc="round(orden.service_amount, 2)"/>
                    </dd>
                  </dl>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-body">
                  <h6 class="text-uppercase text-muted small mb-3">Insumos</h6>
                  <p class="small"><t t-esc="orden.supplies_notes or 'No se detallaron.'"/></p>
                  <t t-if="orden.supplies_received">
                    <span class="badge text-bg-success">Recibidos completos</span>
                  </t>
                  <t t-elif="orden.supplies_issue">
                    <span class="badge text-bg-danger">Incompletos</span>
                    <p class="small text-danger mt-2 mb-0"><t t-esc="orden.supplies_issue"/></p>
                  </t>
                  <t t-else="">
                    <span class="badge text-bg-secondary">Sin confirmar</span>
                  </t>
                </div>
              </div>
            </div>
          </div>


          <!-- Acciones del maquilador. Van en la misma pantalla que ve el
               cliente a proposito: las dos partes miran los mismos numeros, y
               eso evita la mitad de las discusiones. -->
          <t t-if="rol == 'copacker' and orden.state == 'confirmed'">
            <div class="card mt-3 border-primary">
              <div class="card-body">
                <h6 class="text-uppercase text-muted small mb-3">Registrar la recepción</h6>
                <form method="post" t-attf-action="/maquilador/orden/#{orden.uuid_ref}/recepcion">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <div class="row g-3">
                    <div class="col-md-4">
                      <label class="form-label">Libras recibidas *</label>
                      <input type="number" step="0.01" min="0.01" name="received_lb"
                             class="form-control" required="required"
                             t-att-value="int(orden.agreed_qty_lb)"/>
                    </div>
                    <div class="col-md-8">
                      <label class="form-label">Insumos</label>
                      <div class="form-check">
                        <input type="checkbox" name="supplies_received" class="form-check-input"
                               checked="checked"/>
                        <label class="form-check-label">Llegaron completos</label>
                      </div>
                      <input type="text" name="supplies_issue" class="form-control mt-2"
                             placeholder="Si faltó algo, dilo aquí"/>
                    </div>
                  </div>
                  <button type="submit" class="btn btn-primary mt-3">Registrar recepción</button>
                </form>
              </div>
            </div>
          </t>

          <t t-if="rol == 'copacker' and orden.state == 'received'">
            <div class="card mt-3 border-primary">
              <div class="card-body">
                <h6 class="text-uppercase text-muted small mb-3">Registrar el empaque</h6>
                <form method="post" t-attf-action="/maquilador/orden/#{orden.uuid_ref}/empaque">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <div class="row g-3">
                    <div class="col-md-4">
                      <label class="form-label">Libras empacadas *</label>
                      <input type="number" step="0.01" min="0.01" name="packed_lb"
                             class="form-control" required="required"/>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Cajas / masters</label>
                      <input type="number" step="1" min="0" name="boxes" class="form-control"/>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Presentación empacada</label>
                      <input type="text" name="packed_presentation" class="form-control"/>
                    </div>
                  </div>
                  <p class="text-muted small mt-2 mb-0">
                    Al registrar el empaque se abre el acta y las dos partes tienen que
                    firmarla. No se puede entregar más de lo que entró.
                  </p>
                  <button type="submit" class="btn btn-primary mt-2">Registrar empaque</button>
                </form>
              </div>
            </div>
          </t>

          <!-- ACTA -->
          <t t-if="orden.acceptance_state != 'na'">
            <div class="card mt-3">
              <div class="card-body">
                <h6 class="text-uppercase text-muted small mb-3">Acta de empaque</h6>

                <t t-foreach="orden.sudo().acceptance_ids.sorted('role')" t-as="f">
                  <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                    <div>
                      <b><t t-esc="f.partner_id.name"/></b>
                      <span class="text-muted small">
                        (<t t-esc="dict(f._fields['role'].selection).get(f.role)"/>)
                      </span>
                      <t t-if="f.reason">
                        <div class="small text-danger"><t t-esc="f.reason"/></div>
                      </t>
                    </div>
                    <div class="text-end">
                      <t t-if="f.decision == 'accepted'">
                        <span class="badge text-bg-success">Conforme</span>
                      </t>
                      <t t-elif="f.decision == 'rejected'">
                        <span class="badge text-bg-danger">No conforme</span>
                      </t>
                      <t t-else=""><span class="badge text-bg-warning">Pendiente</span></t>
                      <t t-if="f.decided_at">
                        <div class="small text-muted"><t t-esc="f.decided_at"/></div>
                      </t>
                    </div>
                  </div>
                </t>

                <t t-if="mi_firma and mi_firma.decision == 'pending'">
                  <!-- Dos formularios y no uno: el modelo exige el motivo para
                       no dar conformidad, y con un solo formulario el textarea
                       no podia llevar "required" sin bloquear tambien al que si
                       esta conforme. Asi el motivo se pide aqui y no despues de
                       un viaje de ida y vuelta al servidor. -->
                  <form method="post" t-attf-action="/marketplace/empaque/orden/#{orden.uuid_ref}/firmar"
                        class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="decision" value="accepted"/>
                    <button type="submit" class="btn btn-success">Estoy conforme</button>
                    <span class="text-muted small ms-2">
                      Firmar da por buenas las libras de arriba.
                    </span>
                  </form>
                  <form method="post" t-attf-action="/marketplace/empaque/orden/#{orden.uuid_ref}/firmar"
                        class="mt-3 border-top pt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="decision" value="rejected"/>
                    <div class="mb-2">
                      <label class="form-label small">
                        Si no estás conforme, di por qué. Es lo que abre la discusión con la otra parte.
                      </label>
                      <textarea name="motivo" class="form-control" rows="2" required="required"
                                placeholder="Qué no cuadra: libras, presentación, insumos…"></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-danger">
                      No estoy conforme
                    </button>
                  </form>
                </t>
                <t t-elif="mi_firma">
                  <p class="text-muted small mt-3 mb-0">Ya firmaste. No se puede cambiar.</p>
                </t>
              </div>
            </div>
          </t>

          <!-- ACTA EN DISPUTA. Sin esto la orden se quedaba congelada para
               siempre: una parte decia que no y ya no habia por donde seguir.
               Reabrirla la devuelve a «recibida» para rectificar el empaque. -->
          <t t-if="orden.acceptance_state == 'disputed'">
            <div class="card mt-3 border-danger">
              <div class="card-body">
                <h6 class="text-uppercase text-muted small mb-2">El acta está en disputa</h6>
                <p class="small text-muted mb-3">
                  Mientras no se resuelva, el trabajo no se cierra ni se liquida. Si ya
                  aclararon qué pasó, reabran el acta: la orden vuelve a «recibida», el
                  maquilador rectifica las libras empacadas y las dos partes firman otra
                  vez. Puede hacerlo cualquiera de las dos.
                </p>
                <form method="post"
                      t-attf-action="/marketplace/empaque/orden/#{orden.uuid_ref}/reabrir-acta">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <div class="mb-2">
                    <label class="form-label small">Motivo de la reapertura *</label>
                    <textarea name="motivo" class="form-control" rows="2" required="required"
                              placeholder="Qué se acordó y qué se va a rectificar"></textarea>
                  </div>
                  <button type="submit" class="btn btn-outline-danger">Reabrir el acta</button>
                </form>
              </div>
            </div>
          </t>

          <!-- CIERRE. action_close() existia sin ruta: el acta se firmaba y la
               orden se quedaba en «firmada» para siempre. -->
          <t t-if="orden.state == 'signed'">
            <form method="post" t-attf-action="/marketplace/empaque/orden/#{orden.uuid_ref}/cerrar"
                  class="mt-3">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <button type="submit" class="btn btn-primary">Dar por cerrado el trabajo</button>
              <span class="text-muted small ms-2">
                Las dos partes firmaron lo mismo. Cerrarlo lo saca de lo pendiente.
              </span>
            </form>
          </t>
          <t t-if="orden.state in ('confirmed', 'received', 'packed') and orden.acceptance_state != 'closed'">
            <form method="post" t-attf-action="/marketplace/empaque/orden/#{orden.uuid_ref}/cancelar"
                  class="mt-3" onsubmit="return confirm('¿Cancelar este trabajo? No se puede deshacer.');">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar el trabajo</button>
              <span class="text-muted small ms-2">
                Si ya se empacó, acláralo en el acta antes de cancelar.
              </span>
            </form>
          </t>

        </div>
      </div>
    </t>
  </template>

</odoo>
