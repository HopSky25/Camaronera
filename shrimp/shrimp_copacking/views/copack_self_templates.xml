<odoo>

  <!-- ================================================================
       EMPAQUE PROPIO. La empresa (camaronera o empacadora) con el perfil
       Maquilador aprobado empaca su propio camarón en su planta. No hay
       solicitud, ofertas, tarifa, comisión ni acta de dos partes: la misma
       cuenta registra recepción, empaque y un cierre interno. Deja el mismo
       rastro de trazabilidad que un empaque de terceros, rotulado
       «Empaque propio — empacado por <empresa> (planta <código>)».
       Rediseño 19.0.1.15.0: tarjetas .cpk- (copacking_portal.css).
       ================================================================ -->

  <!-- Sin el perfil Maquilador aprobado -->
  <template id="copack_self_need_profile" name="Empaque propio - falta el perfil">
    <t t-call="website.layout">
      <div class="shrimp-bg cpk">
        <div class="shrimp-page cpk-page cpk-page--narrow">
          <div class="cpk-top">
            <a href="/marketplace/copacking/orders" class="s-back"><i class="fa fa-arrow-left" aria-hidden="true"/> Órdenes de empaque</a>
          </div>
          <header class="cpk-ph">
            <div class="cpk-ph-txt">
              <div class="cpk-eyebrow"><i class="fa fa-industry" aria-hidden="true"/> Empaque propio</div>
              <h1>Registrar empaque propio</h1>
            </div>
          </header>
          <div class="cpk-empty">
            <div class="cpk-empty-ico" aria-hidden="true"><i class="fa fa-id-card-o"/></div>
            <div id="shrimp_selfpack_need_profile">
              <h2>Para empacar tu propio producto necesitas el perfil Maquilador</h2>
              <t t-if="estado_perfil == 'pending'">
                <p><span class="cpk-pill cpk-pill--warn mb-2">Pendiente de aprobación</span><br/>
                  Ya lo pediste: está pendiente de aprobación. Cuando la
                  administración lo apruebe podrás registrar tus empaques propios.</p>
              </t>
              <t t-elif="estado_perfil == 'rejected'">
                <p><span class="cpk-pill cpk-pill--bad mb-2">Rechazado</span><br/>
                  Tu perfil Maquilador fue rechazado. Revisa los datos de tu
                  planta (razón social, ubicación, código de establecimiento) y vuelve a pedirlo.</p>
              </t>
              <t t-else="">
                <p>El perfil Maquilador registra tu planta (código de
                  establecimiento y habilitación), que es lo que el informe de trazabilidad imprime
                  como «empacado por». Se agrega a tu misma cuenta y lo aprueba la administración.</p>
              </t>
            </div>
            <div class="cpk-empty-acts">
              <a t-if="estado_perfil != 'pending'" t-att-href="url_agregar" class="s-btn s-btn-primary">
                <i class="fa fa-plus" aria-hidden="true"/> Agregar el perfil Maquilador
              </a>
              <a href="/marketplace/copacking" class="s-btn s-btn-ghost">
                Contratar el empaque a otra planta
              </a>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- Formulario: elegir el camarón y las libras -->
  <template id="copack_self_form" name="Empaque propio - nuevo">
    <t t-call="website.layout">
      <div class="shrimp-bg cpk">
        <div class="shrimp-page cpk-page">
          <div class="cpk-top">
            <a href="/marketplace/copacking/orders" class="s-back"><i class="fa fa-arrow-left" aria-hidden="true"/> Órdenes de empaque</a>
          </div>
          <header class="cpk-ph">
            <div class="cpk-ph-txt">
              <div class="cpk-eyebrow"><i class="fa fa-industry" aria-hidden="true"/> Empaque propio</div>
              <h1>Registrar empaque propio</h1>
              <p>
                Empacas tu propio camarón en tu planta
                <b><t t-esc="planta.name"/></b>
                <t t-if="planta.pack_codigo_establecimiento"> (establecimiento <b><t t-esc="planta.pack_codigo_establecimiento"/></b>)</t>.
                No hay solicitud, tarifa ni comisión, y el acta es un cierre interno tuyo; la trazabilidad
                dirá «Empaque propio — empacado por <t t-esc="planta.name"/>».
              </p>
            </div>
          </header>
          <t t-if="error"><div class="pf-alert pf-a-bad" role="alert"><i class="fa fa-exclamation-triangle" aria-hidden="true"/><div><t t-esc="error"/></div></div></t>
          <t t-if="not origenes">
            <div class="pf-alert pf-a-warn" role="status"><i class="fa fa-info-circle" aria-hidden="true"/>
              <div>No tienes lotes publicados ni compras confirmadas que empacar.</div></div>
          </t>
          <div class="cpk-layout">
            <div class="cpk-main">
              <form method="post" action="/marketplace/copacking/self/new" class="cpk-card">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="cpk-card-h">
                  <span class="cpk-card-ico" aria-hidden="true"><i class="fa fa-cube"/></span>
                  <div class="cpk-card-htxt">
                    <h2 class="cpk-card-t">Qué vas a empacar</h2>
                    <p class="cpk-card-d">El lote o la compra de donde salen las libras que entran a la línea.</p>
                  </div>
                </div>
                <div class="cpk-card-b">
                  <p class="cpk-legend"><span><span class="cpk-req">*</span> obligatorio</span></p>
                  <div class="cpk-fgrid">
                    <div class="cpk-f">
                      <label class="cpk-lbl" for="origen_ref">Camarón a empacar <span class="cpk-req" aria-hidden="true">*</span></label>
                      <select name="origen_ref" id="origen_ref" class="form-select" required="required">
                        <option value="">Elige un lote o una compra…</option>
                        <t t-set="compras" t-value="[o for o in origenes if o['kind'] == 'transaction']"/>
                        <t t-set="lotes" t-value="[o for o in origenes if o['kind'] == 'product']"/>
                        <optgroup t-if="lotes" label="Mis lotes">
                          <t t-foreach="lotes" t-as="o">
                            <option t-att-value="o['ref']"
                                    t-att-selected="'selected' if datos.get('origen_ref') == o['ref'] else None">
                              <t t-esc="o['label']"/>
                            </option>
                          </t>
                        </optgroup>
                        <optgroup t-if="compras" label="Mis compras">
                          <t t-foreach="compras" t-as="o">
                            <option t-att-value="o['ref']"
                                    t-att-selected="'selected' if datos.get('origen_ref') == o['ref'] else None">
                              <t t-esc="o['label']"/>
                            </option>
                          </t>
                        </optgroup>
                      </select>
                      <div class="cpk-help">Del lote salen las libras que entran a la línea; la merma se
                        consume y lo empacado pasa a un lote empacado, como en un empaque de terceros.</div>
                    </div>
                    <div class="cpk-f cpk-f--4">
                      <label class="cpk-lbl" for="cpk_self_qty">Libras a empacar <span class="cpk-req" aria-hidden="true">*</span></label>
                      <div class="cpk-ig">
                        <input type="number" step="0.01" min="0.01" name="quantity_lb" id="cpk_self_qty" class="form-control"
                               required="required" t-att-value="datos.get('quantity_lb') or ''"/>
                        <span class="cpk-ig-a">lb</span>
                      </div>
                    </div>
                    <div class="cpk-f cpk-f--8">
                      <label class="cpk-lbl" for="cpk_self_sup">Insumos <span class="cpk-opt">(opcional)</span></label>
                      <input type="text" name="supplies_notes" id="cpk_self_sup" class="form-control"
                             placeholder="Cajas master, fundas, etiquetas…"
                             t-att-value="datos.get('supplies_notes') or ''"/>
                    </div>
                  </div>
                </div>
                <div class="cpk-card-f">
                  <button type="submit" class="s-btn s-btn-primary"><i class="fa fa-industry" aria-hidden="true"/> Registrar empaque propio</button>
                  <a href="/marketplace/copacking/orders" class="s-btn cpk-btn-link">Cancelar</a>
                </div>
              </form>
            </div>
            <aside class="cpk-aside" aria-label="Cómo funciona">
              <section class="cpk-card">
                <div class="cpk-card-h">
                  <span class="cpk-card-ico" aria-hidden="true"><i class="fa fa-road"/></span>
                  <div class="cpk-card-htxt"><h2 class="cpk-card-t">Cómo sigue</h2></div>
                </div>
                <div class="cpk-card-b">
                  <ol class="cpk-tl cpk-tl--v">
                    <li class="is-cur"><span class="cpk-tl-dot" aria-hidden="true"/><span class="cpk-tl-t">Registrar</span><span class="cpk-tl-s">El camarón y las libras</span></li>
                    <li class="is-todo"><span class="cpk-tl-dot" aria-hidden="true"/><span class="cpk-tl-t">Recepción en la línea</span><span class="cpk-tl-s">Lo que entra de verdad</span></li>
                    <li class="is-todo"><span class="cpk-tl-dot" aria-hidden="true"/><span class="cpk-tl-t">Empaque</span><span class="cpk-tl-s">Libras, cajas y presentación</span></li>
                    <li class="is-todo"><span class="cpk-tl-dot" aria-hidden="true"/><span class="cpk-tl-t">Cierre interno</span><span class="cpk-tl-s">Mueve el inventario y queda en la trazabilidad</span></li>
                  </ol>
                </div>
              </section>
            </aside>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- Detalle: recepción, empaque, cierre interno -->
  <template id="copack_self_order_detail" name="Empaque propio - orden">
    <t t-call="website.layout">
      <t t-set="st_lbl" t-value="dict(orden._fields['state'].selection)"/>
      <t t-set="st_tono" t-value="{'confirmed': 'info', 'received': 'info', 'packed': 'warn', 'signed': 'ok', 'closed': 'ok', 'cancelled': 'muted'}"/>
      <t t-set="sp_pasos" t-value="[('confirmed', 'Registrado'), ('received', 'Recepción'), ('packed', 'Empaque'), ('closed', 'Cierre interno')]"/>
      <t t-set="sp_codes" t-value="[p[0] for p in sp_pasos]"/>
      <t t-set="sp_idx" t-value="3 if orden.state == 'packed' else (sp_codes.index(orden.state) if orden.state in sp_codes else -1)"/>
      <div class="shrimp-bg cpk">
        <div class="shrimp-page cpk-page">
          <div class="cpk-top">
            <a t-att-href="volver_url" class="s-back"><i class="fa fa-arrow-left" aria-hidden="true"/> Órdenes de empaque</a>
          </div>
          <header class="cpk-ph">
            <div class="cpk-ph-txt">
              <div class="cpk-eyebrow"><i class="fa fa-industry" aria-hidden="true"/> Orden de empaque</div>
              <h1>
                <t t-esc="orden.name"/>
                <span class="cpk-pills">
                  <span class="cpk-pill cpk-pill--lg cpk-pill--brand">Empaque propio</span>
                  <span t-attf-class="cpk-pill cpk-pill--lg cpk-pill--#{st_tono.get(orden.state, 'muted')}">
                    <t t-esc="st_lbl.get(orden.state)"/>
                  </span>
                </span>
              </h1>
              <p class="mb-0" id="shrimp_selfpack_label"><t t-esc="orden.shrimp_plant_label()"/></p>
              <div class="cpk-meta">
                <t t-if="orden.transaction_id"><span><i class="fa fa-shopping-cart" aria-hidden="true"/> Compra <b><t t-esc="orden.transaction_id.name"/></b></span><span class="cpk-sep" aria-hidden="true"/></t>
                <span><t t-esc="orden.product_id.display_name or ''"/></span>
              </div>
            </div>
          </header>

          <t t-if="mensaje == 'cerrada'">
            <div class="pf-alert cpk-a-ok" role="status"><i class="fa fa-check-circle" aria-hidden="true"/>
              <div>Empaque propio cerrado: el inventario se movió y ya consta en la trazabilidad.</div></div>
          </t>
          <t t-elif="mensaje"><div class="pf-alert cpk-a-ok" role="status"><i class="fa fa-check-circle" aria-hidden="true"/><div>Listo.</div></div></t>
          <t t-if="error"><div class="pf-alert pf-a-bad" role="alert"><i class="fa fa-exclamation-triangle" aria-hidden="true"/><div><t t-esc="error"/></div></div></t>

          <div class="cpk-tl-card" role="group" aria-label="Avance del empaque propio">
            <ol t-attf-class="cpk-tl #{'cpk-tl--off' if orden.state == 'cancelled' else ''}">
              <t t-foreach="sp_pasos" t-as="p">
                <t t-set="tl_cls" t-value="'is-done' if (p_index &lt; sp_idx or (orden.state == 'closed' and p_index == sp_idx)) else ('is-cur' if p_index == sp_idx else 'is-todo')"/>
                <li t-att-class="tl_cls" t-att-aria-current="'step' if tl_cls == 'is-cur' else None">
                  <span class="cpk-tl-dot" aria-hidden="true"><i class="fa fa-check"/></span>
                  <span class="cpk-tl-t"><t t-esc="p[1]"/></span>
                  <span class="cpk-tl-s">
                    <t t-if="p[0] == 'received' and orden.received_date"><t t-esc="orden.received_date" t-options="{'widget': 'date'}"/></t>
                    <t t-elif="p[0] == 'packed' and orden.packed_date"><t t-esc="orden.packed_date" t-options="{'widget': 'date'}"/></t>
                    <t t-elif="p[0] == 'closed' and orden.self_signoff_date"><t t-esc="orden.self_signoff_date" t-options="{'widget': 'date'}"/></t>
                    <t t-elif="tl_cls == 'is-cur'">Te toca</t>
                    <t t-elif="tl_cls == 'is-todo' and orden.state != 'cancelled'">Pendiente</t>
                  </span>
                </li>
              </t>
            </ol>
            <div class="cpk-tl-note" t-if="orden.state == 'cancelled'">
              <i class="fa fa-info-circle" aria-hidden="true"/><span>Este empaque propio se anuló.</span>
            </div>
          </div>

          <div class="cpk-layout">
            <div class="cpk-main">
              <t t-if="orden.state == 'confirmed'">
                <section class="cpk-card cpk-card--todo" aria-labelledby="cpk_sp_rec">
                  <div class="cpk-card-h">
                    <span class="cpk-card-ico" aria-hidden="true"><i class="fa fa-truck"/></span>
                    <div class="cpk-card-htxt">
                      <h2 class="cpk-card-t" id="cpk_sp_rec">1. Recepción en la línea</h2>
                      <p class="cpk-card-d">Las libras que entran de verdad a empacar.</p>
                    </div>
                    <span class="cpk-pill cpk-pill--brand">Te toca</span>
                  </div>
                  <form method="post" t-attf-action="/marketplace/copacking/self/#{orden.uuid_ref}/reception">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="cpk-card-b">
                      <div class="cpk-fgrid">
                        <div class="cpk-f cpk-f--4">
                          <label class="cpk-lbl" for="cpk_sp_received">Libras recibidas <span class="cpk-req" aria-hidden="true">*</span></label>
                          <div class="cpk-ig">
                            <input type="number" step="0.01" min="0.01" name="received_lb" id="cpk_sp_received" class="form-control"
                                   required="required" t-att-value="int(orden.agreed_qty_lb)"/>
                            <span class="cpk-ig-a">lb</span>
                          </div>
                        </div>
                        <div class="cpk-f cpk-f--8">
                          <span class="cpk-lbl">Insumos <span class="cpk-opt">(opcional)</span></span>
                          <label class="cpk-check" for="cpk_sp_sup_ok">
                            <input type="checkbox" name="supplies_received" id="cpk_sp_sup_ok" class="form-check-input" checked="checked"/>
                            <span><b>Completos</b></span>
                          </label>
                          <label class="cpk-sr" for="cpk_sp_sup_issue">Si faltó algo</label>
                          <input type="text" name="supplies_issue" id="cpk_sp_sup_issue" class="form-control mt-2" placeholder="Si faltó algo"/>
                        </div>
                      </div>
                    </div>
                    <div class="cpk-card-f">
                      <button type="submit" class="s-btn s-btn-primary"><i class="fa fa-check" aria-hidden="true"/> Registrar recepción</button>
                    </div>
                  </form>
                </section>
              </t>

              <t t-if="orden.state == 'received'">
                <section class="cpk-card cpk-card--todo" aria-labelledby="cpk_sp_pack">
                  <div class="cpk-card-h">
                    <span class="cpk-card-ico" aria-hidden="true"><i class="fa fa-cube"/></span>
                    <div class="cpk-card-htxt">
                      <h2 class="cpk-card-t" id="cpk_sp_pack">2. Empaque</h2>
                      <p class="cpk-card-d">Lo que salió empacado. La diferencia con lo recibido es la merma.</p>
                    </div>
                    <span class="cpk-pill cpk-pill--brand">Te toca</span>
                  </div>
                  <form method="post" t-attf-action="/marketplace/copacking/self/#{orden.uuid_ref}/packing">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="cpk-card-b">
                      <div class="cpk-fgrid">
                        <div class="cpk-f cpk-f--4">
                          <label class="cpk-lbl" for="cpk_sp_packed">Libras empacadas <span class="cpk-req" aria-hidden="true">*</span></label>
                          <div class="cpk-ig">
                            <input type="number" step="0.01" min="0.01" name="packed_lb" id="cpk_sp_packed" class="form-control"
                                   required="required" t-att-value="orden.packed_lb or ''"/>
                            <span class="cpk-ig-a">lb</span>
                          </div>
                        </div>
                        <div class="cpk-f cpk-f--4">
                          <label class="cpk-lbl" for="cpk_sp_boxes">Cajas / masters <span class="cpk-opt">(opcional)</span></label>
                          <input type="number" step="1" min="0" name="boxes" id="cpk_sp_boxes" class="form-control" t-att-value="orden.boxes or ''"/>
                        </div>
                        <div class="cpk-f cpk-f--4">
                          <label class="cpk-lbl" for="cpk_sp_pres">Presentación <span class="cpk-opt">(opcional)</span></label>
                          <select name="packed_presentation" id="cpk_sp_pres" class="form-select">
                            <option value="">—</option>
                            <t t-foreach="orden._fields['packed_presentation'].selection" t-as="pres">
                              <option t-att-value="pres[0]" t-att-selected="'selected' if orden.packed_presentation == pres[0] else None"><t t-esc="pres[1]"/></option>
                            </t>
                          </select>
                        </div>
                        <div class="cpk-f">
                          <label class="cpk-lbl" for="cpk_sp_note">Formato <span class="cpk-opt">(opcional)</span></label>
                          <input type="text" name="packed_presentation_note" id="cpk_sp_note" class="form-control"
                                 placeholder="Formato (p. ej. master 5 lb IQF)" t-att-value="orden.packed_presentation_note or ''"/>
                        </div>
                      </div>
                    </div>
                    <div class="cpk-card-f">
                      <button type="submit" class="s-btn s-btn-primary"><i class="fa fa-check" aria-hidden="true"/> Registrar empaque</button>
                    </div>
                  </form>
                </section>
              </t>

              <t t-if="orden.state == 'packed'">
                <section class="cpk-card cpk-card--todo" aria-labelledby="cpk_sp_close">
                  <div class="cpk-card-h">
                    <span class="cpk-card-ico cpk-card-ico--ok" aria-hidden="true"><i class="fa fa-flag-checkered"/></span>
                    <div class="cpk-card-htxt">
                      <h2 class="cpk-card-t" id="cpk_sp_close">3. Cierre interno</h2>
                      <p class="cpk-card-d">
                        No hay acta de dos partes: el cliente y la planta son tu misma empresa. Al cerrar das
                        por buenas estas cifras; la merma se consume, lo empacado pasa a un lote empacado y el
                        empaque aparece en el informe de trazabilidad como empaque propio.
                      </p>
                    </div>
                  </div>
                  <div class="cpk-card-f">
                    <form method="post" t-attf-action="/marketplace/copacking/self/#{orden.uuid_ref}/close">
                      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                      <button type="submit" class="s-btn cpk-btn-ok"><i class="fa fa-check" aria-hidden="true"/> Cerrar empaque propio</button>
                    </form>
                    <form method="post" t-attf-action="/marketplace/copacking/self/#{orden.uuid_ref}/correct">
                      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                      <button type="submit" class="s-btn s-btn-ghost"><i class="fa fa-pencil" aria-hidden="true"/> Corregir lo empacado</button>
                    </form>
                  </div>
                </section>
              </t>

              <section class="cpk-card" aria-labelledby="cpk_sp_det">
                <div class="cpk-card-h">
                  <span class="cpk-card-ico" aria-hidden="true"><i class="fa fa-list-alt"/></span>
                  <div class="cpk-card-htxt"><h2 class="cpk-card-t" id="cpk_sp_det">El empaque</h2></div>
                </div>
                <div class="cpk-card-b">
                  <dl class="cpk-kv">
                    <div><dt>Cajas / masters</dt><dd><t t-esc="orden.boxes or '—'"/></dd></div>
                    <div><dt>Presentación</dt>
                      <dd><t t-esc="dict(orden._fields['packed_presentation'].selection).get(orden.packed_presentation) or '—'"/>
                        <t t-if="orden.packed_presentation_note"> · <t t-esc="orden.packed_presentation_note"/></t></dd></div>
                    <div><dt>Insumos</dt><dd><t t-esc="orden.supplies_notes or '—'"/></dd></div>
                    <div><dt>Recepción</dt><dd><t t-if="orden.received_date"><t t-esc="orden.received_date" t-options="{'widget': 'datetime'}"/></t><t t-else="">—</t></dd></div>
                    <div><dt>Empaque</dt><dd><t t-if="orden.packed_date"><t t-esc="orden.packed_date" t-options="{'widget': 'datetime'}"/></t><t t-else="">—</t></dd></div>
                    <div><dt>Cierre interno</dt>
                      <dd><t t-if="orden.self_signoff_date"><t t-esc="orden.self_signoff_date" t-options="{'widget': 'datetime'}"/> · <t t-esc="orden.self_signoff_user_id.name"/></t><t t-else="">—</t></dd></div>
                    <div><dt>Lote empacado</dt>
                      <dd><t t-if="orden.packed_lot_id">L-<t t-esc="orden.packed_lot_id.id"/></t><t t-else="">—</t></dd></div>
                    <div><dt>Tarifa / comisión</dt><dd>Sin cobro (empaque propio)</dd></div>
                  </dl>
                </div>
              </section>

              <t t-if="orden.state in ('confirmed', 'received', 'packed')">
                <section class="cpk-card cpk-card--quiet" aria-labelledby="cpk_sp_anular">
                  <div class="cpk-card-h cpk-card-h--flat">
                    <span class="cpk-card-ico cpk-card-ico--bad" aria-hidden="true"><i class="fa fa-ban"/></span>
                    <div class="cpk-card-htxt">
                      <h2 class="cpk-card-t" id="cpk_sp_anular">Anular el empaque propio</h2>
                      <p class="cpk-card-d">Mientras no esté cerrado.</p>
                    </div>
                    <button type="button" class="s-btn s-btn-danger s-btn-sm cpk-card-x"
                            data-bs-toggle="modal" data-bs-target="#cpkCancelSelf">Anular</button>
                  </div>
                </section>
                <div class="modal fade pf-modal pf-modal-sm cpk" id="cpkCancelSelf" tabindex="-1"
                     aria-labelledby="cpkCancelSelfT" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <form method="post" class="modal-content"
                          t-attf-action="/marketplace/copacking/orders/#{orden.uuid_ref}/cancel">
                      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                      <div class="modal-body pf-del-body">
                        <div class="pf-del-ico" aria-hidden="true"><i class="fa fa-ban"/></div>
                        <h3 id="cpkCancelSelfT">¿Anular este empaque propio?</h3>
                        <p>Queda anulado y no se puede reabrir.</p>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="s-btn s-btn-ghost" data-bs-dismiss="modal">Volver</button>
                        <button type="submit" class="s-btn s-btn-danger">Sí, anular</button>
                      </div>
                    </form>
                  </div>
                </div>
              </t>
            </div>

            <aside class="cpk-aside" aria-label="El cuadre">
              <section class="cpk-card" aria-labelledby="cpk_sp_cuadre">
                <div class="cpk-card-h">
                  <span class="cpk-card-ico" aria-hidden="true"><i class="fa fa-balance-scale"/></span>
                  <div class="cpk-card-htxt"><h2 class="cpk-card-t" id="cpk_sp_cuadre">El cuadre</h2></div>
                </div>
                <div class="cpk-card-b">
                  <div class="cpk-stats">
                    <div class="cpk-stat"><span class="cpk-stat-l">A empacar</span>
                      <span class="cpk-stat-v"><t t-esc="'{:,.0f}'.format(orden.agreed_qty_lb or 0)"/></span><span class="cpk-stat-u">lb</span></div>
                    <div class="cpk-stat"><span class="cpk-stat-l">Recibidas</span>
                      <span class="cpk-stat-v"><t t-esc="'{:,.0f}'.format(orden.received_lb or 0)"/></span><span class="cpk-stat-u">lb</span></div>
                    <div class="cpk-stat"><span class="cpk-stat-l">Empacadas</span>
                      <span class="cpk-stat-v"><t t-esc="'{:,.0f}'.format(orden.packed_lb or 0)"/></span><span class="cpk-stat-u">lb</span></div>
                    <div t-attf-class="cpk-stat #{('cpk-stat--ok' if orden.cuadra else 'cpk-stat--bad') if orden.packed_lb else ''}"><span class="cpk-stat-l">Merma</span>
                      <span class="cpk-stat-v"><t t-esc="round(orden.difference_lb, 2)"/></span>
                      <span class="cpk-stat-u"><t t-esc="round(orden.difference_pct, 2)"/> %</span></div>
                  </div>
                </div>
              </section>
            </aside>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- Botón en la lista de órdenes -->
  <template id="copack_orders_self_pack_button" inherit_id="shrimp_copacking.copack_orders"
            name="Órdenes de empaque - empaque propio">
    <xpath expr="//div[@id='cpk_orders_acts']" position="inside">
      <a t-if="es_duenio_camaron" href="/marketplace/copacking/self/new" id="shrimp_selfpack_btn"
         t-attf-class="s-btn #{'s-btn-primary' if puede_empaque_propio else 's-btn-ghost'}">
        <i class="fa fa-industry" aria-hidden="true"></i> Registrar empaque propio
      </a>
    </xpath>
    <xpath expr="//t[@t-foreach='ordenes']//a[hasclass('cpk-ref')]" position="after">
      <span t-if="o.self_packing" class="cpk-pill cpk-pill--sm cpk-pill--brand ms-1">Empaque propio</span>
    </xpath>
  </template>

  <!-- Acceso desde «Mi inventario»: empacar un lote propio o comprado -->
  <template id="my_lots_self_pack" inherit_id="shrimp_marketplace.my_lots"
            name="Mis lotes - empaque propio">
    <xpath expr="//h3[hasclass('mp-sec-title')]" position="after">
      <a href="/marketplace/copacking/self/new" class="btn btn-sm btn-outline-primary ms-auto"
         t-if="partner.sudo()._shrimp_can_any('request_copack')" id="shrimp_selfpack_lots_btn">
        <i class="fa fa-industry"></i> Registrar empaque propio
      </a>
    </xpath>
    <xpath expr="//table/thead/tr/th[last()]" position="after">
      <th></th>
    </xpath>
    <xpath expr="//table/tbody//tr/td[last()]" position="after">
      <td class="text-end">
        <t t-set="sp_origen" t-value="request.env['shrimp.copack.order'].sudo()._shrimp_self_pack_origin_for_lot(lot)"/>
        <a t-if="sp_origen and lot.state == 'available'" t-attf-href="/marketplace/copacking/self/new?origen=#{sp_origen}"
           class="btn btn-sm btn-link">Empacar</a>
      </td>
    </xpath>
  </template>

</odoo>
