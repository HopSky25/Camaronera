<odoo>

  <!-- ================================================================
       REGISTRO DEL MAQUILADOR (19.0.1.10.0)

       El maquilador ya no tiene formulario propio: /register/copacker abre
       el asistente de alta común con el perfil marcado (en la plataforma de
       empaque es el único perfil que se ofrece). Aquí va su bloque de datos:
       habilitación, capacidad y tarifas de referencia. Sigue naciendo
       pendiente de aprobación.
       ================================================================ -->
  <template id="signup_profile_sections_copacker" inherit_id="shrimp_user_registry.signup_profile_sections"
            name="Registro - datos del maquilador">
    <xpath expr="//div[@id='shrimp_prof_sections_end']" position="before">
      <div t-if="'maquilador' in (signup_profile_codes or [])" class="shrimp-prof-sec" data-role="maquilador" id="section_maquilador">
        <div class="shrimp-prof-sec-head">
          <span class="shrimp-prof-sec-ico" aria-hidden="true"><i class="fa fa-cubes"/></span>
          <div class="shrimp-prof-sec-htxt">
            <h3 class="shrimp-prof-sec-title">Maquilador (planta de empaque)</h3>
            <p class="shrimp-prof-sec-desc">El código de establecimiento sale impreso en el certificado de trazabilidad del lote.
              Si lo tienes en trámite puedes registrarte igual y completarlo después. Los precios «desde» son públicos
              (directorio); la tarifa firme se manda dirigida a cada cliente.</p>
          </div>
        </div>
        <div class="shrimp-prof-sec-body">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <label class="form-label small text-muted" for="reg_pack_codigo_establecimiento">Código de establecimiento</label>
            <input type="text" id="reg_pack_codigo_establecimiento" name="pack_codigo_establecimiento" class="form-control"
                   t-att-value="values.get('pack_codigo_establecimiento')"/>
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted" for="reg_pack_habilitacion_desde">Habilitación desde</label>
            <input type="date" id="reg_pack_habilitacion_desde" name="pack_habilitacion_desde" class="form-control"
                   t-att-value="values.get('pack_habilitacion_desde')"/>
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted" for="reg_pack_habilitacion_hasta">Habilitación hasta</label>
            <input type="date" id="reg_pack_habilitacion_hasta" name="pack_habilitacion_hasta" class="form-control"
                   t-att-value="values.get('pack_habilitacion_hasta')"/>
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted" for="reg_pack_capacidad_lb_semana">Capacidad (lb/semana) <span class="text-danger">*</span></label>
            <input type="number" step="1" min="0" id="reg_pack_capacidad_lb_semana" name="pack_capacidad_lb_semana" class="form-control" data-req="1"
                   t-att-value="values.get('pack_capacidad_lb_semana')"/>
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label small text-muted" for="reg_pack_lote_minimo_lb">Lote mínimo (lb)</label>
            <input type="number" step="1" min="0" id="reg_pack_lote_minimo_lb" name="pack_lote_minimo_lb" class="form-control"
                   t-att-value="values.get('pack_lote_minimo_lb')"/>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label small text-muted" for="reg_pack_presentaciones">Presentaciones</label>
            <input type="text" id="reg_pack_presentaciones" name="pack_presentaciones" class="form-control" placeholder="Entero, cola, valor agregado..."
                   t-att-value="values.get('pack_presentaciones')"/>
          </div>
          <div class="col-12 col-sm-4">
            <label class="form-label small text-muted" for="reg_pack_desde_entero">Entero desde ($/lb)</label>
            <input type="number" step="0.001" min="0" id="reg_pack_desde_entero" name="pack_desde_entero" class="form-control"
                   t-att-value="values.get('pack_desde_entero')"/>
          </div>
          <div class="col-12 col-sm-4">
            <label class="form-label small text-muted" for="reg_pack_desde_cola">Cola desde ($/lb)</label>
            <input type="number" step="0.001" min="0" id="reg_pack_desde_cola" name="pack_desde_cola" class="form-control"
                   t-att-value="values.get('pack_desde_cola')"/>
          </div>
          <div class="col-12 col-sm-4">
            <label class="form-label small text-muted" for="reg_pack_desde_valor_agregado">Valor agregado ($/lb)</label>
            <input type="number" step="0.001" min="0" id="reg_pack_desde_valor_agregado" name="pack_desde_valor_agregado" class="form-control"
                   t-att-value="values.get('pack_desde_valor_agregado')"/>
          </div>
          <div class="col-12">
            <label class="form-label small text-muted" for="reg_pack_tarifa_nota">Aclaración de la tarifa <span class="shrimp-optional">(opcional)</span></label>
            <input type="text" id="reg_pack_tarifa_nota" name="pack_tarifa_nota" class="form-control" placeholder="Ej. precios con hielo y transporte incluidos"
                   t-att-value="values.get('pack_tarifa_nota')"/>
          </div>
          <div class="col-12">
            <label class="form-check">
              <input type="checkbox" name="pack_en_directorio" value="1" class="form-check-input"
                     t-att-checked="'checked' if (not values or not values.get('email') or values.get('pack_en_directorio')) else None"/>
              <span><b>Aparecer en el directorio</b> de plantas (si lo apagas, solo trabajas con quien ya te conoce).</span>
            </label>
          </div>
        </div>
        </div>
      </div>
    </xpath>
  </template>

  <!-- Anexo de perfil del maquilador (versión inicial, borrador). -->
  <data noupdate="1">
    <record id="legal_doc_annex_maquilador" model="shrimp.legal.document">
      <field name="name">Anexo de perfil: Maquilador (empaque)</field>
      <field name="code">annex_maquilador</field>
      <field name="doc_type">annex</field>
      <field name="role">maquilador</field>
      <field name="sequence">54</field>
    </record>
    <record id="legal_ver_annex_maquilador_202610" model="shrimp.legal.document.version">
      <field name="document_id" ref="legal_doc_annex_maquilador"/>
      <field name="name">2026-10</field>
      <field name="change_type">minor</field>
      <field name="change_summary">Versión inicial (BORRADOR) del anexo del perfil Maquilador. Debe revisarla un abogado antes de considerarla definitiva.</field>
      <field name="state">published</field>
      <field name="content" type="html"><div>
<p><b>Anexo de perfil: Maquilador (empaque).</b> Complementa el Contrato de uso para la planta que presta el servicio de empaque a terceros.</p>
<ol>
<li><b>Aprobación y habilitación.</b> El perfil queda pendiente hasta que la Plataforma lo aprueba. El maquilador declara su código de establecimiento y la vigencia de su habilitación, y no acepta órdenes si la habilitación no está vigente.</li>
<li><b>Tarifas.</b> Los precios «desde» del directorio son referenciales y públicos; la tarifa firme que envía a un cliente es confidencial y lo obliga en las condiciones indicadas.</li>
<li><b>Órdenes de empaque.</b> Registra en la plataforma la recepción, el empaque y las actas de cada orden con datos verdaderos (pesos, presentaciones, rendimientos). Esos registros alimentan el certificado de trazabilidad, que muestra su planta.</li>
<li><b>Custodia.</b> Responde por el producto recibido mientras está bajo su custodia, conforme a la normativa sanitaria aplicable.</li>
<li><b>Comisión y facturación.</b> La Plataforma cobra y factura electrónicamente (SRI) su comisión de empaque según la tarifa vigente informada; el servicio de maquila lo factura el maquilador a su cliente.</li>
</ol>
</div></field>
    </record>
  </data>

</odoo>
