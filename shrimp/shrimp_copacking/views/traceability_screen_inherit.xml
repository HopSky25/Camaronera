<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pantalla privada de trazabilidad: el servicio de empaque (maquila).
         Antes solo salía en el PDF; aquí también, justo antes de la salida /
         exportación, que es el orden físico: cosecha -> verificación ->
         despacho -> empaque -> salida. -->
    <template id="traceability_screen_copacking" inherit_id="shrimp_marketplace.traceability_screen"
              name="Trazabilidad - servicio de empaque">
        <xpath expr="//div[@id='shrimp_trace_exports']" position="before">
            <t t-set="empaques" t-value="tx.copack_order_ids"/>
            <div t-if="empaques" class="mp-table-card mt-4" id="shrimp_trace_copacking">
                <div class="card-body p-4">
                    <div class="mp-sec-head">
                        <span class="mp-sec-ico"><i class="fa fa-archive"></i></span>
                        <h3 class="mp-sec-title">Servicio de empaque</h3>
                        <span class="s-badge s-badge--teal mp-sec-count"><t t-esc="len(empaques)"/></span>
                    </div>
                    <t t-foreach="empaques" t-as="emp">
                        <div t-attf-class="sv-alert sv-alert--#{'ready' if emp.cuadra else 'wait'} mb-3">
                            <div t-if="emp.self_packing" class="fw-bold mb-1 shrimp-trace-selfpack">
                                <i class="fa fa-industry"></i> <t t-esc="emp.shrimp_plant_label()"/>
                            </div>
                            <strong>
                                <t t-esc="emp.name"/> ·
                                <t t-if="emp.cuadra">las libras empacadas cuadran con las recibidas</t>
                                <t t-else="">hay diferencia entre lo recibido y lo empacado</t>
                            </strong>
                            <div class="small mt-1">
                                Recibidas <t t-esc="tx.shrimp_fmt_qty(emp.received_lb, 'lb')"/> ·
                                empacadas <t t-esc="tx.shrimp_fmt_qty(emp.packed_lb, 'lb')"/> ·
                                merma <t t-esc="tx.shrimp_fmt_qty(emp.difference_lb, 'lb')"/>
                                (<t t-esc="tx.shrimp_fmt_num(emp.difference_pct, 2)"/> %, tolerancia <t t-esc="tx.shrimp_fmt_num(emp.tolerance_pct, 2)"/> %)
                            </div>
                        </div>
                        <div class="mp-spec-grid mb-3">
                            <div class="mp-spec"><span class="mp-spec-ico"><i class="fa fa-industry"></i></span><div class="mp-spec-body"><div class="mp-spec-label">Planta que empacó</div><div class="mp-spec-value"><t t-esc="emp.copacker_partner_id.name"/><t t-if="emp.self_packing"> (empaque propio)</t></div></div></div>
                            <div class="mp-spec"><span class="mp-spec-ico"><i class="fa fa-id-card-o"></i></span><div class="mp-spec-body"><div class="mp-spec-label">Código de establecimiento</div><div class="mp-spec-value"><t t-esc="emp.copacker_partner_id.pack_codigo_establecimiento or 'no registrado'"/><t t-if="emp.copacker_partner_id.pack_habilitacion_hasta"> · habilitado hasta <t t-esc="tx.shrimp_fmt_dt(emp.copacker_partner_id.pack_habilitacion_hasta)"/></t></div></div></div>
                            <div class="mp-spec"><span class="mp-spec-ico"><i class="fa fa-user-o"></i></span><div class="mp-spec-body"><div class="mp-spec-label">Dueño del camarón</div><div class="mp-spec-value"><t t-esc="emp.client_partner_id.name"/></div></div></div>
                            <div class="mp-spec"><span class="mp-spec-ico"><i class="fa fa-sign-in"></i></span><div class="mp-spec-body"><div class="mp-spec-label">Recepción en planta</div><div class="mp-spec-value"><t t-esc="tx.shrimp_fmt_dt(emp.received_date)"/></div></div></div>
                            <div class="mp-spec"><span class="mp-spec-ico"><i class="fa fa-check-square-o"></i></span><div class="mp-spec-body"><div class="mp-spec-label">Empaque terminado</div><div class="mp-spec-value"><t t-esc="tx.shrimp_fmt_dt(emp.packed_date)"/></div></div></div>
                            <div class="mp-spec"><span class="mp-spec-ico"><i class="fa fa-cubes"></i></span><div class="mp-spec-body"><div class="mp-spec-label">Presentación · cajas</div><div class="mp-spec-value"><t t-esc="dict(emp._fields['packed_presentation'].selection).get(emp.packed_presentation) or '—'"/><t t-if="emp.packed_presentation_note"> · <t t-esc="emp.packed_presentation_note"/></t> · <t t-esc="tx.shrimp_fmt_num(emp.boxes, 0) if emp.boxes else '—'"/> cajas</div></div></div>
                            <div class="mp-spec"><span class="mp-spec-ico"><i class="fa fa-pencil-square-o"></i></span><div class="mp-spec-body"><div class="mp-spec-label">Acta</div><div class="mp-spec-value">
                                <t t-if="emp.self_packing">cierre interno de la propia empresa (sin acta de dos partes)<t t-if="emp.self_signoff_date"> · <t t-esc="tx.shrimp_fmt_dt(emp.self_signoff_date)"/></t></t>
                                <t t-elif="emp.acceptance_state == 'closed'">firmada por las dos partes</t>
                                <t t-elif="emp.acceptance_state == 'disputed'">en disputa</t>
                                <t t-elif="emp.acceptance_state == 'open'">pendiente de firma</t>
                                <t t-else="">—</t>
                            </div></div></div>
                        </div>
                    </t>
                    <div class="small text-muted">El servicio de empaque no transfiere la propiedad: el camarón siguió siendo del dueño y la planta solo prestó el servicio.</div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
