<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Los buzones de la empresa. Sin usuarios: se asignan después de
         instalar (Configuración › Buzones o _shrimp_asignar_usuarios_por_login). -->
    <data noupdate="1">
        <record id="buzon_gerencia_general" model="shrimp.buzon">
            <field name="name">Gerencia General</field>
            <field name="direccion">gerencia_general@camaronmarket.com</field>
            <field name="sequence">10</field>
            <field name="color">1</field>
        </record>
        <record id="buzon_presidencia" model="shrimp.buzon">
            <field name="name">Presidencia</field>
            <field name="direccion">presidencia@camaronmarket.com</field>
            <field name="sequence">20</field>
            <field name="color">2</field>
        </record>
        <record id="buzon_info" model="shrimp.buzon">
            <field name="name">Información</field>
            <field name="direccion">info@camaronmarket.com</field>
            <field name="sequence">30</field>
            <field name="color">3</field>
        </record>
        <record id="buzon_contabilidad" model="shrimp.buzon">
            <field name="name">Contabilidad</field>
            <field name="direccion">contabilidad@camaronmarket.com</field>
            <field name="sequence">40</field>
            <field name="color">4</field>
        </record>
        <record id="buzon_facturacion" model="shrimp.buzon">
            <field name="name">Facturación</field>
            <field name="direccion">facturacion@camaronmarket.com</field>
            <field name="sequence">50</field>
            <field name="color">5</field>
        </record>
        <record id="buzon_datos" model="shrimp.buzon">
            <field name="name">Protección de Datos</field>
            <field name="direccion">datos@camaronmarket.com</field>
            <field name="sequence">60</field>
            <field name="color">6</field>
        </record>
        <record id="buzon_notificaciones" model="shrimp.buzon">
            <field name="name">Notificaciones</field>
            <field name="direccion">notificaciones@camaronmarket.com</field>
            <field name="sequence">70</field>
            <field name="color">7</field>
        </record>
    </data>
</odoo>
