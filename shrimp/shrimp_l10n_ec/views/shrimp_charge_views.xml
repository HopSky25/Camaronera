<odoo>
  <record id="view_shrimp_charge_form_sri" model="ir.ui.view">
    <field name="name">shrimp.charge.form.sri</field>
    <field name="model">shrimp.charge</field>
    <field name="inherit_id" ref="shrimp_marketplace.view_shrimp_charge_form"/>
    <field name="arch" type="xml">
      <field name="invoice_state" position="after">
        <field name="sri_document_id" invisible="not sri_document_id"/>
        <field name="sri_document_state" widget="badge" invisible="not sri_document_id"
               decoration-success="sri_document_state == 'authorized'"
               decoration-danger="sri_document_state in ('rejected', 'error')"
               decoration-warning="sri_document_state in ('draft', 'queued', 'waiting')"/>
        <field name="sri_refund_document_id" invisible="not sri_refund_document_id"/>
      </field>
    </field>
  </record>
</odoo>
