<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mínimo de reseñas como vendedor para salir en «Laboratorios /
         Semilleros destacados» (catálogo y landing). noupdate: el valor que
         ajuste el administrador en Ajustes no se pisa al actualizar. -->
    <data noupdate="1">
        <record id="config_featured_min_reviews" model="ir.config_parameter">
            <field name="key">shrimp_marketplace.featured_min_reviews</field>
            <field name="value">10</field>
        </record>
    </data>
</odoo>
