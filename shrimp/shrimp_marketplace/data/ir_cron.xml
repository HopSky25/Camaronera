<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Reintenta la facturación de los cobros de la plataforma que fallaron
       (sin plan contable, sin punto de emisión SRI, datos del cliente
       incompletos...) y emite las notas de crédito pendientes. Un cobro se
       reintenta como mucho 5 veces solo; después espera al botón
       «Reintentar facturación» de su ficha. -->
  <record id="ir_cron_shrimp_charge_retry" model="ir.cron">
    <field name="name">Camaronera: reintentar facturación de cobros</field>
    <field name="model_id" ref="model_shrimp_charge"/>
    <field name="state">code</field>
    <field name="code">model._cron_retry_invoices()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active" eval="True"/>
  </record>

  <!-- Entregas y recepción (models/shrimp_transaction_reception.py): confirma
       sola la recepción que el comprador no confirmó en el plazo de Ajustes,
       recuerda las que están por vencer y avisa de las entregas próximas, de
       hoy y atrasadas. Cada aviso deja una marca en la compra: correr cada
       hora no repite ninguno. -->
  <record id="ir_cron_shrimp_reception_delivery" model="ir.cron">
    <field name="name">Camaronera: entregas y recepción (avisos y confirmación automática)</field>
    <field name="model_id" ref="model_shrimp_transaction"/>
    <field name="state">code</field>
    <field name="code">model._cron_reception_and_delivery()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
