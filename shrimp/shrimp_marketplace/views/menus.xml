<odoo>

  <!-- =========================================================
       UNA SOLA APLICACIÓN «Camaronera» en el backoffice.

       Antes cada módulo abría su propia raíz (Verificación era otra app) y
       los certificados se gestionaban en tres sitios. Ahora todo cuelga de
       aquí, por secciones:
         Aprobaciones (10)   cuentas, certificados de usuario y de producto,
                             acreditaciones de verificadores
         Marketplace (20)    productos, transacciones, evolución
         Inventario (30) · Socios e instalaciones (40)
         Verificación (50)   shrimp_verification
         Reservas y precios (55)  shrimp_packer
         Empaque (60)        shrimp_copacking
         Reportes (70)       ventas, cobros de la plataforma, movimientos
         Configuración (90)  catálogos, certificados, API (shrimp_api)
  ========================================================= -->
  <!-- ROOT -->
  <menuitem id="menu_shrimp_root" name="Camaronera" sequence="10"
    web_icon="shrimp_marketplace,static/description/icon.png"
    groups="shrimp_marketplace.group_shrimp_user" />

  <!-- =========================================================
       APROBACIONES (todo lo que el operador debe revisar/aprobar)
  ========================================================= -->
  <menuitem id="menu_shrimp_approvals_root"
    name="Aprobaciones"
    parent="menu_shrimp_root"
    sequence="10"
    groups="shrimp_marketplace.group_shrimp_user" />

  <!-- Empacadoras y maquiladores registrados por la web: no operan hasta
       que un administrador aprueba la cuenta (acción en shrimp_user_registry). -->
  <menuitem id="menu_shrimp_account_approval"
    name="Cuentas por aprobar"
    parent="menu_shrimp_approvals_root"
    action="shrimp_user_registry.action_shrimp_account_approval"
    sequence="5"
    groups="shrimp_marketplace.group_shrimp_manager" />

  <!-- Varios perfiles por cuenta: cada perfil que requiere aprobación
       (empacadora, maquilador) se aprueba por separado. -->
  <menuitem id="menu_shrimp_partner_role_approval"
    name="Perfiles por aprobar"
    parent="menu_shrimp_approvals_root"
    action="shrimp_user_registry.action_shrimp_partner_role_approval"
    sequence="6"
    groups="shrimp_marketplace.group_shrimp_manager" />

  <!-- "Certificados de usuario" se añade aquí desde
       shrimp_user_cert_approval_views.xml (sequence 20) -->

  <!-- =========================================================
       CATÁLOGO (productos y transacciones del marketplace)
  ========================================================= -->
  <menuitem id="menu_shrimp_catalog_root"
    name="Marketplace"
    parent="menu_shrimp_root"
    sequence="20"
    groups="shrimp_marketplace.group_shrimp_user" />

  <menuitem id="menu_shrimp_products"
    name="Productos"
    parent="menu_shrimp_catalog_root"
    action="action_shrimp_product"
    sequence="10"
    groups="shrimp_marketplace.group_shrimp_user" />

  <menuitem id="menu_shrimp_transactions"
    name="Transacciones"
    parent="menu_shrimp_catalog_root"
    action="action_shrimp_transaction"
    sequence="20"
    groups="shrimp_marketplace.group_shrimp_user" />

  <!-- Solicitudes de chequeo: flujo RETIRADO (lo sustituye la compra con
       verificación en campo). El menú se oculta; los datos y el modelo
       siguen ahí y el administrador las encuentra en Marketplace. -->
  <menuitem id="menu_shrimp_check_request"
    name="Solicitudes de chequeo (legado)"
    parent="menu_shrimp_catalog_root"
    action="action_shrimp_check_request"
    sequence="90"
    groups="shrimp_marketplace.group_shrimp_manager" />

  <!-- =========================================================
       INVENTARIO
  ========================================================= -->
  <menuitem id="menu_shrimp_inventory_root"
    name="Inventario"
    parent="menu_shrimp_root"
    sequence="30"
    groups="shrimp_marketplace.group_shrimp_user" />

  <menuitem id="menu_shrimp_stock_lot"
    name="Lotes"
    parent="menu_shrimp_inventory_root"
    action="shrimp_marketplace.action_shrimp_stock_lot"
    sequence="10"
    groups="shrimp_marketplace.group_shrimp_user" />

  <menuitem id="menu_shrimp_stock_move"
    name="Movimientos internos"
    parent="menu_shrimp_inventory_root"
    action="shrimp_marketplace.action_shrimp_stock_move"
    sequence="20"
    groups="shrimp_marketplace.group_shrimp_user" />

  <menuitem id="menu_shrimp_lot_allocation"
    name="Asignaciones"
    parent="menu_shrimp_inventory_root"
    action="action_shrimp_lot_allocation"
    sequence="30"
    groups="shrimp_marketplace.group_shrimp_user" />

  <!-- =========================================================
       SOCIOS E INSTALACIONES (datos de los partners)
  ========================================================= -->
  <menuitem id="menu_shrimp_partners_root"
    name="Socios e instalaciones"
    parent="menu_shrimp_root"
    sequence="40"
    groups="shrimp_marketplace.group_shrimp_user" />

  <menuitem id="menu_shrimp_facility"
    name="Instalaciones"
    parent="menu_shrimp_partners_root"
    action="action_shrimp_facility"
    sequence="10"
    groups="shrimp_marketplace.group_shrimp_user" />

  <menuitem id="menu_shrimp_pond"
    name="Piscinas"
    parent="menu_shrimp_partners_root"
    action="action_shrimp_pond"
    sequence="20"
    groups="shrimp_marketplace.group_shrimp_user" />

  <!-- =========================================================
       CONFIGURACIÓN
       (Reportes se define en shrimp_reports.xml, sequence 70;
        Unidades de medida y Claves de API se añaden desde sus
        propios archivos bajo esta raíz.)
  ========================================================= -->
  <menuitem id="menu_shrimp_config_root"
    name="Configuración"
    parent="menu_shrimp_root"
    sequence="90"
    groups="shrimp_marketplace.group_shrimp_manager" />

  <menuitem id="menu_shrimp_species"
    name="Especies"
    parent="menu_shrimp_config_root"
    action="action_shrimp_species"
    sequence="10"
    groups="shrimp_marketplace.group_shrimp_manager" />

  <menuitem id="menu_shrimp_stage"
    name="Estadíos"
    parent="menu_shrimp_config_root"
    action="action_shrimp_stage"
    sequence="20"
    groups="shrimp_marketplace.group_shrimp_manager" />

  <menuitem id="menu_shrimp_genetics"
    name="Genética"
    parent="menu_shrimp_config_root"
    action="action_shrimp_genetics"
    sequence="30"
    groups="shrimp_marketplace.group_shrimp_manager" />

</odoo>
