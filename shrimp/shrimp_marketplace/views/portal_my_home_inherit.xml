<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- /my («panel completo»): tarjetas por perfil.

       Antes eran 12 tarjetas fijas, iguales para todos los roles (la
       empacadora veía «Publicar producto», que le daba error, y seguía
       «Solicitudes de chequeo», un flujo retirado). Ahora salen de la MISMA
       tabla que la barra (website._shrimp_nav_entries, models/
       website_navbar.py), filtrada con la matriz de capacidades y el perfil
       activo: Vender · Comprar · Servicios · Más herramientas (reportes,
       disponibilidad del catálogo, instalaciones) y Mi cuenta. Una sección
       sin entradas no se pinta.

       La tarjeta «Mi panel» (/my/dashboard) va arriba del todo y la pone
       shrimp_marketplace.portal_my_home_mi_panel (dashboard_templates.xml):
       aquí no se repite.

       El verificador tiene su propio bloque (shrimp_verification.
       portal_my_home_verifier), que oculta este por su clase mp-panel. -->
  <template id="portal_my_home_add_marketplace_buttons" inherit_id="portal.portal_my_home">

    <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
      <div class="mp-panel mt-4 mb-4">
        <t t-set="mp_my_nav" t-value="website._shrimp_nav_tree()['sections'] if website else {}"/>

        <div class="mp-panel-head">
          <div class="mp-eyebrow">Tu panel</div>
          <h3 class="mp-panel-title">Marketplace</h3>
          <div class="mp-panel-sub">Publica, compra, gestiona tu operación y sigue la trazabilidad de cada lote.</div>
        </div>

        <t t-foreach="[('sell', 'Vender'), ('buy', 'Comprar'), ('services', 'Servicios'), ('panel', 'Más herramientas')]" t-as="mp_sec">
          <t t-set="mp_sec_items" t-value="mp_my_nav.get(mp_sec[0], {}).get('items', [])"/>
          <div t-if="mp_sec_items" t-attf-class="mp-my-section mp-my-section--#{mp_sec[0]}" t-att-data-shrimp-section="mp_sec[0]">
            <h4 class="mp-my-section-title" t-esc="mp_sec[1]"/>
            <div class="mp-grid">
              <t t-foreach="mp_sec_items" t-as="mp_it">
                <a t-att-href="mp_it['url']" t-attf-class="mp-tile #{'mp-tile--accent' if mp_it['key'] == 'publish' else ''}" t-att-data-shrimp-nav="mp_it['key']">
                  <div t-attf-class="mp-tile-ico mp-ico-#{mp_it.get('tone') if mp_it.get('tone') in ('blue', 'teal', 'coral', 'green', 'amber') else 'blue'}"><i t-attf-class="fa #{mp_it.get('icon') or 'fa-circle-o'}"/></div>
                  <div class="mp-tile-title" t-esc="mp_it['label']"/>
                  <div t-if="mp_it.get('desc')" class="mp-tile-desc" t-esc="mp_it['desc']"/>
                </a>
              </t>
            </div>
          </div>
        </t>

        <div class="mp-my-section mp-my-section--account" data-shrimp-section="account">
          <h4 class="mp-my-section-title">Mi cuenta</h4>
          <div class="mp-grid">
            <a href="/marketplace" class="mp-tile" data-shrimp-nav="marketplace">
              <div class="mp-tile-ico mp-ico-teal"><i class="fa fa-shopping-bag"/></div>
              <div class="mp-tile-title">Marketplace</div>
              <div class="mp-tile-desc">Explora los lotes disponibles y filtra por lo que necesitas.</div>
            </a>
            <a href="/marketplace/my-account" class="mp-tile" data-shrimp-nav="account_data">
              <div class="mp-tile-ico mp-ico-coral"><i class="fa fa-user-o"/></div>
              <div class="mp-tile-title">Mi cuenta y certificados</div>
              <div class="mp-tile-desc">Edita tus datos y gestiona o renueva tus certificados.</div>
            </a>
          </div>
        </div>
      </div>
    </xpath>

    <!-- Los estilos de las tarjetas están en static/src/css/
         shrimp_marketplace.css. El <style> se conserva (vacío) porque otras
         herencias le agregan reglas (shrimp_verification:
         portal_my_home_verifier, xpath //style). -->
    <xpath expr="." position="inside">
      <style>
      </style>
    </xpath>

  </template>
  <!-- /my: se ocultan TODAS las tarjetas nativas de Odoo (órdenes, facturas,
       direcciones, conexión y seguridad… y las que agreguen otros módulos en
       el futuro). Se deja el contenedor en la página, solo oculto, para que el
       JS del portal que cuenta documentos siga funcionando. La contraseña se
       cambia desde «Mi cuenta ▾ › Contraseña y seguridad». -->
  <template id="portal_my_home_sin_tarjetas_odoo" inherit_id="portal.portal_my_home"
            name="Mi cuenta: ocultar tarjetas nativas de Odoo" priority="99">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="attributes">
      <attribute name="class" add="d-none" separator=" "/>
    </xpath>
  </template>
</odoo>
