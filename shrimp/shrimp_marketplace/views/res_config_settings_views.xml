<odoo>
    <!-- Ajustes › CamaronMarket. Cada módulo agrega su bloque:
           Comisiones (este) · Verificación (shrimp_verification) ·
           Reservas de cosecha y proveedores (shrimp_packer) ·
           Empaque / co-packing (shrimp_copacking) · Marketplace · Facturación.
         La pantalla de Ajustes ya es solo del administrador (base.group_system). -->
    <record id="res_config_settings_view_form_shrimp" model="ir.ui.view">
        <field name="name">res.config.settings.form.shrimp.marketplace</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="CamaronMarket" name="shrimp_marketplace"
                     logo="/shrimp_marketplace/static/description/icon.png">
                    <block title="Comisiones" name="shrimp_commission_block">
                        <setting id="shrimp_commission_per_uom" string="Comisión por venta"
                                 help="La comisión que cobra el marketplace NO se configura aquí: es por cada Unidad de medida (centavos por unidad vendida), en Camaronera › Configuración › Unidades de medida. Cada unidad puede tener su propia tarifa.">
                            <div class="mt8">
                                <button type="action" name="%(shrimp_marketplace.action_shrimp_uom)d"
                                        string="Ir a Unidades de medida" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Marketplace" name="shrimp_marketplace_block">
                        <setting string="Mínimo de reseñas para destacados"
                                 help="Un laboratorio o naupliero solo aparece en «Laboratorios / Nauplieros destacados» (catálogo y página de inicio) si tiene al menos estas reseñas como vendedor. No se rellena con vendedores con menos reseñas: si no cumple ninguno, la sección no se muestra.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="shrimp_featured_min_reviews" class="col-lg-6 o_light_label"/>
                                    <field name="shrimp_featured_min_reviews"/>
                                    <span class="text-muted">reseñas como mínimo</span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Aviso de certificados por vencer"
                                 help="Mi panel avisa al socio de sus certificados (y los de sus lotes publicados) que vencen dentro de estos días.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="shrimp_cert_alert_days" class="col-lg-6 o_light_label"/>
                                    <field name="shrimp_cert_alert_days"/>
                                    <span class="text-muted">días de antelación</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Entregas y recepción" name="shrimp_reception_block">
                        <setting string="Días para confirmar recepción"
                                 help="Desde el despacho (o la fecha de entrega, si el vendedor no lo marcó), el comprador tiene estos días para confirmar que recibió la compra o reportar un problema. Si no hace nada y el vendedor marcó el despacho, la recepción se confirma automáticamente y se da por cumplida la entrega (sin despacho, la compra queda «No entregada»). Aplica a TODA compra directa; las compras verificadas se cierran con el informe aceptado.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="shrimp_reception_days" class="col-lg-6 o_light_label"/>
                                    <field name="shrimp_reception_days"/>
                                    <span class="text-muted">días</span>
                                </div>
                                <div class="row mt8">
                                    <label for="shrimp_reception_reminder_1" class="col-lg-6 o_light_label"/>
                                    <field name="shrimp_reception_reminder_1"/>
                                </div>
                                <div class="row mt8">
                                    <label for="shrimp_reception_reminder_2" class="col-lg-6 o_light_label"/>
                                    <field name="shrimp_reception_reminder_2"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Avisos de la fecha de entrega"
                                 help="Antes de la fecha de entrega se avisa al vendedor (preparar el despacho) y al comprador (preparar la recepción); también el mismo día y, si pasó la fecha sin despacho, a los dos por el atraso. Cada aviso sale una sola vez. Llegan al administrador de la cuenta y a los subusuarios con permiso de comprar / vender en ese perfil.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="shrimp_delivery_alert_days" class="col-lg-6 o_light_label"/>
                                    <field name="shrimp_delivery_alert_days"/>
                                    <span class="text-muted">días de anticipación</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Protección de datos" name="shrimp_privacy_block">
                        <setting string="Responsable de datos personales"
                                 help="Correo que aparece en la Política de privacidad y al que llegan las solicitudes de acceso, rectificación, eliminación, portabilidad u oposición (LOPDP). Si se deja vacío, las páginas piden contactar al administrador de la plataforma.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="shrimp_dpo_email" class="col-lg-6 o_light_label"/>
                                    <field name="shrimp_dpo_email" placeholder="datos@tuempresa.com"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Facturación" name="shrimp_billing_block">
                        <setting string="Reintentos automáticos"
                                 help="La plataforma factura sus servicios (comisión, honorario de verificación, cuota de empaque). Si emitir la factura falla, el proceso automático lo reintenta hasta este número de veces; después el cobro queda en «Error» para revisión manual (botón «Reintentar»).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="shrimp_charge_max_attempts" class="col-lg-6 o_light_label"/>
                                    <field name="shrimp_charge_max_attempts"/>
                                    <span class="text-muted">intentos por cobro</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
