<odoo>
    <record id="view_shrimp_check_request_tree" model="ir.ui.view">
        <field name="name">shrimp.check.request.tree</field>
        <field name="model">shrimp.check.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name" />
                <field name="product_id" />
                <field name="seller_partner_id" />
                <field name="buyer_partner_id" />
                <field name="qty" />
                <field name="uom_id" />
                <field name="state" widget="badge" />
                <field name="response_deadline" optional="show" />
                <field name="transaction_id" />
                <field name="reviewed_by" />
                <field name="reviewed_date" />
            </list>
        </field>
    </record>

    <record id="view_shrimp_check_request_form" model="ir.ui.view">
        <field name="name">shrimp.check.request.form</field>
        <field name="model">shrimp.check.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de chequeo" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="requested,under_review,approved,rejected,cancelled,expired" />
                </header>
                <div class="alert alert-warning" role="alert">
                    Flujo retirado: las solicitudes de chequeo se conservan solo para consulta.
                    Se compra directo o con verificación en campo.
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="product_id" readonly="1" />
                            <field name="seller_partner_id" readonly="1" />
                            <field name="buyer_partner_id" readonly="1" />
                            <field name="response_deadline" readonly="1" />
                        </group>
                        <group>
                            <field name="qty" readonly="1" />
                            <field name="uom_id" readonly="1" />
                            <field name="transaction_id" readonly="1" />
                            <field name="result_product_id" readonly="1" />
                        </group>
                    </group>
                    <group string="Cobro del chequeo">
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="check_fee" readonly="1" />
                        </group>
                        <group>
                            <field name="sale_order_id" readonly="1" />
                            <field name="invoice_id" readonly="1" />
                            <field name="invoice_state" widget="badge" />
                        </group>
                    </group>
                    <group>
                        <field name="note" readonly="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_shrimp_check_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de chequeo (histórico)</field>
        <field name="res_model">shrimp.check.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>


</odoo>