<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secuencia de las salidas (EXP-000001) -->
    <record id="seq_shrimp_export" model="ir.sequence">
        <field name="name">Salida / exportación</field>
        <field name="code">shrimp.export</field>
        <field name="prefix">EXP-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Portal: SOLO LECTURA de las salidas propias (lo usan la API y los
         webhooks para decidir a quién avisar). Se registran en sudo desde el
         controlador tras comprobar el dueño del lote. -->
    <record id="rule_shrimp_export_own" model="ir.rule">
        <field name="name">Shrimp Export: own (lectura)</field>
        <field name="model_id" ref="model_shrimp_export"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('partner_id', '=', user.shrimp_actor_partner_id.id)]</field>
    </record>
    <record id="rule_shrimp_export_line_own" model="ir.rule">
        <field name="name">Shrimp Export line: own (lectura)</field>
        <field name="model_id" ref="model_shrimp_export_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('export_id.partner_id', '=', user.shrimp_actor_partner_id.id)]</field>
    </record>

    <!-- Movimientos: tipo, lote, motivo y saldos -->
    <record id="view_shrimp_stock_move_tree_trz" model="ir.ui.view">
        <field name="name">shrimp.stock.move.tree.trazabilidad</field>
        <field name="model">shrimp.stock.move</field>
        <field name="inherit_id" ref="shrimp_marketplace.view_shrimp_stock_move_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="move_type"/>
                <field name="lot_id" optional="hide"/>
                <field name="reason" optional="show"/>
            </field>
        </field>
    </record>
    <record id="view_shrimp_stock_move_form_trz" model="ir.ui.view">
        <field name="name">shrimp.stock.move.form.trazabilidad</field>
        <field name="model">shrimp.stock.move</field>
        <field name="inherit_id" ref="shrimp_marketplace.view_shrimp_stock_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_move_id']" position="after">
                <field name="move_type" readonly="1"/>
                <field name="direction" readonly="1" invisible="move_type == 'transfer'"/>
                <field name="lot_id" readonly="1"/>
                <field name="allocation_id" readonly="1" invisible="not allocation_id"/>
                <field name="export_id" readonly="1" invisible="not export_id"/>
            </xpath>
            <xpath expr="//field[@name='qty']" position="after">
                <field name="reason" readonly="1" invisible="not reason"/>
                <field name="qty_before" readonly="1" invisible="move_type == 'transfer'"/>
                <field name="qty_after" readonly="1" invisible="move_type == 'transfer'"/>
            </xpath>
        </field>
    </record>
    <record id="view_shrimp_stock_move_search_trz" model="ir.ui.view">
        <field name="name">shrimp.stock.move.search.trazabilidad</field>
        <field name="model">shrimp.stock.move</field>
        <field name="inherit_id" ref="shrimp_marketplace.view_shrimp_stock_move_search"/>
        <field name="arch" type="xml">
            <field name="parent_move_id" position="after">
                <field name="move_type"/>
                <field name="lot_id"/>
            </field>
        </field>
    </record>

    <!-- Producto: siembras de origen -->
    <record id="view_shrimp_product_form_origin_alloc" model="ir.ui.view">
        <field name="name">shrimp.product.form.siembras.origen</field>
        <field name="model">shrimp.product</field>
        <field name="inherit_id" ref="shrimp_marketplace.view_shrimp_product_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Origen y siembras" name="origin_sowings">
                    <group>
                        <group>
                            <field name="origin_facility_id"
                                   domain="[('partner_id', '=', seller_partner_id), ('facility_type', 'not in', ('warehouse', 'office'))]"/>
                            <field name="origin_pond_id"
                                   invisible="not origin_facility_id and not origin_pond_id"
                                   domain="[('facility_id', '=', origin_facility_id)]"/>
                            <field name="production_date"/>
                            <field name="batch_code"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2" invisible="not origin_pond_id">
                        Lotes comprados que se sembraron en la piscina o tanque de origen antes de la
                        fecha de producción (larva para el camarón, nauplio para la larva). Si se deja
                        vacío, se proponen solos. Sin instalación ni piscina no hay siembras de origen.
                    </div>
                    <field name="origin_allocation_ids" invisible="not origin_pond_id"
                           domain="[('pond_id', '=', origin_pond_id), ('state', 'in', ('allocated', 'released'))]">
                        <list>
                            <field name="allocation_date"/>
                            <field name="pond_id"/>
                            <field name="product_id"/>
                            <field name="allocated_qty"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Salidas / exportaciones -->
    <record id="view_shrimp_export_tree" model="ir.ui.view">
        <field name="name">shrimp.export.list</field>
        <field name="model">shrimp.export</field>
        <field name="arch" type="xml">
            <list string="Salidas / exportaciones">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="destination_country_id"/>
                <field name="destination_buyer"/>
                <field name="dae_number"/>
                <field name="container"/>
                <field name="qty"/>
                <field name="uom_id"/>
                <field name="state" widget="badge"/>
                <field name="cancel_state" widget="badge" optional="show"
                       decoration-warning="cancel_state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_shrimp_export_form" model="ir.ui.view">
        <field name="name">shrimp.export.form</field>
        <field name="model">shrimp.export</field>
        <field name="arch" type="xml">
            <form string="Salida / exportación">
                <header>
                    <button name="action_register" type="object" string="Registrar salida"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <!-- D-35: anular pide motivo; con DAE o factura queda
                         pendiente de aprobación de la plataforma. -->
                    <button name="action_open_cancel_wizard" type="object" string="Anular"
                            invisible="state == 'cancelled' or cancel_state == 'pending'"/>
                    <button name="action_open_cancel_wizard" type="object" string="Aprobar anulación"
                            class="btn-primary" context="{'shrimp_export_cancel_mode': 'approve'}"
                            invisible="cancel_state != 'pending'"
                            groups="shrimp_marketplace.group_marketplace_manager"/>
                    <button name="action_open_cancel_wizard" type="object" string="Rechazar anulación"
                            context="{'shrimp_export_cancel_mode': 'reject'}"
                            invisible="cancel_state != 'pending'"
                            groups="shrimp_marketplace.group_marketplace_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,registered"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="cancel_state != 'pending'">
                        Anulación pendiente de aprobación de la plataforma. Motivo:
                        <field name="cancel_reason" class="d-inline"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Salida">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                            <field name="boxes"/>
                            <field name="container"/>
                        </group>
                        <group string="Destino y documentos">
                            <field name="destination_buyer"/>
                            <field name="confidential"/>
                            <field name="destination_country_id"/>
                            <field name="destination_place"/>
                            <field name="dae_number"/>
                            <field name="invoice_number"/>
                            <field name="price_unit"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lotes">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="lot_id" domain="[('owner_id', '=', parent.partner_id), ('available_qty', '>', 0)]"/>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="move_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Observaciones">
                            <field name="notes"/>
                        </page>
                        <page string="Anulación" invisible="not cancel_state and not cancel_reason">
                            <group>
                                <field name="cancel_state"/>
                                <field name="cancel_reason"/>
                                <field name="cancel_requested_uid"/>
                                <field name="cancel_requested_at"/>
                                <field name="cancel_decided_uid"/>
                                <field name="cancel_decided_at"/>
                                <field name="cancel_decision_note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shrimp_export_search" model="ir.ui.view">
        <field name="name">shrimp.export.search</field>
        <field name="model">shrimp.export</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="dae_number"/>
                <filter name="f_cancel_pending" string="Anulación pendiente de aprobación"
                        domain="[('cancel_state', '=', 'pending')]"/>
                <filter name="f_registered" string="Registradas" domain="[('state', '=', 'registered')]"/>
            </search>
        </field>
    </record>

    <record id="view_shrimp_export_cancel_wizard_form" model="ir.ui.view">
        <field name="name">shrimp.export.cancel.wizard.form</field>
        <field name="model">shrimp.export.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Anulación de la salida">
                <field name="export_id" invisible="1"/>
                <field name="mode" invisible="1"/>
                <p invisible="mode != 'cancel'">
                    Indica el motivo. Si la salida ya tiene DAE o factura, la anulación queda
                    pendiente hasta que un administrador de la plataforma la apruebe.
                </p>
                <p invisible="mode != 'approve'">La cantidad volverá a los lotes y la salida quedará anulada.</p>
                <p invisible="mode != 'reject'">La salida seguirá registrada. Indica por qué se rechaza.</p>
                <field name="reason" required="mode != 'approve'" placeholder="Motivo"/>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shrimp_export" model="ir.actions.act_window">
        <field name="name">Salidas / exportaciones</field>
        <field name="res_model">shrimp.export</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shrimp_export_search"/>
    </record>

    <record id="action_shrimp_export_cancel_pending" model="ir.actions.act_window">
        <field name="name">Anulaciones de salidas por aprobar</field>
        <field name="res_model">shrimp.export</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shrimp_export_search"/>
        <field name="context">{'search_default_f_cancel_pending': 1}</field>
    </record>

    <menuitem id="menu_shrimp_export_cancel_pending"
              name="Anulaciones de salidas por aprobar"
              parent="menu_shrimp_catalog_root"
              action="action_shrimp_export_cancel_pending"
              sequence="41"
              groups="shrimp_marketplace.group_marketplace_manager"/>

    <menuitem id="menu_shrimp_export"
              name="Salidas / exportaciones"
              parent="menu_shrimp_catalog_root"
              action="action_shrimp_export"
              sequence="40"
              groups="shrimp_marketplace.group_marketplace_user"/>
</odoo>
