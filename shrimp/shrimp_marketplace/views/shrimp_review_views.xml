<odoo>

  <!-- =================================================================
       Reseñas: administración desde el backoffice.

       El modelo no tenía lista, ni formulario, ni acción, ni menú, así que
       un administrador no podía tocar una reseña: ni borrar una difamatoria,
       ni corregir una duplicada, ni retirar una falsa. Y las reseñas no son
       un adorno: shrimp_rating_avg está almacenado y sale de ellas, o sea
       que alimentan la reputación pública con la que un comprador decide a
       quién le compra. La única vía era SQL directo contra la base.
       ================================================================= -->

  <record id="view_shrimp_review_list" model="ir.ui.view">
    <field name="name">shrimp.review.list</field>
    <field name="model">shrimp.review</field>
    <field name="arch" type="xml">
      <list string="Reseñas">
        <field name="create_date" string="Fecha"/>
        <field name="seller_partner_id" string="Calificado"/>
        <field name="reviewer_partner_id" string="Autor"/>
        <field name="direction"/>
        <field name="rating"/>
        <!-- Sin transacción no hay compra que respalde la reseña: es la
             señal de que alguien puede estar inflando su reputación. -->
        <field name="transaction_id" string="Operación"/>
        <field name="comment" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_review_form" model="ir.ui.view">
    <field name="name">shrimp.review.form</field>
    <field name="model">shrimp.review</field>
    <field name="arch" type="xml">
      <form string="Reseña">
        <sheet>
          <group>
            <group>
              <field name="seller_partner_id"/>
              <field name="reviewer_partner_id"/>
              <field name="direction"/>
            </group>
            <group>
              <field name="rating"/>
              <field name="transaction_id"/>
              <field name="create_date" readonly="1"/>
            </group>
          </group>
          <group string="Comentario">
            <field name="comment" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_shrimp_review_search" model="ir.ui.view">
    <field name="name">shrimp.review.search</field>
    <field name="model">shrimp.review</field>
    <field name="arch" type="xml">
      <search string="Reseñas">
        <field name="seller_partner_id"/>
        <field name="reviewer_partner_id"/>
        <field name="comment"/>
        <filter name="sin_operacion" string="Sin operación que la respalde"
                domain="[('transaction_id','=',False)]"/>
        <filter name="negativas" string="1 o 2 estrellas"
                domain="[('rating','&lt;=',2)]"/>
        <separator/>
        <filter name="g_calificado" string="Calificado"
                context="{'group_by': 'seller_partner_id'}"/>
        <filter name="g_autor" string="Autor"
                context="{'group_by': 'reviewer_partner_id'}"/>
        <filter name="g_rating" string="Calificación"
                context="{'group_by': 'rating'}"/>
      </search>
    </field>
  </record>

  <record id="action_shrimp_review" model="ir.actions.act_window">
    <field name="name">Reseñas</field>
    <field name="res_model">shrimp.review</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_shrimp_review_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Todavía no hay reseñas.</p>
      <p>Las reseñas alimentan la calificación pública de cada vendedor.
         Desde aquí se puede retirar una reseña falsa o duplicada.</p>
    </field>
  </record>

  <menuitem id="menu_shrimp_review" name="Reseñas"
            parent="menu_shrimp_partners_root" action="action_shrimp_review"
            groups="base.group_system" sequence="60"/>

</odoo>
