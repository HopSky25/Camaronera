<odoo>
  <record id="view_shrimp_transaction_tree" model="ir.ui.view">
    <field name="name">shrimp.transaction.list</field>
    <field name="model">shrimp.transaction</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="transaction_type"/>
        <field name="seller_partner_id"/>
        <field name="seller_role" optional="show"/>
        <field name="buyer_partner_id"/>
        <field name="buyer_role" optional="show"/>
        <field name="state" widget="badge"/>
        <field name="has_seller_invoice" optional="hide"/>
        <field name="sold_date"/>
        <field name="desired_date"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_transaction_form" model="ir.ui.view">
    <field name="name">shrimp.transaction.form</field>
    <field name="model">shrimp.transaction</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancel"/>
        </header>
        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name="transaction_type"/>
            <field name="product_id"/>
            <field name="seller_partner_id"/>
            <field name="seller_role" readonly="1"/>
            <field name="buyer_partner_id"/>
            <field name="buyer_role" readonly="1"/>
            <field name="location"/>
          </group>

          <notebook>
            <page string="Semillero → Lab">
              <group>
                <field name="invoice_attachment_ids" widget="many2many_binary"/>
                <field name="production_note"/>
                <field name="sold_qty"/>
                <field name="sold_date"/>
              </group>
            </page>

            <page string="Lab → Camaronera">
              <group>
                <field name="desired_qty"/>
                <field name="desired_date"/>
                <field name="code"/>
              </group>
            </page>

            <!-- La factura de la mercadería la emite el VENDEDOR desde su
                 sistema; aquí solo se registra. La plataforma factura solo
                 sus servicios (pestaña Cobros). -->
            <page string="Factura del vendedor" name="seller_invoice">
              <group>
                <group>
                  <field name="seller_invoice_number" placeholder="001-001-000000001"/>
                  <field name="seller_invoice_access_key"/>
                  <field name="seller_invoice_date"/>
                </group>
                <group>
                  <field name="seller_invoice_attachment_id"/>
                  <field name="seller_invoice_registered_at"/>
                  <field name="invoice_id" invisible="not invoice_id"/>
                </group>
              </group>
            </page>
            <page string="Cobros de la plataforma" name="platform_charges">
              <field name="charge_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="charge_type"/>
                  <field name="payer_partner_id"/>
                  <field name="currency_id" column_invisible="1"/>
                  <field name="amount" widget="monetary"/>
                  <field name="state" widget="badge"/>
                  <field name="invoice_id"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_shrimp_transaction" model="ir.actions.act_window">
    <field name="name">Transacciones</field>
    <field name="res_model">shrimp.transaction</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
