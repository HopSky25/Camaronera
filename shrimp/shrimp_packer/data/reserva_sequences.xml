<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- La referencia de la cosecha declarada. Va por secuencia y no por el
         uuid porque es lo que las dos partes se van a decir por teléfono. -->
    <record id="seq_harvest_forecast" model="ir.sequence">
      <field name="name">Cosecha declarada</field>
      <field name="code">shrimp.harvest.forecast</field>
      <field name="prefix">RES-</field>
      <field name="padding">6</field>
      <field name="company_id" eval="False"/>
    </record>

    <!-- Vencer lo que ya no tiene sentido mirar. Sin esto, la bandeja de la
         empacadora se llena de cosechas que pasaron de fecha, y una bandeja
         llena de ruido es una bandeja que se deja de abrir. -->
    <record id="cron_reserva_vencer" model="ir.cron">
      <field name="name">Reservas anticipadas: vencer declaraciones y compromisos</field>
      <field name="model_id" ref="model_shrimp_harvest_forecast"/>
      <field name="state">code</field>
      <field name="code">model._cron_vencer()
env['shrimp.harvest.commitment']._cron_vencer()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
