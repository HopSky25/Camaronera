<odoo>
  <data noupdate="1">
    <!-- Tallas presentes en las listas reales del sector que faltaban en el
         catálogo: el entero 10/20 y las colas U/12 y U/15 ("under", menos de
         12 o 15 piezas por libra: las más grandes y las más caras). -->
    <record id="size_entero_10_20" model="shrimp.size.grade">
      <field name="name">10/20</field>
      <field name="presentation">entero</field>
      <field name="sequence">5</field>
    </record>
    <record id="size_cola_u12" model="shrimp.size.grade">
      <field name="name">U/12</field>
      <field name="presentation">cola</field>
      <field name="sequence">1</field>
    </record>
    <record id="size_cola_u15" model="shrimp.size.grade">
      <field name="name">U/15</field>
      <field name="presentation">cola</field>
      <field name="sequence">2</field>
    </record>
  </data>
</odoo>
