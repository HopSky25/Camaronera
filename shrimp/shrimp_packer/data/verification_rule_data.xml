<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Matriz de verificación (shrimp_verification): la empacadora compra
       camarón adulto con verificación obligatoria, como hasta ahora. -->
  <data noupdate="1">
    <record id="verification_rule_camaronera_empacadora" model="shrimp.verification.rule">
      <field name="seller_role">camaronera</field>
      <field name="buyer_role">empacadora</field>
      <field name="policy">mandatory</field>
      <field name="note">La empacadora compra camarón adulto: verificación en campo obligatoria.</field>
    </record>
  </data>
</odoo>
