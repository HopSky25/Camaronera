<odoo>

  <!-- ===================== Documentos ===================== -->
  <record id="view_shrimp_legal_document_list" model="ir.ui.view">
    <field name="name">shrimp.legal.document.list</field>
    <field name="model">shrimp.legal.document</field>
    <field name="arch" type="xml">
      <list string="Documentos legales">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="doc_type"/>
        <field name="role" optional="show"/>
        <field name="scope"/>
        <field name="current_version_code"/>
        <field name="acceptance_count"/>
        <field name="active" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_legal_document_form" model="ir.ui.view">
    <field name="name">shrimp.legal.document.form</field>
    <field name="model">shrimp.legal.document</field>
    <field name="arch" type="xml">
      <form string="Documento legal">
        <header>
          <button name="action_new_version" type="object" string="Nueva versión" class="btn-primary"
                  help="Crea un borrador copiando el texto de la versión vigente (o abre el borrador que ya exista)."/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_acceptances" type="object" class="oe_stat_button" icon="fa-check-square-o">
              <field name="acceptance_count" widget="statinfo" string="Aceptaciones"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="code"/>
              <field name="doc_type"/>
              <field name="role" invisible="doc_type != 'annex'" required="doc_type == 'annex'"/>
              <field name="scope"/>
            </group>
            <group>
              <field name="current_version_id"/>
              <field name="public_url" widget="url"/>
              <field name="sequence"/>
              <field name="active" invisible="1"/>
            </group>
          </group>
          <field name="description" placeholder="Notas internas (no se publican)"/>
          <notebook>
            <page string="Versiones" name="versions">
              <field name="version_ids" readonly="1">
                <list decoration-success="state == 'published'" decoration-muted="state == 'superseded'">
                  <field name="name"/>
                  <field name="state" widget="badge" decoration-success="state == 'published'" decoration-info="state == 'draft'"/>
                  <field name="change_type"/>
                  <field name="published_date"/>
                  <field name="superseded_date" optional="show"/>
                  <field name="acceptance_count"/>
                  <field name="content_hash" optional="hide"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_shrimp_legal_document" model="ir.actions.act_window">
    <field name="name">Documentos legales</field>
    <field name="res_model">shrimp.legal.document</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'active_test': False}</field>
    <field name="help" type="html"><p>Contrato de uso, políticas y anexos por perfil. Cada documento tiene versiones: para cambiar
      un texto publicado se crea una «Nueva versión», se edita y se publica como cambio MAYOR (bloquea el portal hasta
      aceptarla) o MENOR (aviso).</p></field>
  </record>

  <!-- ===================== Versiones ===================== -->
  <record id="view_shrimp_legal_version_list" model="ir.ui.view">
    <field name="name">shrimp.legal.document.version.list</field>
    <field name="model">shrimp.legal.document.version</field>
    <field name="arch" type="xml">
      <list string="Versiones" decoration-success="state == 'published'" decoration-muted="state == 'superseded'">
        <field name="document_id"/>
        <field name="name"/>
        <field name="state" widget="badge" decoration-success="state == 'published'" decoration-info="state == 'draft'"/>
        <field name="change_type"/>
        <field name="published_date"/>
        <field name="published_by_id" optional="hide"/>
        <field name="acceptance_count"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_legal_version_form" model="ir.ui.view">
    <field name="name">shrimp.legal.document.version.form</field>
    <field name="model">shrimp.legal.document.version</field>
    <field name="arch" type="xml">
      <form string="Versión">
        <header>
          <button name="action_publish" type="object" string="Publicar" class="btn-primary" invisible="state != 'draft'"
                  confirm="Una vez publicada, esta versión ya no se puede modificar y sustituye a la vigente. Si el cambio es MAYOR, los usuarios no podrán seguir en el portal hasta aceptarla. ¿Publicar?"/>
          <button name="action_new_version" type="object" string="Nueva versión" invisible="state == 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,published,superseded"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_acceptances" type="object" class="oe_stat_button" icon="fa-check-square-o">
              <field name="acceptance_count" widget="statinfo" string="Aceptaciones"/>
            </button>
          </div>
          <div class="alert alert-info" role="alert" invisible="state == 'draft'">
            Versión publicada: es inmutable. Para cambiar el texto usa «Nueva versión».
          </div>
          <group>
            <group>
              <field name="document_id" readonly="state != 'draft'" options="{'no_create': True}"/>
              <field name="name" readonly="state != 'draft'"/>
              <field name="change_type" widget="radio" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="published_date"/>
              <field name="published_by_id"/>
              <field name="superseded_date" invisible="state != 'superseded'"/>
              <field name="content_hash"/>
            </group>
          </group>
          <field name="change_summary" readonly="state != 'draft'" placeholder="Qué cambia respecto de la versión anterior (se publica en el historial)"/>
          <notebook>
            <page string="Texto" name="content">
              <field name="content" readonly="state != 'draft'" options="{'codeview': true}"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_shrimp_legal_version_search" model="ir.ui.view">
    <field name="name">shrimp.legal.document.version.search</field>
    <field name="model">shrimp.legal.document.version</field>
    <field name="arch" type="xml">
      <search>
        <field name="document_id"/>
        <field name="name"/>
        <filter name="published" string="Vigentes" domain="[('state', '=', 'published')]"/>
        <filter name="draft" string="Borradores" domain="[('state', '=', 'draft')]"/>
        <filter name="major" string="Cambios mayores" domain="[('change_type', '=', 'major')]"/>
        <group>
          <filter name="by_document" string="Documento" context="{'group_by': 'document_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_shrimp_legal_version" model="ir.actions.act_window">
    <field name="name">Versiones de documentos legales</field>
    <field name="res_model">shrimp.legal.document.version</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ===================== Aceptaciones (solo lectura) ===================== -->
  <record id="view_shrimp_legal_acceptance_list" model="ir.ui.view">
    <field name="name">shrimp.legal.acceptance.list</field>
    <field name="model">shrimp.legal.acceptance</field>
    <field name="arch" type="xml">
      <list string="Aceptaciones" create="0" edit="0" delete="0">
        <field name="accepted_at"/>
        <field name="commercial_partner_id"/>
        <field name="user_id"/>
        <field name="document_id"/>
        <field name="version_code"/>
        <field name="role" optional="show"/>
        <field name="channel"/>
        <field name="ip" optional="show"/>
        <field name="receipt_state" widget="badge" decoration-success="receipt_state == 'done'" decoration-danger="receipt_state == 'error'"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_legal_acceptance_form" model="ir.ui.view">
    <field name="name">shrimp.legal.acceptance.form</field>
    <field name="model">shrimp.legal.acceptance</field>
    <field name="arch" type="xml">
      <form string="Aceptación" create="0" edit="0" delete="0">
        <header>
          <button name="action_retry_receipt" type="object" string="Reintentar comprobante"
                  invisible="receipt_state not in ('pending', 'error')"/>
        </header>
        <sheet>
          <group>
            <group string="Quién">
              <field name="commercial_partner_id"/>
              <field name="company_vat"/>
              <field name="user_id"/>
              <field name="user_login"/>
              <field name="partner_id"/>
              <field name="is_account_admin"/>
            </group>
            <group string="Qué">
              <field name="document_id"/>
              <field name="version_id"/>
              <field name="role"/>
              <field name="content_hash"/>
            </group>
            <group string="Cuándo y cómo">
              <field name="accepted_at"/>
              <field name="ip"/>
              <field name="user_agent"/>
              <field name="channel"/>
            </group>
            <group string="Comprobante">
              <field name="receipt_state"/>
              <field name="receipt_attachment_id"/>
              <field name="receipt_hash"/>
              <field name="receipt_attempts"/>
              <field name="receipt_error"/>
              <field name="uuid_ref"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_shrimp_legal_acceptance_search" model="ir.ui.view">
    <field name="name">shrimp.legal.acceptance.search</field>
    <field name="model">shrimp.legal.acceptance</field>
    <field name="arch" type="xml">
      <search>
        <field name="commercial_partner_id"/>
        <field name="user_id"/>
        <field name="document_id"/>
        <field name="version_id"/>
        <field name="ip"/>
        <filter name="signup" string="En el registro" domain="[('channel', '=', 'signup')]"/>
        <filter name="gate" string="En la pantalla de acceso" domain="[('channel', '=', 'login_gate')]"/>
        <filter name="profile" string="Al activar un perfil" domain="[('channel', '=', 'profile')]"/>
        <filter name="receipt_error" string="Comprobante con error" domain="[('receipt_state', '=', 'error')]"/>
        <group>
          <filter name="by_document" string="Documento" context="{'group_by': 'document_id'}"/>
          <filter name="by_version" string="Versión" context="{'group_by': 'version_id'}"/>
          <filter name="by_partner" string="Empresa" context="{'group_by': 'commercial_partner_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_shrimp_legal_acceptance" model="ir.actions.act_window">
    <field name="name">Aceptaciones</field>
    <field name="res_model">shrimp.legal.acceptance</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html"><p>Historial inmutable de lo que aceptó cada usuario, con su comprobante PDF.</p></field>
  </record>

  <!-- ===================== Usuarios de cuentas ===================== -->
  <record id="view_shrimp_account_member_list" model="ir.ui.view">
    <field name="name">shrimp.account.member.list</field>
    <field name="model">shrimp.account.member</field>
    <field name="arch" type="xml">
      <list string="Usuarios de cuentas">
        <field name="company_id"/>
        <field name="user_id"/>
        <field name="login"/>
        <field name="is_admin"/>
        <field name="state"/>
        <field name="last_login"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_account_member_form" model="ir.ui.view">
    <field name="name">shrimp.account.member.form</field>
    <field name="model">shrimp.account.member</field>
    <field name="arch" type="xml">
      <form string="Usuario de la cuenta">
        <sheet>
          <group>
            <group>
              <field name="company_id"/>
              <field name="user_id"/>
              <field name="is_admin"/>
              <field name="active"/>
            </group>
            <group>
              <field name="state"/>
              <field name="last_login"/>
              <field name="invited_by_id"/>
              <field name="invite_date"/>
            </group>
          </group>
          <field name="permission_ids" invisible="is_admin">
            <list editable="bottom">
              <field name="role"/>
              <field name="can_buy"/>
              <field name="can_sell"/>
              <field name="can_approve"/>
              <field name="can_billing"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_shrimp_account_member" model="ir.actions.act_window">
    <field name="name">Usuarios de las cuentas</field>
    <field name="res_model">shrimp.account.member</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'active_test': False}</field>
  </record>

  <!-- ===================== Ficha del contacto ===================== -->
  <record id="view_partner_form_shrimp_legal" model="ir.ui.view">
    <field name="name">res.partner.form.shrimp.legal</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_shrimp_legal_acceptances" type="object" class="oe_stat_button"
                icon="fa-file-text-o" groups="base.group_system" invisible="not shrimp_legal_acceptance_count">
          <field name="shrimp_legal_acceptance_count" widget="statinfo" string="Contratos aceptados"/>
        </button>
      </xpath>
      <xpath expr="//page[@name='shrimp_tab']//group[@name='shrimp_roles']" position="after">
        <group string="Usuarios de la cuenta" name="shrimp_members" groups="base.group_system"
               invisible="not shrimp_member_ids">
          <field name="shrimp_member_ids" nolabel="1" colspan="2" readonly="1" context="{'active_test': False}">
            <list>
              <field name="user_id"/>
              <field name="login"/>
              <field name="is_admin"/>
              <field name="state"/>
              <field name="last_login"/>
            </list>
          </field>
        </group>
        <group string="Datos del registro" name="shrimp_signup_data">
          <field name="shrimp_person_type"/>
          <field name="shrimp_contact_name"/>
          <field name="shrimp_actividad"/>
          <field name="shrimp_num_piscinas"/>
          <field name="shrimp_permiso_ambiental"/>
          <field name="shrimp_permiso_funcionamiento"/>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
