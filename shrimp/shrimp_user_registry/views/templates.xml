<odoo>

  


  <!-- Campo trampa (honeypot) para el alta pública. Fuera de pantalla y fuera
       del orden de tabulación: una persona no lo ve ni lo rellena; un bot que
       completa todos los campos sí, y su alta se descarta. -->
  <!-- Consentimiento informado (LOPDP) de TODOS los formularios de alta:
       el genérico, empacadora, maquilador y verificador. El servidor lo exige
       (/register/submit), así que cada formulario tiene que llevarlo. -->
  

  <!-- A quién escribir por los datos personales: el correo configurado en
       Ajustes › CamaronMarket (shrimp.dpo_email) o, si no hay, un texto
       genérico (nunca una dirección inventada). -->
  <template id="dpo_contacto" name="Contacto de protección de datos">
    <t t-if="dpo_email">escribe a <a t-attf-href="mailto:#{dpo_email}"><t t-esc="dpo_email"/></a></t>
    <t t-else="">contacta al administrador de la plataforma</t>
  </template>

  <template id="signup_honeypot" name="Registro: campo trampa">
    <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
      <label for="website_hp">No completar este campo</label>
      <input type="text" id="website_hp" name="website_hp" value="" tabindex="-1" autocomplete="off"/>
    </div>
  </template>

  <!-- Página para cuentas pendientes de aprobación (empacadora, maquilador). -->
  <template id="account_pending" name="Cuenta pendiente de aprobación">
    <t t-call="website.layout">
      <div class="container py-5" style="max-width:720px;">
        <div class="alert alert-warning" role="alert">
          <h4 class="alert-heading"><i class="fa fa-hourglass-half me-1"/> Tu cuenta está en revisión</h4>
          <p class="mb-1">La administración de la plataforma debe aprobar tu cuenta antes de que
             puedas usar las funciones de tu rol (listas de precios, compras, órdenes de empaque…).</p>
          <p class="mb-0">Te avisaremos por correo cuando esté aprobada. Mientras tanto puedes
             completar tu perfil en <a href="/marketplace/my-account">Mi cuenta</a>.</p>
        </div>
      </div>
    </t>
  </template>

  <!-- ===================== Protección de datos (LOPDP) ===================== -->
  

  

  

  <!-- Aceptación de la versión vigente de la política (socios que se
       registraron antes o aceptaron una versión anterior). -->
  
</odoo>
