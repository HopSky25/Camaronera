<odoo>
  <data noupdate="0">

    <!-- Vence los plazos de la ronda de aceptación. Corre cada hora: no hace
         falta más fino porque el plazo se mide en días, y menos frecuente
         dejaría compras cerradas horas después de lo prometido. -->
    <record id="ir_cron_acceptance_deadline" model="ir.cron">
      <field name="name">Verificación: vencer plazos de aceptación</field>
      <field name="model_id" ref="shrimp_verification.model_shrimp_verification"/>
      <field name="state">code</field>
      <field name="code">model._cron_vencer_plazos()</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">hours</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
