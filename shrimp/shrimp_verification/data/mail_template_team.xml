<odoo>
  <data noupdate="0">
    <!-- Aviso al técnico que se suma como APOYO a una verificación. -->
    <record id="mail_template_verification_support_assigned" model="mail.template">
      <field name="name">Verificación - técnico de apoyo</field>
      <field name="model_id" ref="shrimp_verification.model_shrimp_verification"/>
      <field name="subject">Te sumaron como técnico de apoyo: {{ object.name }}</field>
      <field name="email_from">{{ user.company_id.email_formatted or user.email_formatted or '' }}</field>
      <field name="body_html" type="html">
        <div style="font-family:Arial,sans-serif;font-size:14px;color:#243b45;">
          <p>Hola <t t-out="ctx.get('destinatario') or ''"/>,</p>
          <p><b><t t-out="object.verifier_partner_id.name or ''"/></b> te sumó como
             <b>técnico de apoyo</b> en la verificación <b><t t-out="object.name or ''"/></b>.
             Puedes cargar los datos de campo (muestreo, pesos, sabor, fotos y notas);
             el veredicto lo firma el técnico responsable,
             <b><t t-out="object.technician_partner_id.name or ''"/></b>.</p>
          <table style="border-collapse:collapse;margin:12px 0;">
            <tr><td style="padding:4px 12px 4px 0;color:#5A6B74;">Producto</td><td><b><t t-out="object.product_id.name or ''"/></b></td></tr>
            <tr><td style="padding:4px 12px 4px 0;color:#5A6B74;">Lote</td><td><t t-out="object.batch_code or '-'"/></td></tr>
            <tr><td style="padding:4px 12px 4px 0;color:#5A6B74;">Vendedor</td><td><t t-out="object.seller_partner_id.name or ''"/></td></tr>
            <tr><td style="padding:4px 12px 4px 0;color:#5A6B74;">Cantidad</td><td><t t-out="object.transaction_id.transaction_qty or 0"/></td></tr>
          </table>
          <p>
            <a t-attf-href="{{ ctx.get('portal_url') or object.get_base_url() }}"
               style="background:#0d7c88;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;display:inline-block;">
              Abrir la verificación
            </a>
          </p>
        </div>
      </field>
    </record>
  </data>
</odoo>
