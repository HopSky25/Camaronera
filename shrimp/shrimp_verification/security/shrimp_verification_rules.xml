<odoo>
  <!-- ================================================================
       Quién ve y quién ESCRIBE el informe de verificación.

       Las tres partes tienen que poder leerlo: es el documento con el que se
       cierra la compra. Pero escribirlo es trabajo del verificador y de nadie
       más. Antes las reglas no distinguían permiso, así que el dominio de
       lectura —que incluye a comprador y vendedor— también les concedía
       escritura y borrado sobre las líneas y los conteos de campo. Es decir:
       la parte a la que el informe perjudica podía editar o borrar la
       clasificación por tallas y la evidencia primaria del dictamen que le
       cuesta dinero. Es el peor agujero posible en un sistema cuyo valor es
       precisamente que el informe sea creíble.

       Los controladores del portal trabajan con sudo(), así que cerrar la
       escritura aquí no le quita ninguna acción legítima a nadie: la
       aceptación, la contraoferta y el rechazo siguen funcionando.

       Desde 19.0.1.2.0 la ACL del portal es de SOLO LECTURA sobre la
       verificación, sus líneas, sus conteos y las posturas; las antiguas
       reglas "solo la escribe el verificador" se retiraron porque ya no hay
       escritura que acotar (el informe se guarda por el controlador, que
       valida técnico/empresa y que la verificación no esté cerrada).
       ================================================================ -->

  <!-- === Cabecera de la verificación === -->
  <record id="rule_shrimp_verification_portal" model="ir.rule">
    <field name="name">Verificación: la leen las tres partes</field>
    <field name="model_id" ref="model_shrimp_verification"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="domain_force">['|','|',
        ('verifier_partner_id','=',user.shrimp_actor_partner_id.id),
        ('buyer_partner_id','=',user.shrimp_actor_partner_id.id),
        ('seller_partner_id','=',user.shrimp_actor_partner_id.id)]</field>
  </record>


  <!-- === Clasificación por tallas (líneas del informe) === -->
  <record id="rule_shrimp_verification_line_portal" model="ir.rule">
    <field name="name">Clasificación por tallas: la leen las tres partes</field>
    <field name="model_id" ref="model_shrimp_verification_line"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="domain_force">['|','|',
        ('verification_id.verifier_partner_id','=',user.shrimp_actor_partner_id.id),
        ('verification_id.buyer_partner_id','=',user.shrimp_actor_partner_id.id),
        ('verification_id.seller_partner_id','=',user.shrimp_actor_partner_id.id)]</field>
  </record>


  <!-- === Conteos de campo: la evidencia primaria === -->
  <!-- Este modelo NO tenía ninguna regla de registro, y el portal tiene
       lectura, escritura, creación y borrado sobre él. Sin regla, un dominio
       vacío significa "todos los registros": cualquier usuario de portal
       podía leer, alterar y borrar los conteos de CUALQUIER verificación,
       incluidas las de terceros con las que no tiene ninguna relación. -->
  <record id="rule_shrimp_verification_count_portal" model="ir.rule">
    <field name="name">Conteos de campo: los leen las tres partes</field>
    <field name="model_id" ref="model_shrimp_verification_count"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="domain_force">['|','|',
        ('verification_id.verifier_partner_id','=',user.shrimp_actor_partner_id.id),
        ('verification_id.buyer_partner_id','=',user.shrimp_actor_partner_id.id),
        ('verification_id.seller_partner_id','=',user.shrimp_actor_partner_id.id)]</field>
  </record>


  <!-- === Postura de cada parte === -->
  <!-- SOLO LECTURA. Antes la regla no declaraba perm_* (valía para leer,
       escribir, crear y borrar) e incluía al verificador: por RPC el vendedor
       podía escribir "accepted" en la postura del comprador, o el verificador
       firmar por los dos. Ahora el portal solo lee, y la firma pasa por el
       controlador → action_accept/action_reject/action_counter, que exigen
       que quien firma sea el titular de la postura (ver _check_actor). -->
  <record id="rule_shrimp_verification_acceptance_portal" model="ir.rule">
    <field name="name">Aceptación de verificación: lectura de las partes</field>
    <field name="model_id" ref="model_shrimp_verification_acceptance"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="domain_force">['|','|',
        ('verification_id.verifier_partner_id','=',user.shrimp_actor_partner_id.id),
        ('verification_id.buyer_partner_id','=',user.shrimp_actor_partner_id.id),
        ('verification_id.seller_partner_id','=',user.shrimp_actor_partner_id.id)]</field>
  </record>

  <!-- ================================================================
       Equipo de campo (técnico responsable + técnicos de apoyo).
       Solo LECTURA, como el resto del portal: el informe lo graba el
       controlador (sudo) después de comprobar que quien escribe es un técnico
       asignado o la empresa, y el veredicto solo el responsable o la empresa.
       ================================================================ -->
  <record id="rule_shrimp_verification_team_portal" model="ir.rule">
    <field name="name">Verificación: la leen los técnicos asignados (responsable y apoyo)</field>
    <field name="model_id" ref="model_shrimp_verification"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="domain_force">['|',
        ('technician_partner_id','=',user.shrimp_actor_partner_id.id),
        ('support_technician_ids','in',[user.shrimp_actor_partner_id.id])]</field>
  </record>
  <record id="rule_shrimp_verification_line_team_portal" model="ir.rule">
    <field name="name">Clasificación por tallas: la leen los técnicos asignados</field>
    <field name="model_id" ref="model_shrimp_verification_line"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="domain_force">['|',
        ('verification_id.technician_partner_id','=',user.shrimp_actor_partner_id.id),
        ('verification_id.support_technician_ids','in',[user.shrimp_actor_partner_id.id])]</field>
  </record>
  <record id="rule_shrimp_verification_count_team_portal" model="ir.rule">
    <field name="name">Conteos de campo: los leen los técnicos asignados</field>
    <field name="model_id" ref="model_shrimp_verification_count"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="domain_force">['|',
        ('verification_id.technician_partner_id','=',user.shrimp_actor_partner_id.id),
        ('verification_id.support_technician_ids','in',[user.shrimp_actor_partner_id.id])]</field>
  </record>

  <!-- ================================================================
       App «Verificador» del backoffice (19.0.1.19.0).

       Quién VE la app (selector de apps) y su configuración. El acceso a los
       datos no cambia: «Usuario» implica Operador y «Administrador» implica
       Administrador de los datos de la plataforma (shrimp_marketplace), que
       son los que llevan las ACL y reglas de las verificaciones.
       ================================================================ -->
  <record id="res_groups_privilege_verification" model="res.groups.privilege">
    <field name="name">CamaronMarket · Verificador</field>
    <field name="sequence">61</field>
  </record>

  <record id="group_verification_user" model="res.groups">
    <field name="name">Usuario</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="res_groups_privilege_verification"/>
    <field name="implied_ids" eval="[(4, ref('shrimp_marketplace.group_shrimp_user'))]"/>
    <field name="comment">Ve la app Verificador: verificaciones, despachos a planta, verificadoras y técnicos.</field>
  </record>

  <record id="group_verification_manager" model="res.groups">
    <field name="name">Administrador</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="res_groups_privilege_verification"/>
    <field name="implied_ids" eval="[(4, ref('group_verification_user')), (4, ref('shrimp_marketplace.group_shrimp_manager'))]"/>
    <field name="comment">Además: acreditaciones, matriz de verificación, criterios de cata, cargos de técnico y ajustes.</field>
  </record>

  <!-- Todo administrador del sistema administra también el Verificador. -->
  <record id="base.group_system" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_verification_manager'))]"/>
  </record>
</odoo>
