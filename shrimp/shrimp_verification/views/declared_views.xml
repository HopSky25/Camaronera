<odoo>

  <!-- Modo de verificación en el backoffice: verificadora de la plataforma o
       verificación declarada por las partes (herencias, para no tocar las
       vistas base). -->
  <record id="view_shrimp_verification_list_mode" model="ir.ui.view">
    <field name="name">shrimp.verification.list.mode</field>
    <field name="model">shrimp.verification</field>
    <field name="inherit_id" ref="shrimp_verification.view_shrimp_verification_list"/>
    <field name="arch" type="xml">
      <field name="verifier_partner_id" position="before">
        <field name="verification_mode" optional="show"/>
      </field>
    </field>
  </record>

  <record id="view_shrimp_verification_form_mode" model="ir.ui.view">
    <field name="name">shrimp.verification.form.mode</field>
    <field name="model">shrimp.verification</field>
    <field name="inherit_id" ref="shrimp_verification.view_shrimp_verification_form"/>
    <field name="arch" type="xml">
      <field name="transaction_id" position="before">
        <field name="verification_mode" readonly="1"/>
      </field>
      <field name="verifier_partner_id" position="attributes">
        <attribute name="required">verification_mode == 'platform'</attribute>
        <attribute name="invisible">verification_mode == 'declared'</attribute>
      </field>
      <field name="fee" position="attributes">
        <attribute name="invisible">verification_mode == 'declared'</attribute>
      </field>
      <xpath expr="//sheet/group" position="after">
        <group string="Verificación declarada por las partes"
               invisible="verification_mode != 'declared'">
          <group>
            <field name="declared_source"/>
            <field name="external_verifier_name"/>
            <field name="external_verifier_vat"/>
            <field name="declared_report_file" filename="declared_report_filename"/>
            <field name="declared_report_filename" invisible="1"/>
          </group>
          <group>
            <field name="declarant_partner_id"/>
            <field name="declarant_role"/>
            <field name="declared_submitted_date"/>
            <field name="declared_last_editor_id"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_shrimp_verification_search_mode" model="ir.ui.view">
    <field name="name">shrimp.verification.search.mode</field>
    <field name="model">shrimp.verification</field>
    <field name="inherit_id" ref="shrimp_verification.view_shrimp_verification_search"/>
    <field name="arch" type="xml">
      <filter name="rejected" position="after">
        <separator/>
        <filter name="mode_platform" string="Verificadora de la plataforma"
                domain="[('verification_mode', '=', 'platform')]"/>
        <filter name="mode_declared" string="Declaradas por las partes"
                domain="[('verification_mode', '=', 'declared')]"/>
      </filter>
    </field>
  </record>

</odoo>
