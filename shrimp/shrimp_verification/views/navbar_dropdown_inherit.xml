<odoo>

  <!-- El verificador en el sitio PRINCIPAL: antes una plantilla
       (submenu_mi_panel_verificador) sustituía el desplegable «Productos»
       por sus accesos. Con la barra nueva del marketplace esos accesos se
       declaran en models/website_navbar.py (Servicios ▾ > Verificación, por
       la capacidad «verify») y su cuenta va en «Mi cuenta ▾». La vista
       vieja se elimina al actualizar el módulo. -->

  <!-- ============================================================
       Dropdowns del VERIFICADOR con el mismo estilo del marketplace.
       Sus menús (claves verifier_jobs y verifier_company) tienen hijos,
       así que Odoo los pinta con la rama nativa t-elif="show_dropdown".
       Este inherit va DIRECTO sobre website.submenu (donde existe esa
       rama): oculta la versión nativa por CLAVE y añade los mp-menu con
       íconos.
       ============================================================ -->
  <template id="submenu_verifier_dropdowns" inherit_id="website.submenu"
            name="Dropdowns con estilo - verificador">

    <xpath expr="//li[a[@t-if='not is_accordion_nav']]" position="attributes">
      <attribute name="t-elif">show_dropdown and submenu.shrimp_key not in ('verifier_jobs', 'verifier_company')</attribute>
    </xpath>

    <xpath expr="//li[a[@t-if='not is_accordion_nav']]" position="before">

      <!-- ===== Verificaciones ===== -->
      <li t-if="submenu.is_visible and submenu.shrimp_key == 'verifier_jobs'"
          t-attf-class="#{item_class or ''} dropdown shrimp-dd shrimp-dd-verifier-jobs" role="presentation">
        <a href="#"
           t-attf-class="dropdown-toggle #{link_class or ''} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}"
           data-bs-toggle="dropdown" data-bs-auto-close="outside" role="menuitem">
          <span t-field="submenu.name"/>
        </a>
        <ul t-attf-class="dropdown-menu mp-menu #{dropdown_menu_classes}" role="menu">
          <!-- La lista sale de website._shrimp_verifier_jobs()
               (models/website_navbar.py): la misma de las tarjetas del
               panel (/my) y de «Servicios ▾ > Verificación» del marketplace. -->
          <t t-foreach="website._shrimp_verifier_jobs()" t-as="vj">
            <li t-if="vj['key'] == 'all'"><hr class="dropdown-divider"/></li>
            <li><a role="menuitem" class="dropdown-item mp-menu-item" t-att-href="vj['url']" t-att-data-shrimp-nav="'verify_%s' % vj['key']"><span t-attf-class="mp-menu-ico mp-mi-#{vj['tone']}"><i t-attf-class="fa #{vj['icon']}"/></span><span t-esc="vj['label']"/></a></li>
          </t>
        </ul>
      </li>

      <!-- ===== Mi empresa ===== -->
      <li t-if="submenu.is_visible and submenu.shrimp_key == 'verifier_company'"
          t-attf-class="#{item_class or ''} dropdown shrimp-dd shrimp-dd-verifier-company" role="presentation">
        <a href="#"
           t-attf-class="dropdown-toggle #{link_class or ''} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}"
           data-bs-toggle="dropdown" data-bs-auto-close="outside" role="menuitem">
          <span t-field="submenu.name"/>
        </a>
        <ul t-attf-class="dropdown-menu mp-menu #{dropdown_menu_classes}" role="menu">
          <!-- website._shrimp_verifier_company_links(): la misma lista de
               las tarjetas del panel. El técnico (no admin de la empresa) ve
               el perfil en solo lectura y no ve «Mi equipo» (403). -->
          <t t-foreach="website._shrimp_verifier_company_links()" t-as="vc">
            <li><a role="menuitem" class="dropdown-item mp-menu-item" t-att-href="vc['url']" t-att-data-shrimp-nav="vc['key']"><span t-attf-class="mp-menu-ico mp-mi-#{vc['tone']}"><i t-attf-class="fa #{vc['icon']}"/></span><span t-esc="vc['label']"/></a></li>
          </t>
        </ul>
      </li>

    </xpath>

  </template>

</odoo>
