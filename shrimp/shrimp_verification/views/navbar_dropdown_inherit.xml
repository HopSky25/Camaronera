<odoo>

  <!-- El verificador en el sitio PRINCIPAL: antes una plantilla
       (submenu_mi_panel_verificador) sustituía el desplegable «Productos»
       por sus accesos. Con la barra nueva del marketplace esos accesos se
       declaran en models/website_navbar.py (Servicios ▾ > Verificación, por
       la capacidad «verify») y su cuenta va en «Mi cuenta ▾». La vista
       vieja se elimina al actualizar el módulo. -->

  <!-- ============================================================
       Dropdowns del VERIFICADOR con el mismo estilo del marketplace.
       Sus menús (claves verifier_jobs y verifier_company) tienen hijos,
       así que Odoo los pinta con la rama nativa t-elif="show_dropdown".
       Este inherit va DIRECTO sobre website.submenu (donde existe esa
       rama): oculta la versión nativa por CLAVE y añade los mp-menu con
       íconos.
       ============================================================ -->
  <template id="submenu_verifier_dropdowns" inherit_id="website.submenu"
            name="Dropdowns con estilo - verificador">

    <xpath expr="//li[a[@t-if='not is_accordion_nav']]" position="attributes">
      <attribute name="t-elif">show_dropdown and submenu.shrimp_key not in ('verifier_jobs', 'verifier_company')</attribute>
    </xpath>

    <xpath expr="//li[a[@t-if='not is_accordion_nav']]" position="before">

      <!-- ===== Verificaciones ===== -->
      <li t-if="submenu.is_visible and submenu.shrimp_key == 'verifier_jobs'"
          t-attf-class="#{item_class or ''} dropdown shrimp-dd shrimp-dd-verifier-jobs" role="presentation">
        <a href="#"
           t-attf-class="dropdown-toggle #{link_class or ''} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}"
           data-bs-toggle="dropdown" data-bs-auto-close="outside" role="menuitem">
          <span t-field="submenu.name"/>
        </a>
        <ul t-attf-class="dropdown-menu mp-menu #{dropdown_menu_classes}" role="menu">
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/verifier/inbox?state=pending"><span class="mp-menu-ico mp-mi-teal"><i class="fa fa-hourglass-start"/></span><span>Por iniciar</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/verifier/inbox?state=in_field"><span class="mp-menu-ico mp-mi-amber"><i class="fa fa-map-marker"/></span><span>En campo</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/verifier/inbox?state=done"><span class="mp-menu-ico mp-mi-navy"><i class="fa fa-gavel"/></span><span>Por dictaminar</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/verifier/inbox?state=approved"><span class="mp-menu-ico mp-mi-green"><i class="fa fa-check-circle"/></span><span>Ya verificadas</span></a></li>
          <li><hr class="dropdown-divider"/></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/verifier/inbox"><span class="mp-menu-ico mp-mi-blue"><i class="fa fa-list"/></span><span>Todas mis verificaciones</span></a></li>
        </ul>
      </li>

      <!-- ===== Mi empresa ===== -->
      <li t-if="submenu.is_visible and submenu.shrimp_key == 'verifier_company'"
          t-attf-class="#{item_class or ''} dropdown shrimp-dd shrimp-dd-verifier-company" role="presentation">
        <a href="#"
           t-attf-class="dropdown-toggle #{link_class or ''} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}"
           data-bs-toggle="dropdown" data-bs-auto-close="outside" role="menuitem">
          <span t-field="submenu.name"/>
        </a>
        <ul t-attf-class="dropdown-menu mp-menu #{dropdown_menu_classes}" role="menu">
          <!-- El técnico (no admin de la empresa) ve el perfil en solo lectura
               y no ve "Mi equipo": esa ruta le devuelve 403. -->
          <t t-set="mp_es_admin_verif" t-value="request.env.user.partner_id.sudo().shrimp_is_verifier_admin()"/>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/verifier/profile"><span class="mp-menu-ico mp-mi-teal"><i class="fa fa-id-badge"/></span><span t-if="mp_es_admin_verif">Perfil y cuenta bancaria</span><span t-else="">Perfil de la empresa</span></a></li>
          <li t-if="mp_es_admin_verif"><a role="menuitem" class="dropdown-item mp-menu-item" href="/verifier/technicians"><span class="mp-menu-ico mp-mi-blue"><i class="fa fa-users"/></span><span>Mi equipo</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/my-certificates"><span class="mp-menu-ico mp-mi-coral"><i class="fa fa-certificate"/></span><span>Mi acreditación</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/verifier/reports"><span class="mp-menu-ico mp-mi-green"><i class="fa fa-bar-chart"/></span><span>Mis reportes</span></a></li>
        </ul>
      </li>

    </xpath>

  </template>

</odoo>
