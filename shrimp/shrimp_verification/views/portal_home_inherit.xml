<odoo>

  <template id="portal_my_home_verifier"
            inherit_id="shrimp_marketplace.portal_my_home_add_marketplace_buttons"
            name="Panel del verificador">

    <!-- El panel de vendedor/comprador no aplica a un verificador: no publica
         lotes, no tiene piscinas ni inventario. Se oculta para ese rol. -->
    <xpath expr="//div[hasclass('mp-panel')]" position="attributes">
      <attribute name="t-if">not request.env.user.shrimp_actor_partner_id.shrimp_verifier_company()</attribute>
    </xpath>

    <xpath expr="//div[hasclass('mp-panel')]" position="before">
      <t t-if="request.env.user.shrimp_actor_partner_id.shrimp_verifier_company()">
        <t t-set="me" t-value="request.env.user.shrimp_actor_partner_id"/>
        <t t-set="Verif" t-value="request.env['shrimp.verification'].sudo()"/>
        <t t-set="mine" t-value="[('verifier_partner_id', '=', me.shrimp_verifier_company().id)] if me.shrimp_is_verifier_admin() else ['|', ('technician_partner_id', '=', me.id), ('support_technician_ids', 'in', [me.id])]"/>

        <div class="mp-panel mt-4 mb-4">
          <div class="mp-panel-head">
            <div class="mp-eyebrow">Tu panel</div>
            <h3 class="mp-panel-title">Verificación en campo</h3>
            <div class="mp-panel-sub">
              Compras que debes inspeccionar antes de que se concreten.
            </div>
          </div>

          <div t-if="not me.verifier_is_accredited" class="alert alert-warning" role="alert">
            <strong>Tu acreditación todavía no está aprobada.</strong>
            Mientras tanto no aparecerás como verificador disponible para los
            compradores, así que no recibirás nuevas asignaciones.
          </div>

          <div class="mp-grid">

            <!-- Las mismas listas que el menú del sitio de verificadores
                 (website._shrimp_verifier_jobs / _shrimp_verifier_company_links,
                 models/website_navbar.py). -->
            <t t-set="vp_tonos" t-value="{'teal': 'vp-count', 'amber': 'vp-count vp-count--amber', 'navy': 'vp-count vp-count--blue', 'green': 'vp-count vp-count--green', 'coral': 'vp-count vp-count--coral', 'blue': 'vp-count vp-count--blue'}"/>
            <t t-foreach="website._shrimp_verifier_jobs()" t-as="vj">
              <t t-set="vj_n" t-value="Verif.search_count(mine + [('state', 'in', list(vj['states']))]) if vj['states'] else 0"/>
              <a t-att-href="vj['url']" t-attf-class="mp-tile #{'mp-tile--accent' if vj_first else ''}" t-att-data-shrimp-nav="'verify_%s' % vj['key']">
                <div t-attf-class="mp-tile-ico mp-ico-#{'blue' if vj['tone'] == 'navy' else vj['tone']}"><i t-attf-class="fa #{vj['icon']}"/></div>
                <div class="mp-tile-title">
                  <t t-esc="vj['label']"/>
                  <span t-if="vj_n" t-att-class="vp_tonos.get(vj['tone'], 'vp-count')"><t t-esc="vj_n"/></span>
                </div>
                <div class="mp-tile-desc" t-esc="vj['desc']"/>
              </a>
            </t>

            <t t-foreach="website._shrimp_verifier_company_links(me)" t-as="vc">
              <a t-att-href="vc['url']" class="mp-tile" t-att-data-shrimp-nav="vc['key']">
                <div t-attf-class="mp-tile-ico mp-ico-#{vc['tone']}"><i t-attf-class="fa #{vc['icon']}"/></div>
                <div class="mp-tile-title">
                  <t t-esc="vc['label']"/>
                  <span t-if="vc['key'] == 'verifier_team' and me.field_tech_count" class="vp-count vp-count--blue"><t t-esc="me.field_tech_count"/></span>
                </div>
                <div class="mp-tile-desc" t-esc="vc['desc']"/>
              </a>
            </t>

            <a href="/marketplace/my-account" class="mp-tile">
              <div class="mp-tile-ico mp-ico-teal"><i class="fa fa-user-o"/></div>
              <div class="mp-tile-title">Mi cuenta</div>
              <div class="mp-tile-desc">Edita los datos de tu empresa y tu contacto.</div>
            </a>

          </div>
        </div>
      </t>
    </xpath>

    <xpath expr="//style" position="inside">
      .vp-count{ display:inline-flex; align-items:center; justify-content:center;
                 min-width:24px; height:24px; padding:0 7px; margin-left:8px;
                 border-radius:999px; font-size:13px; font-weight:700;
                 background:#0e8ea0; color:#fff; vertical-align:middle; }
      .vp-count--amber { background:#c98a06; }
      .vp-count--blue  { background:#123e5c; }
      .vp-count--green { background:#1f7d56; }
      .vp-count--coral { background:#c0562e; }
    </xpath>

  </template>

</odoo>
