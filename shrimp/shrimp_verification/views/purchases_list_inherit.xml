<odoo>

  <template id="purchases_list_verification_actions"
            inherit_id="shrimp_marketplace.marketplace_purchased_products"
            name="Compras - acciones según el estado de verificación">

    <!-- El comprobante y el certificado PDF ya solo se ofrecen con la compra
         cerrada (confirmada o recibida): lo decide la plantilla base. Aquí
         se añade el acceso a lo que la compra verificada tiene pendiente. -->
    <xpath expr="//a[contains(@t-att-href, 'marketplace/thanks')]/.." position="before">
      <li t-if="tx.state == 'pending_verification'">
        <a class="dropdown-item" t-attf-href="/marketplace/verifications/pending/#{tx.uuid_ref}">
          <i class="fa fa-hourglass-half me-2"/> Ver verificación
        </a>
      </li>
      <li t-if="tx.state == 'pending_acceptance' and tx.sudo().verification_ids[:1]">
        <a class="dropdown-item"
           t-attf-href="/marketplace/verifications/#{tx.sudo().verification_ids[:1].uuid_ref}/acceptance">
          <i class="fa fa-pencil-square-o me-2"/> Firmar el informe
        </a>
      </li>
    </xpath>

  </template>

</odoo>
