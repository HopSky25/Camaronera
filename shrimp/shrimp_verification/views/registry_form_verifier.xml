<odoo>

  <!-- ============================================================
       PERFIL «VERIFICADORA» EN EL ASISTENTE DE ALTA (19.0.1.17.0)

       Antes el verificador tenía un formulario propio (/register/verifier,
       plantilla registry_form_verifier). Ahora es un perfil más del
       asistente común (shrimp_user_registry.registry_form): en el sitio
       principal se puede marcar junto a otros perfiles y en la plataforma de
       verificadores /register y /register/verifier abren el asistente con la
       verificadora ya marcada (única opción).

       Aquí va su bloque de datos del paso «Perfil», con los MISMOS nombres
       que el formulario anterior (ver_*, team_*): los valida y guarda
       ShrimpRegistryVerifier._extra_partner_vals / _post_registration. La
       acreditación (certificado de rol verificador) se adjunta en la sección
       única de certificados del paso «Documentos» (obligatoria).
       ============================================================ -->
  <template id="signup_profile_sections_verifier" inherit_id="shrimp_user_registry.signup_profile_sections"
            name="Registro - datos de la verificadora">
    <xpath expr="//div[@id='shrimp_prof_sections_end']" position="before">
      <div t-if="'verificador' in (signup_profile_codes or [])" class="shrimp-prof-sec" data-role="verificador" id="section_verificador">
        <t t-set="v" t-value="values or {}"/>
        <div class="shrimp-prof-sec-head">
          <span class="shrimp-prof-sec-ico" aria-hidden="true"><i class="fa fa-check-square-o"/></span>
          <div class="shrimp-prof-sec-htxt">
            <h3 class="shrimp-prof-sec-title">Verificadora</h3>
            <p class="shrimp-prof-sec-desc">Lo que ve el comprador al elegirte: acreditación, cobertura, tarifa y la cuenta donde
              recibes tus honorarios. Verificas cuando la administración aprueba tu acreditación (se adjunta en «Documentos»).</p>
          </div>
        </div>
        <div class="shrimp-prof-sec-body">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label class="form-label small text-muted" for="reg_ver_rep">Responsable técnico <span class="text-danger">*</span></label>
              <input class="form-control" id="reg_ver_rep" type="text" name="ver_representante" data-req="1" maxlength="120"
                     t-att-value="v.get('ver_representante')" placeholder="Nombres y apellidos"/>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label small text-muted" for="reg_ver_tel">Teléfono de la verificadora <span class="text-danger">*</span></label>
              <input class="form-control" id="reg_ver_tel" type="tel" name="ver_telefono" data-req="1" inputmode="tel"
                     data-prefill-from="reg_phone" t-att-value="v.get('ver_telefono')" placeholder="Ej. 0991234567"/>
              <div class="form-text">Se completa con tu celular; cámbialo si los avisos van a otro número.</div>
            </div>
          </div>

          <details class="shrimp-sub" open="open">
            <summary><i class="fa fa-shield" aria-hidden="true"/> Acreditación <small>· el archivo va en «Documentos»</small></summary>
            <div class="shrimp-sub-body"><div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted" for="reg_ver_ent">Entidad que acredita</label>
                <input class="form-control" id="reg_ver_ent" type="text" name="ver_entidad_acredita" t-att-value="v.get('ver_entidad_acredita')" placeholder="Ej. SAE"/>
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label small text-muted" for="reg_ver_vig">Vigencia</label>
                <input class="form-control" id="reg_ver_vig" type="date" name="ver_acred_vigencia" t-att-value="v.get('ver_acred_vigencia')"/>
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label small text-muted" for="reg_ver_reg">N.º de licencia / registro</label>
                <input class="form-control" id="reg_ver_reg" type="text" name="ver_registro_num" t-att-value="v.get('ver_registro_num')"/>
              </div>
            </div></div>
          </details>

          <details class="shrimp-sub">
            <summary><i class="fa fa-map-o" aria-hidden="true"/> Cobertura y logística <small>(opcional)</small></summary>
            <div class="shrimp-sub-body"><div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted" for="reg_ver_prov">Provincias / zonas que cubre</label>
                <input class="form-control" id="reg_ver_prov" type="text" name="ver_provincias" t-att-value="v.get('ver_provincias')" placeholder="Guayas, El Oro, Manabí…"/>
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label small text-muted" for="reg_ver_radio">Radio (km)</label>
                <input class="form-control" id="reg_ver_radio" type="number" min="0" step="1" name="ver_radio_km" inputmode="numeric" t-att-value="v.get('ver_radio_km')"/>
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label small text-muted" for="reg_ver_resp">Tiempo de respuesta</label>
                <input class="form-control" id="reg_ver_resp" type="text" name="ver_tiempo_respuesta" t-att-value="v.get('ver_tiempo_respuesta')" placeholder="24 h"/>
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted" for="reg_ver_cob">Zona de cobertura (detalle)</label>
                <input class="form-control" id="reg_ver_cob" type="text" name="ver_cobertura" t-att-value="v.get('ver_cobertura')"/>
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted" for="reg_ver_ubic">Ubicación / base</label>
                <input class="form-control" id="reg_ver_ubic" type="text" name="ver_ubicacion" t-att-value="v.get('ver_ubicacion')" placeholder="Si es distinta de la dirección"/>
              </div>
              <div class="col-12">
                <label class="form-check" for="reg_ver_equipo">
                  <input class="form-check-input" type="checkbox" value="1" id="reg_ver_equipo" name="ver_equipo_propio"
                         t-att-checked="'checked' if v.get('ver_equipo_propio') else None"/>
                  <span>Moviliza equipo propio (vehículo / instrumentos) a campo</span>
                </label>
              </div>
            </div></div>
          </details>

          <details class="shrimp-sub">
            <summary><i class="fa fa-flask" aria-hidden="true"/> Capacidades técnicas <small>(opcional)</small></summary>
            <div class="shrimp-sub-body"><div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted" for="reg_ver_anal">Tipos de análisis que realiza</label>
                <textarea class="form-control" id="reg_ver_anal" name="ver_analisis_tipos" rows="2" placeholder="Peso, presentación, metabisulfito, clasificación, sabor…"><t t-esc="v.get('ver_analisis_tipos') or ''"/></textarea>
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted" for="reg_ver_eq">Equipos / instrumentos</label>
                <textarea class="form-control" id="reg_ver_eq" name="ver_equipos" rows="2" placeholder="Balanza calibrada, kit de metabisulfito…"><t t-esc="v.get('ver_equipos') or ''"/></textarea>
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted" for="reg_ver_cap">Capacidad diaria (lotes)</label>
                <input class="form-control" id="reg_ver_cap" type="number" min="0" step="1" name="ver_capacidad_lotes_dia" inputmode="numeric" t-att-value="v.get('ver_capacidad_lotes_dia')"/>
              </div>
            </div></div>
          </details>

          <details class="shrimp-sub">
            <summary><i class="fa fa-address-book" aria-hidden="true"/> Contacto operativo <small>(opcional)</small></summary>
            <div class="shrimp-sub-body"><div class="row g-3">
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted" for="reg_ver_mail">Correo de avisos</label>
                <input class="form-control" id="reg_ver_mail" type="email" name="ver_email_avisos" t-att-value="v.get('ver_email_avisos')"/>
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted" for="reg_ver_wa">WhatsApp / teléfono alterno</label>
                <input class="form-control" id="reg_ver_wa" type="tel" name="ver_whatsapp" t-att-value="v.get('ver_whatsapp')"/>
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted" for="reg_ver_hor">Horario de atención</label>
                <input class="form-control" id="reg_ver_hor" type="text" name="ver_horario" t-att-value="v.get('ver_horario')" placeholder="Lun-Vie 8:00-17:00"/>
              </div>
            </div></div>
          </details>

          <details class="shrimp-sub">
            <summary><i class="fa fa-money" aria-hidden="true"/> Tarifa y facturación <small>(opcional)</small></summary>
            <div class="shrimp-sub-body"><div class="row g-3">
              <div class="col-6">
                <label class="form-label small text-muted" for="reg_ver_fee">Honorario base por verificación (USD)</label>
                <input class="form-control" id="reg_ver_fee" type="number" step="0.01" min="0" name="ver_fee_base" inputmode="decimal" t-att-value="v.get('ver_fee_base')"/>
              </div>
              <div class="col-6">
                <label class="form-label small text-muted" for="reg_ver_feelb">Honorario por libra (USD)</label>
                <input class="form-control" id="reg_ver_feelb" type="number" step="0.0001" min="0" name="ver_fee_por_lb" inputmode="decimal" t-att-value="v.get('ver_fee_por_lb')"/>
              </div>
              <div class="col-12"><div class="form-text mt-0">Es el honorario que paga el comprador que te elige: base + USD por libra × cantidad (0,02 = 2 centavos por libra).</div></div>
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted" for="reg_ver_ruc">RUC de facturación</label>
                <input class="form-control" id="reg_ver_ruc" type="text" name="ver_ruc" inputmode="numeric" maxlength="13" t-att-value="v.get('ver_ruc')"/>
              </div>
              <div class="col-12 col-md-8">
                <label class="form-label small text-muted" for="reg_ver_rf">Razón social fiscal</label>
                <input class="form-control" id="reg_ver_rf" type="text" name="ver_razon_fiscal" t-att-value="v.get('ver_razon_fiscal')"/>
              </div>
              <div class="col-12">
                <label class="form-label small text-muted" for="reg_ver_df">Dirección fiscal</label>
                <input class="form-control" id="reg_ver_df" type="text" name="ver_dir_fiscal" t-att-value="v.get('ver_dir_fiscal')"/>
              </div>
            </div></div>
          </details>

          <details class="shrimp-sub">
            <summary><i class="fa fa-university" aria-hidden="true"/> Cuenta bancaria para cobros <small>(opcional)</small></summary>
            <div class="shrimp-sub-body"><div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted" for="reg_ver_bank">Banco</label>
                <input class="form-control" id="reg_ver_bank" type="text" name="ver_bank_name" t-att-value="v.get('ver_bank_name')"/>
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted" for="reg_ver_btype">Tipo de cuenta</label>
                <select class="form-select" id="reg_ver_btype" name="ver_bank_account_type">
                  <option value="">Elige…</option>
                  <option value="ahorros" t-att-selected="'selected' if v.get('ver_bank_account_type') == 'ahorros' else None">Ahorros</option>
                  <option value="corriente" t-att-selected="'selected' if v.get('ver_bank_account_type') == 'corriente' else None">Corriente</option>
                </select>
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted" for="reg_ver_bnum">N.º de cuenta</label>
                <input class="form-control" id="reg_ver_bnum" type="text" name="ver_bank_account_number" inputmode="numeric" t-att-value="v.get('ver_bank_account_number')"/>
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted" for="reg_ver_bhold">Titular</label>
                <input class="form-control" id="reg_ver_bhold" type="text" name="ver_bank_holder" t-att-value="v.get('ver_bank_holder')"/>
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted" for="reg_ver_bhid">Cédula / RUC del titular</label>
                <input class="form-control" id="reg_ver_bhid" type="text" name="ver_bank_holder_id" inputmode="numeric" t-att-value="v.get('ver_bank_holder_id')"/>
              </div>
            </div></div>
          </details>

          <!-- Equipo de campo (19.0.1.18.0): opcional; cada técnico entra con su
               propia cuenta (también desde «Mi equipo»). Como los certificados
               del paso «Documentos»: «Agregar técnico» abre un modal y lo
               guardado queda en una tabla (Editar / Eliminar). Cada fila lleva
               sus campos ocultos con los MISMOS nombres de siempre
               (team_<n>_name / _email / _password / _role), que lee
               ShrimpRegistryVerifier._post_registration. data-initial: las
               filas devueltas tras un error del servidor (sin contraseña).
               Lógica: shrimp_verification/static/src/js/signup_team.js. -->
          <details class="shrimp-sub" id="verTeamSub">
            <summary><i class="fa fa-users" aria-hidden="true"/> Equipo de campo <small>(opcional · también después desde «Mi equipo»)
              <span class="shrimp-team-count" id="teamCount" aria-live="polite"></span></small></summary>
            <div class="shrimp-sub-body">
              <div class="shrimp-team" id="shrimpTeam" t-att-data-initial="signup_team_json or '[]'" data-max="20">
                <p class="shrimp-cert-empty" id="teamEmpty">Aún no agregaste técnicos. Cada uno entra con su propio correo y
                  contraseña y solo ve las verificaciones que le asignes.</p>
                <div class="shrimp-tech-wrap" id="teamWrap" hidden="hidden">
                  <table class="shrimp-tech-table" aria-describedby="teamCount">
                    <caption class="visually-hidden">Técnicos del equipo de campo</caption>
                    <thead>
                      <tr><th scope="col">Nombre</th><th scope="col">Correo</th><th scope="col">Cargo</th>
                        <th scope="col" class="shrimp-tech-acts-h">Acciones</th></tr>
                    </thead>
                    <tbody id="teamBody"></tbody>
                  </table>
                </div>
                <button type="button" class="shrimp-cert-addrow" id="teamAdd">
                  <i class="fa fa-plus" aria-hidden="true"/> Agregar técnico <span class="shrimp-cert-addhint" id="teamAddHint">hasta 20</span>
                </button>
                <p class="visually-hidden" id="teamLive" aria-live="polite"></p>
                <noscript><p class="small text-muted mb-0 mt-2">Activa JavaScript para agregar técnicos; también puedes
                  hacerlo después desde «Mi equipo».</p></noscript>
              </div>
            </div>
          </details>

          <!-- Modal del técnico: sus campos NO tienen name (se copian a la fila
               al guardar). Al iniciar se mueve a <body>, fuera del <form>. En
               el móvil ocupa toda la pantalla (mismo estilo que el modal de
               certificados: .shrimp-cmodal). -->
          <div class="modal fade shrimp-cmodal shrimp-tmodal" id="shrimpTeamModal" tabindex="-1" role="dialog" aria-modal="true"
               aria-labelledby="shrimpTmTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
              <div class="modal-content">
                <div class="modal-header">
                  <h3 class="modal-title" id="shrimpTmTitle"><i class="fa fa-user-plus" aria-hidden="true"/> <span>Agregar técnico</span></h3>
                  <button type="button" class="shrimp-cm-x" data-cm-close="1" aria-label="Cerrar"><i class="fa fa-times" aria-hidden="true"/></button>
                </div>
                <div class="modal-body">
                  <p class="shrimp-cm-prof">Entra con su propio correo y contraseña y solo ve las verificaciones que le asignes.</p>
                  <div class="row g-3">
                    <div class="col-12">
                      <label class="form-label" for="shrimpTmName">Nombre <span class="text-danger">*</span></label>
                      <input class="form-control" id="shrimpTmName" type="text" maxlength="120" autocomplete="off"
                             placeholder="Nombres y apellidos" aria-describedby="shrimpTmNameErr"/>
                      <div class="shrimp-cm-err" id="shrimpTmNameErr" hidden="hidden" role="alert"></div>
                    </div>
                    <div class="col-12 col-sm-7">
                      <label class="form-label" for="shrimpTmEmail">Correo <span class="text-danger">*</span></label>
                      <input class="form-control" id="shrimpTmEmail" type="email" maxlength="120" autocomplete="off" inputmode="email"
                             placeholder="tecnico@empresa.com" aria-describedby="shrimpTmEmailHelp shrimpTmEmailErr"/>
                      <div class="form-text" id="shrimpTmEmailHelp">Será su usuario para entrar.</div>
                      <div class="shrimp-cm-err" id="shrimpTmEmailErr" hidden="hidden" role="alert"></div>
                    </div>
                    <div class="col-12 col-sm-5">
                      <label class="form-label" for="shrimpTmRole">Cargo</label>
                      <select class="form-select" id="shrimpTmRole">
                        <option value="">Técnico de campo (por defecto)</option>
                        <t t-foreach="request.env['shrimp.tech.role'].sudo().search([])" t-as="r">
                          <option t-att-value="r.uuid_ref"><t t-esc="r.name"/></option>
                        </t>
                      </select>
                    </div>
                    <div class="col-12 col-sm-6">
                      <label class="form-label" for="shrimpTmPw">Contraseña <span class="text-danger">*</span></label>
                      <div class="shrimp-pw">
                        <input class="form-control" id="shrimpTmPw" type="password" autocomplete="new-password" minlength="8"
                               placeholder="Mínimo 8 caracteres" aria-describedby="shrimpTmPwHelp shrimpTmPwErr"/>
                        <button type="button" class="shrimp-pw-eye" id="shrimpTmEye" aria-pressed="false" aria-controls="shrimpTmPw shrimpTmPw2"
                                title="Mostrar contraseña"><i class="fa fa-eye" aria-hidden="true"/><span class="visually-hidden">Mostrar contraseña</span></button>
                      </div>
                      <div class="shrimp-cm-err" id="shrimpTmPwErr" hidden="hidden" role="alert"></div>
                    </div>
                    <div class="col-12 col-sm-6">
                      <label class="form-label" for="shrimpTmPw2">Confirmar contraseña <span class="text-danger">*</span></label>
                      <input class="form-control" id="shrimpTmPw2" type="password" autocomplete="new-password"
                             placeholder="Repite la contraseña" aria-describedby="shrimpTmPw2Err"/>
                      <div class="shrimp-cm-err" id="shrimpTmPw2Err" hidden="hidden" role="alert"></div>
                    </div>
                    <div class="col-12">
                      <div class="shrimp-pw-tools">
                        <button type="button" class="shrimp-cert-btn" id="shrimpTmGen"><i class="fa fa-magic me-1" aria-hidden="true"/>Generar contraseña</button>
                        <button type="button" class="shrimp-cert-btn" id="shrimpTmCopy" hidden="hidden"><i class="fa fa-clipboard me-1" aria-hidden="true"/>Copiar</button>
                        <span class="form-text m-0" id="shrimpTmPwHelp">Compártela con el técnico: con ella entra la primera vez.</span>
                      </div>
                    </div>
                  </div>
                  <p class="form-text mt-3 mb-0">La cuenta del técnico se crea al terminar tu registro.</p>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-secondary" data-cm-close="1">Cancelar</button>
                  <button type="button" class="btn btn-primary" id="shrimpTmSave"><i class="fa fa-check me-1" aria-hidden="true"/>Guardar</button>
                </div>
              </div>
            </div>
          </div>
          <script type="text/javascript" defer="defer" src="/shrimp_verification/static/src/js/signup_team.js"/>
        </div>
      </div>
    </xpath>
  </template>

</odoo>
