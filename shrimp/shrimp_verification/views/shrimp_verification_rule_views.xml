<odoo>

  <record id="view_shrimp_verification_rule_list" model="ir.ui.view">
    <field name="name">shrimp.verification.rule.list</field>
    <field name="model">shrimp.verification.rule</field>
    <field name="arch" type="xml">
      <list string="Matriz de verificación" editable="bottom" expand="1"
            decoration-muted="policy == 'none'" decoration-warning="policy == 'mandatory'">
        <field name="sequence" widget="handle"/>
        <field name="seller_role"/>
        <field name="buyer_role" placeholder="Cualquiera"/>
        <field name="product_tipo" placeholder="Cualquiera" optional="show"/>
        <field name="policy" widget="badge"
               decoration-muted="policy == 'none'" decoration-info="policy == 'optional'"
               decoration-warning="policy == 'mandatory'"/>
        <field name="note" optional="show"/>
        <field name="active" widget="boolean_toggle" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_verification_rule_search" model="ir.ui.view">
    <field name="name">shrimp.verification.rule.search</field>
    <field name="model">shrimp.verification.rule</field>
    <field name="arch" type="xml">
      <search string="Matriz de verificación">
        <field name="seller_role"/>
        <field name="buyer_role"/>
        <filter name="f_none" string="No aplica" domain="[('policy', '=', 'none')]"/>
        <filter name="f_optional" string="Opcional" domain="[('policy', '=', 'optional')]"/>
        <filter name="f_mandatory" string="Obligatoria" domain="[('policy', '=', 'mandatory')]"/>
        <separator/>
        <filter name="f_archived" string="Archivadas" domain="[('active', '=', False)]"/>
        <group>
          <filter name="g_seller" string="Perfil vendedor" context="{'group_by': 'seller_role'}"/>
          <filter name="g_policy" string="Verificación" context="{'group_by': 'policy'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_shrimp_verification_rule" model="ir.actions.act_window">
    <field name="name">Matriz de verificación</field>
    <field name="res_model">shrimp.verification.rule</field>
    <field name="view_mode">list</field>
    <field name="context">{'search_default_g_seller': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Define cuándo una compra lleva verificación en campo</p>
      <p>Una regla por pareja de perfiles (vendedor → comprador), opcionalmente
        por tipo de producto: <b>No aplica</b> (compra directa, sin verificación),
        <b>Opcional</b> (el comprador decide) u <b>Obligatoria</b> (solo con verificación).
        Gana la regla más específica. Sin regla: el camarón adulto es obligatorio
        y el resto opcional.</p>
    </field>
  </record>

  <menuitem id="menu_shrimp_verification_rule"
            name="Matriz de verificación"
            parent="menu_shrimp_verification_config"
            action="action_shrimp_verification_rule"
            sequence="10"
            groups="shrimp_verification.group_verification_manager"/>

</odoo>
