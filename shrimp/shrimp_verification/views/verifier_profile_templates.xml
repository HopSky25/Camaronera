<odoo>

  <!-- ================= PERFIL DEL VERIFICADOR ================= -->
  <template id="verifier_profile" name="Verificador - Perfil y cuenta">
    <t t-call="website.layout">
      <div class="shrimp-bg vr-bg">
        <div class="vr-page vrp sf-fields">
          <header class="vr-ph">
            <div class="vr-ph-txt">
              <div class="vr-eyebrow"><i class="fa fa-id-badge"/> Perfil de la verificadora</div>
              <h1 t-esc="empresa.name"/>
              <p class="vr-ph-sub">Datos de tu empresa verificadora, acreditación, tarifa y la cuenta bancaria donde recibes tus honorarios.</p>
              <div class="vr-ph-meta">
                <span t-if="empresa.verifier_is_accredited" class="vr-pill vr-pill--ok">Acreditada</span>
                <span t-else="" class="vr-pill vr-pill--warn">Sin acreditación vigente</span>
                <span t-if="empresa.verifier_rating_count"><i class="fa fa-star"/><t t-esc="'{:.1f}'.format(empresa.verifier_rating_avg)"/> (<t t-esc="empresa.verifier_rating_count"/> reseñas)</span>
              </div>
            </div>
          </header>
          <div class="vr-alerts">
            <div t-if="error" class="pf-alert pf-a-bad" role="alert"><i class="fa fa-exclamation-triangle"/><div t-esc="message or 'No se pudo guardar.'"/></div>
            <div t-if="saved" class="pf-alert vr-a-ok" role="status"><i class="fa fa-check-circle"/><div>Datos guardados.</div></div>
            <div t-if="not es_admin" class="pf-alert pf-a-info" role="note"><i class="fa fa-lock"/><div>Solo el administrador de la empresa puede editar estos datos.</div></div>
          </div>
          <div class="vr-prof">
            <nav class="vr-nav" aria-label="Secciones del perfil">
              <ul>
                <li><a href="#vp_0"><i class="fa fa-building"/> Datos de la empresa</a></li>
                <li><a href="#vp_1"><i class="fa fa-university"/> Cuenta bancaria para cobros</a></li>
                <li><a href="#vp_2"><i class="fa fa-address-book"/> Contacto operativo</a></li>
                <li><a href="#vp_3"><i class="fa fa-map-o"/> Cobertura y logística</a></li>
                <li><a href="#vp_4"><i class="fa fa-flask"/> Capacidades técnicas</a></li>
                <li><a href="#vp_5"><i class="fa fa-certificate"/> Acreditación</a></li>
                <li><a href="#vp_6"><i class="fa fa-file-text-o"/> Facturación</a></li>
                <li><a href="#vp_7"><i class="fa fa-money"/> Tarifa</a></li>
              </ul>
            </nav>
            <div style="min-width:0;">
          <form class="vr-fields" t-att-method="'post' if es_admin else None"
                t-att-action="'/verifier/profile/save' if es_admin else None"
                t-att-enctype="'multipart/form-data' if es_admin else None">
            <input t-if="es_admin" type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

            <!-- Datos de la empresa -->
            <section class="pf-sec" id="vp_0">
              <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-building"/></span><div><h2>Datos de la empresa</h2></div></div>
              <div class="pf-sec-b">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Razón social</label>
                    <input type="text" class="form-control" name="ver_razon_social" t-att-value="empresa.shrimp_razon_social or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Responsable técnico</label>
                    <input type="text" class="form-control" name="ver_representante" t-att-value="empresa.shrimp_representante or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Teléfono</label>
                    <input type="text" class="form-control" name="ver_telefono" t-att-value="empresa.shrimp_telefono or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Ubicación</label>
                    <input type="text" class="form-control" name="ver_ubicacion" t-att-value="empresa.shrimp_ubicacion or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">N.º de registro / licencia</label>
                    <input type="text" class="form-control" name="ver_registro_num" t-att-value="empresa.ver_registro_num or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-12">
                    <label class="form-label">Zona de cobertura</label>
                    <input type="text" class="form-control" name="ver_cobertura" t-att-value="empresa.ver_cobertura or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                </div>
              </div>
            </section>

            <!-- Cuenta bancaria -->
            <section class="pf-sec" id="vp_1">
              <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-university"/></span><div><h2>Cuenta bancaria para cobros</h2><p>Aquí se depositan tus honorarios de verificación.</p></div></div>
              <div class="pf-sec-b">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Banco</label>
                    <input type="text" class="form-control" name="ver_bank_name" t-att-value="empresa.ver_bank_name or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Tipo de cuenta</label>
                    <select class="form-select" name="ver_bank_account_type" t-att-disabled="not es_admin or None">
                      <option value="">— Seleccionar —</option>
                      <option value="ahorros" t-att-selected="empresa.ver_bank_account_type == 'ahorros'">Ahorros</option>
                      <option value="corriente" t-att-selected="empresa.ver_bank_account_type == 'corriente'">Corriente</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">N.º de cuenta</label>
                    <!-- Al técnico solo se le enseñan los 4 últimos dígitos. -->
                    <input type="text" class="form-control" name="ver_bank_account_number" t-att-value="(empresa.ver_bank_account_number or '') if es_admin else (empresa.ver_bank_account_number and ('•••• ' + empresa.ver_bank_account_number[-4:]) or '')" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Titular de la cuenta</label>
                    <input type="text" class="form-control" name="ver_bank_holder" t-att-value="empresa.ver_bank_holder or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Cédula/RUC del titular</label>
                    <input type="text" class="form-control" name="ver_bank_holder_id" t-att-value="(empresa.ver_bank_holder_id or '') if es_admin else (empresa.ver_bank_holder_id and ('•••• ' + empresa.ver_bank_holder_id[-4:]) or '')" t-att-readonly="not es_admin or None"/>
                  </div>
                </div>
              </div>
            </section>

            <!-- Contacto operativo -->
            <section class="pf-sec" id="vp_2">
              <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-address-book"/></span><div><h2>Contacto operativo</h2></div></div>
              <div class="pf-sec-b">
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label">Email de avisos</label>
                    <input type="email" class="form-control" name="ver_email_avisos" t-att-value="empresa.ver_email_avisos or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">WhatsApp / teléfono alterno</label>
                    <input type="text" class="form-control" name="ver_whatsapp" t-att-value="empresa.ver_whatsapp or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Horario de atención</label>
                    <input type="text" class="form-control" name="ver_horario" t-att-value="empresa.ver_horario or ''" placeholder="Lun-Vie 8:00-17:00" t-att-readonly="not es_admin or None"/>
                  </div>
                </div>
              </div>
            </section>

            <!-- Cobertura y logística -->
            <section class="pf-sec" id="vp_3">
              <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-map-o"/></span><div><h2>Cobertura y logística</h2></div></div>
              <div class="pf-sec-b">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Provincias / zonas que cubre</label>
                    <input type="text" class="form-control" name="ver_provincias" t-att-value="empresa.ver_provincias or ''" placeholder="Guayas, El Oro, Manabí…" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Radio de cobertura (km)</label>
                    <input type="number" min="0" class="form-control" name="ver_radio_km" t-att-value="empresa.ver_radio_km or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Tiempo de respuesta</label>
                    <input type="text" class="form-control" name="ver_tiempo_respuesta" t-att-value="empresa.ver_tiempo_respuesta or ''" placeholder="24 h" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-12">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="1" id="ver_equipo_propio" name="ver_equipo_propio" t-att-checked="empresa.ver_equipo_propio or None" t-att-disabled="not es_admin or None"/>
                      <label class="form-check-label" for="ver_equipo_propio">Moviliza equipo propio (vehículo/instrumentos) a campo</label>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <!-- Capacidades técnicas -->
            <section class="pf-sec" id="vp_4">
              <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-flask"/></span><div><h2>Capacidades técnicas</h2></div></div>
              <div class="pf-sec-b">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Tipos de análisis que realiza</label>
                    <textarea class="form-control" name="ver_analisis_tipos" rows="2" placeholder="Peso, presentación, metabisulfito, clasificación, sabor…" t-att-readonly="not es_admin or None"><t t-esc="empresa.ver_analisis_tipos or ''"/></textarea>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Equipos / instrumentos</label>
                    <textarea class="form-control" name="ver_equipos" rows="2" placeholder="Balanza calibrada, kit de metabisulfito…" t-att-readonly="not es_admin or None"><t t-esc="empresa.ver_equipos or ''"/></textarea>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Capacidad diaria de lotes</label>
                    <input type="number" min="0" class="form-control" name="ver_capacidad_lotes_dia" t-att-value="empresa.shrimp_capacity_value or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                </div>
              </div>
            </section>

            <!-- Acreditación -->
            <section class="pf-sec" id="vp_5">
              <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-certificate"/></span><div><h2>Acreditación</h2></div></div>
              <div class="pf-sec-b">
                <t t-set="acc_line" t-value="empresa.verifier_accreditation_line_id"/>
                <div class="vr-acc">
                  <span t-attf-class="vr-ico #{'vr-ico--ok' if empresa.verifier_is_accredited else 'vr-ico--warn'}"><i t-attf-class="fa fa-#{'check-circle' if empresa.verifier_is_accredited else 'hourglass-half'}"/></span>
                  <div style="min-width:0; flex:1 1 220px;">
                    <b t-if="empresa.verifier_is_accredited">Acreditación aprobada y vigente</b>
                    <b t-else="">Acreditación pendiente o vencida</b>
                    <span>
                      <t t-if="acc_line and acc_line.expiry_date">Vigente hasta el <t t-esc="acc_line.expiry_date.strftime('%d/%m/%Y')"/>. </t>
                      <t t-if="empresa.verifier_is_accredited">Los compradores te ven en la lista de verificadoras.</t>
                      <t t-else="">Sin acreditación vigente no recibes órdenes nuevas.</t>
                    </span>
                  </div>
                  <a t-if="empresa.ver_acred_cert" href="/verifier/profile/accreditation" target="_blank" class="s-btn s-btn-ghost btn-sm"><i class="fa fa-file-pdf-o me-1"/> Ver certificado</a>
                </div>
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label">N.º de licencia / registro</label>
                    <input type="text" class="form-control" name="ver_registro_num" t-att-value="empresa.ver_registro_num or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Entidad que acredita</label>
                    <input type="text" class="form-control" name="ver_entidad_acredita" t-att-value="empresa.ver_entidad_acredita or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Vigencia</label>
                    <input type="date" class="form-control" name="ver_acred_vigencia" t-att-value="empresa.ver_acred_vigencia or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-12">
                    <label class="form-label">Certificado de acreditación (PDF)</label>
                    <t t-if="empresa.ver_acred_cert">
                      <div class="mb-2">
                        <a href="/verifier/profile/accreditation?download=1"
                           class="sv-evidence"><i class="fa fa-file-pdf-o"/> <t t-esc="empresa.ver_acred_cert_name or 'Certificado actual'"/></a>
                      </div>
                    </t>
                    <t t-if="es_admin">
                      <input type="file" class="form-control" name="ver_acred_cert" accept="application/pdf"/>
                      <div class="form-text">Sube un PDF para reemplazar el certificado. Si dejas el campo vacío, se conserva el actual.</div>
                    </t>
                  </div>
                </div>
              </div>
            </section>

            <!-- Facturación -->
            <section class="pf-sec" id="vp_6">
              <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-file-text-o"/></span><div><h2>Facturación</h2><p>Por si difieren de los datos operativos.</p></div></div>
              <div class="pf-sec-b">
                <div class="row g-3">
                  <div class="col-md-4">
                    <label class="form-label">RUC</label>
                    <input type="text" class="form-control" name="ver_ruc" t-att-value="empresa.ver_ruc or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-8">
                    <label class="form-label">Razón social fiscal</label>
                    <input type="text" class="form-control" name="ver_razon_fiscal" t-att-value="empresa.ver_razon_fiscal or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-12">
                    <label class="form-label">Dirección fiscal</label>
                    <input type="text" class="form-control" name="ver_dir_fiscal" t-att-value="empresa.ver_dir_fiscal or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                </div>
              </div>
            </section>

            <!-- Tarifa -->
            <section class="pf-sec" id="vp_7">
              <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-money"/></span><div><h2>Tarifa</h2><p>Es el honorario que se le cobra al comprador que te elige: base + USD por libra × cantidad. Sin tarifa, se aplica la de la plataforma.</p></div></div>
              <div class="pf-sec-b">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Honorario base por verificación (USD)</label>
                    <input type="number" step="0.01" min="0" class="form-control" name="ver_fee_base" t-att-value="empresa.ver_fee_base or ''" t-att-readonly="not es_admin or None"/>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Honorario por libra (USD)</label>
                    <input type="number" step="0.0001" min="0" class="form-control" name="ver_fee_por_lb" t-att-value="empresa.ver_fee_por_lb or ''" t-att-readonly="not es_admin or None"/>
                    <div class="form-text">En dólares por libra: 0,02 = 2 centavos por libra. Con 1.000 lb y base $250 serían $270.</div>
                    <label t-if="es_admin" class="form-check mt-2 small">
                      <input type="checkbox" class="form-check-input" name="ver_fee_por_lb_confirm" value="1"/>
                      <span class="form-check-label">Confirmo esta tarifa por libra aunque sea de 0,50 USD o más.</span>
                    </label>
                  </div>
                </div>
              </div>
            </section>

            <div t-if="es_admin" class="vr-savebar">
              <span class="vr-savebar-t"><i class="fa fa-info-circle me-1"/>Los cambios se aplican al guardar.</span>
              <span class="vr-savebar-acts"><button type="submit" class="s-btn s-btn-primary"><i class="fa fa-check me-1"/> Guardar cambios</button></span>
            </div>
          </form>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- ================= MIS REPORTES ================= -->
  <!-- OJO con el formato de cadena: el operador % dentro de un t-esc
       revienta el render con "incomplete format" porque QWeb vuelve a aplicar
       formato sobre el resultado. En este proyecto se usa str.format(). -->
  <template id="verifier_reports" name="Verificador - Mis reportes">
    <t t-call="website.layout">
      <t t-set="tot_fin" t-value="stats['finalizadas'] or 0"/>
      <div class="shrimp-bg vr-bg">
        <div class="vr-page vrp">
          <header class="vr-ph">
            <div class="vr-ph-txt">
              <div class="vr-eyebrow"><i class="fa fa-bar-chart"/> Reportes</div>
              <h1>Mis reportes</h1>
              <p class="vr-ph-sub">Resumen de la actividad de <t t-esc="empresa.name"/>: verificaciones, resultados y honorarios.</p>
            </div>
            <div class="vr-ph-acts"><a class="s-btn s-btn-ghost" href="/verifier/inbox"><i class="fa fa-inbox me-1"/> Ir a la bandeja</a></div>
          </header>

          <div class="vr-kpis">
            <div class="vr-kpi"><span class="vr-ico"><i class="fa fa-clipboard"/></span><span><span class="vr-kpi-v" t-esc="stats['total']"/><span class="vr-kpi-l">Verificaciones</span></span></div>
            <div class="vr-kpi"><span class="vr-ico vr-ico--warn"><i class="fa fa-hourglass-half"/></span><span><span class="vr-kpi-v" t-esc="stats['abiertas']"/><span class="vr-kpi-l">Abiertas</span></span></div>
            <div class="vr-kpi"><span class="vr-ico vr-ico--ok"><i class="fa fa-check-circle"/></span><span><span class="vr-kpi-v" t-esc="'{:.0f} %'.format(stats['tasa_aprob'])"/><span class="vr-kpi-l">Tasa de aprobación</span></span></div>
            <div class="vr-kpi"><span class="vr-ico"><i class="fa fa-money"/></span><span><span class="vr-kpi-v">$<t t-esc="'{:,.0f}'.format(stats['honorarios'])"/></span><span class="vr-kpi-l">Honorarios de la empresa</span></span></div>
          </div>

          <div class="vr-layout">
            <div class="vr-main">
              <section class="pf-sec">
                <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-history"/></span><div><h2>Últimas verificaciones <span class="vr-count" t-esc="len(ultimas)"/></h2><p>Las diez más recientes.</p></div></div>
                <div class="pf-sec-b">
                  <table t-if="ultimas" class="vr-table vr-table--stack">
                    <thead><tr><th>Referencia</th><th>Producto</th><th>Técnicos</th><th class="vr-num">Rend.</th><th>Estado</th></tr></thead>
                    <tbody>
                      <t t-foreach="ultimas" t-as="v">
                        <tr>
                          <td class="vr-td-main" data-label="Referencia"><a t-attf-href="/verifier/verifications/#{v.uuid_ref}" t-esc="v.name"/></td>
                          <td data-label="Producto" t-esc="v.product_id.name"/>
                          <td data-label="Técnicos"><t t-esc="v.technician_partner_id.name or '—'"/><span t-if="v.support_technician_ids" class="vr-muted small"> +<t t-esc="len(v.support_technician_ids)"/> apoyo</span></td>
                          <td class="vr-num" data-label="Rendimiento" t-esc="'{:.1f} %'.format(v.yield_pct) if v.total_processed_lb else '—'"/>
                          <td data-label="Estado"><span t-attf-class="vr-pill vr-pill--sm vr-pill--#{v.state}" t-esc="dict(v._fields['state'].selection).get(v.state)"/></td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                  <div t-else="" class="vr-empty"><span class="vr-ico"><i class="fa fa-clipboard"/></span><h3>Aún no tienes verificaciones</h3><p>Cuando un comprador te elija, la orden aparecerá en tu bandeja.</p></div>
                </div>
              </section>
            </div>
            <aside class="vr-aside">
              <section class="pf-sec mb-0">
                <div class="pf-sec-h"><span class="vr-ico"><i class="fa fa-gavel"/></span><div><h2>Veredictos</h2><p><t t-esc="tot_fin"/> finalizadas</p></div></div>
                <div class="pf-sec-b">
                  <div class="vr-bars">
                    <div class="vr-bar-row"><span>Aprobadas</span><span class="vr-bar vr-bar--ok"><span t-attf-style="width: #{(100.0 * stats['aprobadas'] / tot_fin) if tot_fin else 0}%"/></span><b t-esc="stats['aprobadas']"/></div>
                    <div class="vr-bar-row"><span>Rechazadas</span><span class="vr-bar vr-bar--bad"><span t-attf-style="width: #{(100.0 * stats['rechazadas'] / tot_fin) if tot_fin else 0}%"/></span><b t-esc="stats['rechazadas']"/></div>
                  </div>
                  <dl class="vr-facts mt-3">
                    <div><dt>Rendimiento promedio</dt><dd t-esc="'{:.1f} %'.format(stats['avg_yield'])"/></div>
                    <div><dt>Abiertas</dt><dd t-esc="stats['abiertas']"/></div>
                  </dl>
                </div>
              </section>
            </aside>
          </div>
        </div>
      </div>
    </t>
  </template>

</odoo>
