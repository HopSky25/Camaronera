<odoo>
  <record id="seq_shrimp_transaction" model="ir.sequence">
    <field name="name">Shrimp Transaction</field>
    <field name="code">shrimp.transaction</field>
    <field name="prefix">TXN-</field>
    <field name="padding">6</field>
  </record>

  <record id="seq_shrimp_check_request" model="ir.sequence">
        <field name="name">Solicitud de chequeo</field>
        <field name="code">shrimp.check.request</field>
        <field name="prefix">CHK/</field>
        <field name="padding">5</field>
    </record>

  <record id="seq_shrimp_charge" model="ir.sequence">
        <field name="name">Cobro de comisión</field>
        <field name="code">shrimp.charge</field>
        <field name="prefix">CHG/</field>
        <field name="padding">5</field>
    </record>

</odoo>
