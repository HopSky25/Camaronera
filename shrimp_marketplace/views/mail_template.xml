<odoo>
    <record id="mail_template_shrimp_check_request" model="mail.template">
        <field name="name">Solicitud de chequeo marketplace</field>
        <field name="model_id" ref="model_shrimp_check_request" />
        <field name="subject">Solicitud de chequeo - {{ object.name }}</field>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Se ha generado una nueva solicitud de chequeo.</p>
                <p><strong>Referencia:</strong> <t t-out="object.name or ''"/></p>
                <p><strong>Producto:</strong> <t t-out="object.product_id.name or ''"/></p>
                <p><strong>Especie:</strong> <t t-out="object.product_id.species_id.name or ''"/></p>
                <p><strong>Etapa:</strong> <t t-out="object.product_id.stage_id.name or ''"/></p>
                <p><strong>Línea genética:</strong> <t t-out="object.product_id.genetics_line_id.name or ''"/></p>
                <p><strong>Vendedor:</strong> <t t-out="object.seller_partner_id.name or ''"/></p>
                <p><strong>Comprador:</strong> <t t-out="object.buyer_partner_id.name or ''"/></p>
                <p><strong>Cantidad:</strong> <t t-out="object.qty or ''"/> <t t-out="object.uom_id.name or ''"/></p>
                <p><strong>Estado:</strong> <t t-out="object.state or ''"/></p>
            </div>
        </field>
    </record>

    <!-- Producto creado -->
    <record id="mail_template_shrimp_product_created" model="mail.template">
        <field name="name">Producto creado - Marketplace</field>
        <field name="model_id" ref="model_shrimp_product" />
        <field name="subject">Tu producto "{{ object.name }}" se creó correctamente</field>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="body_html" type="html">
            <div style="font-family:Inter,Arial,sans-serif; color:#0d1b26;">
                <p>Hola <t t-out="object.seller_partner_id.name or ''"/>,</p>
                <p>Tu producto se <strong>creó correctamente</strong> y quedó guardado como
                   <strong>borrador</strong>. Puedes revisarlo y publicarlo cuando quieras.</p>
                <table style="border-collapse:collapse; margin:12px 0;">
                    <tr><td style="padding:4px 12px 4px 0; color:#55636d;">Producto</td><td style="padding:4px 0; font-weight:700;"><t t-out="object.name or ''"/></td></tr>
                    <tr><td style="padding:4px 12px 4px 0; color:#55636d;">Especie</td><td style="padding:4px 0;"><t t-out="object.species_id.name or '—'"/></td></tr>
                    <tr><td style="padding:4px 12px 4px 0; color:#55636d;">Etapa</td><td style="padding:4px 0;"><t t-out="object.stage_id.name or '—'"/></td></tr>
                    <tr><td style="padding:4px 12px 4px 0; color:#55636d;">Cantidad</td><td style="padding:4px 0;"><t t-out="object.initial_qty or ''"/> <t t-out="object.uom_id.name or ''"/></td></tr>
                    <tr><td style="padding:4px 12px 4px 0; color:#55636d;">Precio</td><td style="padding:4px 0;">$<t t-out="object.price or ''"/></td></tr>
                </table>
                <p style="color:#55636d; font-size:13px;">Marketplace de camarón con trazabilidad.</p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Producto publicado -->
    <record id="mail_template_shrimp_product_published" model="mail.template">
        <field name="name">Producto publicado - Marketplace</field>
        <field name="model_id" ref="model_shrimp_product" />
        <field name="subject">Tu producto "{{ object.name }}" ya está publicado</field>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="body_html" type="html">
            <div style="font-family:Inter,Arial,sans-serif; color:#0d1b26;">
                <p>Hola <t t-out="object.seller_partner_id.name or ''"/>,</p>
                <p>Tu producto <strong><t t-out="object.name or ''"/></strong> ya está
                   <strong>publicado</strong> y visible en el marketplace. ¡Los compradores ya pueden verlo!</p>
                <table style="border-collapse:collapse; margin:12px 0;">
                    <tr><td style="padding:4px 12px 4px 0; color:#55636d;">Disponible</td><td style="padding:4px 0; font-weight:700;"><t t-out="object.available_qty or ''"/> <t t-out="object.uom_id.name or ''"/></td></tr>
                    <tr><td style="padding:4px 12px 4px 0; color:#55636d;">Precio</td><td style="padding:4px 0;">$<t t-out="object.price or ''"/></td></tr>
                </table>
                <p style="color:#55636d; font-size:13px;">Marketplace de camarón con trazabilidad.</p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
