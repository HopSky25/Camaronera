<odoo>
  <!-- Convierte los menús "Productos", "Operaciones" y "Mi cuenta" en DROPDOWNs
       reales (cada sección es un menú independiente en la barra superior). -->
  <template id="submenu_mi_panel_dropdown" inherit_id="website.submenu" name="Menús del panel (dropdowns)">

    <!-- 1) No renderizar el enlace plano para nuestros 3 menús (los sustituyen los dropdowns) -->
    <xpath expr="//li[1]" position="attributes">
      <attribute name="t-if">submenu.is_visible and not (submenu.child_id or submenu.is_mega_menu) and submenu.name not in ('Productos', 'Operaciones', 'Mi cuenta')</attribute>
    </xpath>

    <!-- 2) Insertar los dropdowns -->
    <xpath expr="//li[1]" position="before">

      <!-- ===== Menú: Productos ===== -->
      <li t-if="submenu.is_visible and submenu.name == 'Productos'"
          t-attf-class="#{item_class or ''} dropdown" role="presentation">
        <a href="#"
           t-attf-class="dropdown-toggle #{link_class or ''} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}"
           data-bs-toggle="dropdown" data-bs-auto-close="outside" role="menuitem">
          <span t-field="submenu.name"/>
        </a>
        <ul t-attf-class="dropdown-menu mp-menu #{dropdown_menu_classes}" role="menu">
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/products/new"><span class="mp-menu-ico mp-mi-green"><i class="fa fa-plus-circle"/></span><span>Publicar producto</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/products"><span class="mp-menu-ico mp-mi-blue"><i class="fa fa-cubes"/></span><span>Mis productos</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace"><span class="mp-menu-ico mp-mi-teal"><i class="fa fa-shopping-bag"/></span><span>Marketplace</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/mis-lotes"><span class="mp-menu-ico mp-mi-blue"><i class="fa fa-flask"/></span><span>Mi inventario</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/mis-instalaciones"><span class="mp-menu-ico mp-mi-teal"><i class="fa fa-map-o"/></span><span>Instalaciones y piscinas</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/solicitudes"><span class="mp-menu-ico mp-mi-amber"><i class="fa fa-check-square-o"/></span><span>Solicitudes de chequeo</span></a></li>
        </ul>
      </li>

      <!-- ===== Menú: Operaciones ===== -->
      <li t-if="submenu.is_visible and submenu.name == 'Operaciones'"
          t-attf-class="#{item_class or ''} dropdown" role="presentation">
        <a href="#"
           t-attf-class="dropdown-toggle #{link_class or ''} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}"
           data-bs-toggle="dropdown" data-bs-auto-close="outside" role="menuitem">
          <span t-field="submenu.name"/>
        </a>
        <ul t-attf-class="dropdown-menu mp-menu #{dropdown_menu_classes}" role="menu">
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/compras"><span class="mp-menu-ico mp-mi-blue"><i class="fa fa-shopping-cart"/></span><span>Historial de compras</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/ventas"><span class="mp-menu-ico mp-mi-green"><i class="fa fa-line-chart"/></span><span>Ventas realizadas</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/precios"><span class="mp-menu-ico mp-mi-amber"><i class="fa fa-tags"/></span><span>Precios por cliente</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/planificacion"><span class="mp-menu-ico mp-mi-teal"><i class="fa fa-tasks"/></span><span>Planificación</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/reportes"><span class="mp-menu-ico mp-mi-green"><i class="fa fa-bar-chart"/></span><span>Mis reportes</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/calendar"><span class="mp-menu-ico mp-mi-amber"><i class="fa fa-calendar"/></span><span>Calendario de entregas</span></a></li>
        </ul>
      </li>

      <!-- ===== Menú: Mi cuenta ===== -->
      <li t-if="submenu.is_visible and submenu.name == 'Mi cuenta'"
          t-attf-class="#{item_class or ''} dropdown" role="presentation">
        <a href="#"
           t-attf-class="dropdown-toggle #{link_class or ''} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}"
           data-bs-toggle="dropdown" data-bs-auto-close="outside" role="menuitem">
          <span t-field="submenu.name"/>
        </a>
        <ul t-attf-class="dropdown-menu mp-menu #{dropdown_menu_classes}" role="menu">
          <li><a role="menuitem" class="dropdown-item mp-menu-item" href="/marketplace/mi-cuenta"><span class="mp-menu-ico mp-mi-coral"><i class="fa fa-user-o"/></span><span>Mi cuenta y certificados</span></a></li>
          <li><a role="menuitem" class="dropdown-item mp-menu-item fw-semibold" href="/my"><span class="mp-menu-ico mp-mi-navy"><i class="fa fa-th-large"/></span><span>Ver panel completo</span></a></li>
        </ul>
      </li>

    </xpath>

  </template>

  <!-- Header overlay SOLO en la portada (path '/'): el header se posiciona
       absolute sobre el contenido, así el hero arranca en y=0 y el color de
       fondo llega hasta el borde superior (la navbar flota encima). En las
       demás páginas el header sigue en flujo normal. -->
  <template id="layout_overlay_home" inherit_id="website.layout" name="Header overlay en portadas">
    <xpath expr="//div[@id='wrapwrap']" position="attributes">
      <attribute name="t-attf-class" add="#{'o_header_overlay' if request and request.httprequest.path == '/' else ''}" separator=" "/>
      <!-- Marca el sitio de verificadores para aplicar la paleta VERDE/teal
           a todas sus páginas (banners, botones, acentos). -->
      <attribute name="t-attf-class" add="#{'o_shrimp_verifier' if website and website.sudo().shrimp_is_verifier_site else ''}" separator=" "/>
    </xpath>
  </template>
</odoo>
