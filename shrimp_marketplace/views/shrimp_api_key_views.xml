<odoo>

    <record id="view_shrimp_api_key_list" model="ir.ui.view">
        <field name="name">shrimp.api.key.list</field>
        <field name="model">shrimp.api.key</field>
        <field name="arch" type="xml">
            <list string="Claves de API">
                <field name="name"/>
                <field name="user_id"/>
                <field name="scope"/>
                <field name="active"/>
                <field name="last_used"/>
                <field name="call_count"/>
            </list>
        </field>
    </record>

    <record id="view_shrimp_api_key_form" model="ir.ui.view">
        <field name="name">shrimp.api.key.form</field>
        <field name="model">shrimp.api.key</field>
        <field name="arch" type="xml">
            <form string="Clave de API">
                <header>
                    <button name="action_regenerate_key" type="object"
                            string="Regenerar clave" class="btn-secondary"
                            confirm="Esto invalidará la clave actual. ¿Continuar?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="p. ej. Integración ERP"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="scope"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="key" readonly="1"/>
                            <field name="last_used"/>
                            <field name="call_count"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p><strong>Cómo usar la API</strong></p>
                        <p>Envía la clave en la cabecera <code>X-API-Key</code> (o <code>Authorization: Bearer &lt;clave&gt;</code>).</p>
                        <ul>
                            <li><code>GET  /api/v1/products</code> — listar productos</li>
                            <li><code>GET  /api/v1/products/&lt;id&gt;</code> — detalle</li>
                            <li><code>POST /api/v1/products</code> — crear (nivel write)</li>
                            <li><code>PUT  /api/v1/products/&lt;id&gt;</code> — editar (nivel write)</li>
                            <li><code>DELETE /api/v1/products/&lt;id&gt;</code> — archivar (nivel write)</li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shrimp_api_key" model="ir.actions.act_window">
        <field name="name">Claves de API</field>
        <field name="res_model">shrimp.api.key</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shrimp_api_key" name="Claves de API"
              parent="menu_shrimp_config_root" action="action_shrimp_api_key" sequence="50"/>

</odoo>
