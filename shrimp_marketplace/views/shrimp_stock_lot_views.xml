<odoo>
  <data>

    <!-- =========================================================
         SHRIMP STOCK LOT
         ========================================================= -->

    <!-- SEARCH -->
    <record id="view_shrimp_stock_lot_search" model="ir.ui.view">
      <field name="name">shrimp.stock.lot.search</field>
      <field name="model">shrimp.stock.lot</field>
      <field name="arch" type="xml">
        <search string="Buscar lotes">
          <field name="product_id" />
          <field name="owner_id" />
          <field name="origin_move_id" />
          <field name="state" />

          <separator />

          <filter string="Disponibles" name="available" domain="[('state','=','available')]" />
          <filter string="Consumidos" name="consumed" domain="[('state','=','consumed')]" />

          <separator />

          <filter string="Con stock" name="with_stock" domain="[('available_qty','&gt;',0)]" />
          <filter string="Sin stock" name="without_stock" domain="[('available_qty','&lt;=',0)]" />

          <!-- <group expand="0" string="Agrupar por">
            <filter string="Producto" name="grp_product" context="{'group_by': 'product_id'}" />
            <filter string="Propietario" name="grp_owner" context="{'group_by': 'owner_id'}" />
            <filter string="Estado" name="grp_state" context="{'group_by': 'state'}" />
            <filter string="Movimiento origen" name="grp_origin_move"
              context="{'group_by': 'origin_move_id'}" />
          </group> -->
        </search>
      </field>
    </record>

    <!-- LIST -->
    <record id="view_shrimp_stock_lot_tree" model="ir.ui.view">
      <field name="name">shrimp.stock.lot.tree</field>
      <field name="model">shrimp.stock.lot</field>
      <field name="arch" type="xml">
        <list string="Lotes de stock" default_order="create_date desc">
          <field name="product_id" />
          <field name="owner_id" />
          <field name="origin_move_id" />
          <field name="initial_qty" />
          <field name="available_qty" />
          <field name="uom_id" />
          <field name="state" widget="badge" />
          <field name="create_date" />
        </list>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_shrimp_stock_lot_form" model="ir.ui.view">
      <field name="name">shrimp.stock.lot.form</field>
      <field name="model">shrimp.stock.lot</field>
      <field name="arch" type="xml">
        <form string="Lote de stock" create="0" delete="0">
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="product_id" readonly="1" />
              </h1>
            </div>

            <group>
              <group string="Información general">
                <field name="product_id" readonly="1" />
                <field name="owner_id" readonly="1" />
                <field name="origin_move_id" readonly="1" />
                <field name="state" readonly="1" />
              </group>
              <group string="Cantidades">
                <field name="initial_qty" readonly="1" />
                <field name="available_qty" readonly="1" />
                <field name="uom_id" readonly="1" />
                <field name="create_date" readonly="1" />
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ACTION -->
    <record id="action_shrimp_stock_lot" model="ir.actions.act_window">
      <field name="name">Lotes de stock</field>
      <field name="res_model">shrimp.stock.lot</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_shrimp_stock_lot_search" />
    </record>


    <!-- =========================================================
         SHRIMP STOCK MOVE
         ========================================================= -->

    <!-- SEARCH -->
    <record id="view_shrimp_stock_move_search" model="ir.ui.view">
      <field name="name">shrimp.stock.move.search</field>
      <field name="model">shrimp.stock.move</field>
      <field name="arch" type="xml">
        <search string="Buscar movimientos">
          <field name="product_id" />
          <field name="source_partner_id" />
          <field name="dest_partner_id" />
          <field name="transaction_id" />
          <field name="parent_move_id" />

          <separator />

          <filter string="Con transacción" name="with_tx" domain="[('transaction_id','!=',False)]" />
          <filter string="Sin transacción" name="without_tx" domain="[('transaction_id','=',False)]" />

          <separator />

          <!-- <group expand="0" string="Agrupar por">
            <filter string="Producto" name="grp_product" context="{'group_by': 'product_id'}" />
            <filter string="Origen" name="grp_source" context="{'group_by': 'source_partner_id'}" />
            <filter string="Destino" name="grp_dest" context="{'group_by': 'dest_partner_id'}" />
            <filter string="Fecha" name="grp_date" context="{'group_by': 'date'}" />
            <filter string="Transacción" name="grp_tx" context="{'group_by': 'transaction_id'}" />
          </group> -->
        </search>
      </field>
    </record>

    <!-- LIST -->
    <record id="view_shrimp_stock_move_tree" model="ir.ui.view">
      <field name="name">shrimp.stock.move.tree</field>
      <field name="model">shrimp.stock.move</field>
      <field name="arch" type="xml">
        <list string="Movimientos de stock" default_order="date desc">
          <field name="date" />
          <field name="product_id" />
          <field name="source_partner_id" />
          <field name="dest_partner_id" />
          <field name="qty" />
          <field name="transaction_id" />
          <field name="parent_move_id" />
          <field name="create_date" />
        </list>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_shrimp_stock_move_form" model="ir.ui.view">
      <field name="name">shrimp.stock.move.form</field>
      <field name="model">shrimp.stock.move</field>
      <field name="arch" type="xml">
        <form string="Movimiento de stock" create="0" delete="0">
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="product_id" readonly="1" />
              </h1>
            </div>

            <group>
              <group string="Trazabilidad">
                <field name="product_id" readonly="1" />
                <field name="source_partner_id" readonly="1" />
                <field name="dest_partner_id" readonly="1" />
                <field name="parent_move_id" readonly="1" />
              </group>
              <group string="Detalle">
                <field name="qty" readonly="1" />
                <field name="transaction_id" readonly="1" />
                <field name="date" readonly="1" />
                <field name="create_date" readonly="1" />
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ACTION -->
    <record id="action_shrimp_stock_move" model="ir.actions.act_window">
      <field name="name">Movimientos de stock</field>
      <field name="res_model">shrimp.stock.move</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_shrimp_stock_move_search" />
    </record>


    <!-- =========================================================
         MENUS
         ========================================================= -->

    <!-- Ajusta parent según tu menú raíz real -->
