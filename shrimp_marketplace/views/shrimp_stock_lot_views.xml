              name="Lotes"
              parent="menu_shrimp_stock_root"
              action="action_shrimp_stock_lot"
              sequence="10"/>

    <menuitem id="menu_shrimp_stock_move"
              name="Movimientos"
              parent="menu_shrimp_stock_root"
              action="action_shrimp_stock_move"
              sequence="20"/> -->

  </data>
</odoo>