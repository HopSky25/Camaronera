<odoo>
  <record id="view_shrimp_transaction_tree" model="ir.ui.view">
    <field name="name">shrimp.transaction.list</field>
    <field name="model">shrimp.transaction</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="transaction_type"/>
        <field name="seller_partner_id"/>
        <field name="buyer_partner_id"/>
        <field name="state"/>
        <field name="sold_date"/>
        <field name="desired_date"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_transaction_form" model="ir.ui.view">
    <field name="name">shrimp.transaction.form</field>
    <field name="model">shrimp.transaction</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancel"/>
        </header>
        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name="transaction_type"/>
            <field name="product_id"/>
            <field name="seller_partner_id"/>
            <field name="buyer_partner_id"/>
            <field name="location"/>
          </group>

          <notebook>
            <page string="Semillero → Lab">
              <group>
                <field name="invoice_attachment_ids" widget="many2many_binary"/>
                <field name="production_note"/>
                <field name="sold_qty"/>
                <field name="sold_date"/>
              </group>
            </page>

            <page string="Lab → Camaronera">
              <group>
                <field name="desired_qty"/>
                <field name="desired_date"/>
                <field name="code"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_shrimp_transaction" model="ir.actions.act_window">
    <field name="name">Transacciones</field>
    <field name="res_model">shrimp.transaction</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
