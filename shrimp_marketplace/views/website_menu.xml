<odoo>
  <!-- Enlaces del marketplace en la barra superior del sitio -->
  <record id="menu_marketplace_page" model="website.menu">
    <field name="name">Marketplace</field>
    <field name="url">/marketplace</field>
    <field name="parent_id" ref="website.main_menu"/>
    <field name="sequence" eval="20"/>
  </record>

  <!-- "Mi panel": enlace al portal con todas las secciones -->
  <record id="menu_panel_root" model="website.menu">
    <field name="name">Mi panel</field>
    <field name="url">/my</field>
    <field name="parent_id" ref="website.main_menu"/>
    <field name="sequence" eval="25"/>
  </record>
</odoo>
