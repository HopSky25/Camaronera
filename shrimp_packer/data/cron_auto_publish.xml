<odoo>
  <!-- Publica solas las listas programadas cuya fecha ya llegó.
       Corre a diario; el método salta las que aún no toca. -->
  <record id="ir_cron_price_list_auto_publish" model="ir.cron">
    <field name="name">Listas de precios: publicación automática</field>
    <field name="model_id" ref="model_shrimp_price_list"/>
    <field name="state">code</field>
    <field name="code">model._cron_auto_publish()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
