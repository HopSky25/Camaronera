            <field name="expires_required">1</field>
            <field name="duration_value">1</field>
            <field name="duration_period">years</field>
            <field name="active">1</field>
        </record>

        <!-- Los PCR no "vencen": son el resultado de una corrida sobre un
             lote concreto, igual que los análisis microbiológicos de más
             arriba. Por eso expires_required = 0 y duración 0. -->
        <record id="shrimp_certificate_pcr_wssv" model="shrimp.certificate">
            <field name="sequence">170</field>
            <field name="name">Análisis PCR de WSSV</field>
            <field name="issuer">Laboratorio de diagnóstico acreditado</field>
            <field name="role">semillero</field>
            <field name="certificate_type">biosecurity</field>
            <field name="code">PCR-WSSV</field>
            <field name="description">Resultado de PCR para el virus del síndrome de la mancha blanca sobre el lote de larvas.</field>
            <field name="expires_required">0</field>
            <field name="duration_value">0</field>
            <field name="duration_period">days</field>
            <field name="active">1</field>
        </record>

