        <!-- ============================================================
             SEMILLERO (laboratorio de larvas / hatchery)
             ============================================================
             El desplegable de "Añadir certificado" filtra por
             role in (tipo_usuario, 'all'); sin registros con role
             "semillero" el semillero no podía acreditar absolutamente nada
             y la demo terminaba colgándole papeles de otros roles.

             Los emisores se dejan con el nombre institucional genérico y
             correcto (Agrocalidad, Subsecretaría de Acuicultura, Global
             Seafood Alliance, laboratorio acreditado): NO se inventan
             números de resolución ni de acuerdo ministerial, que son
             propios de cada empresa y se capturan en la línea del usuario.
        -->

        <record id="shrimp_certificate_registro_larvas" model="shrimp.certificate">
            <field name="sequence">150</field>
            <field name="name">Registro de centro de producción de larvas</field>
            <field name="issuer">Agrocalidad</field>
            <field name="role">semillero</field>
            <field name="certificate_type">biosecurity</field>
            <field name="code">AGRO-LARVAS</field>
            <field name="description">Registro sanitario del laboratorio de larvas como centro de producción acuícola ante Agrocalidad.</field>
            <field name="expires_required">1</field>
            <field name="duration_value">2</field>
            <field name="duration_period">years</field>
            <field name="active">1</field>
        </record>

