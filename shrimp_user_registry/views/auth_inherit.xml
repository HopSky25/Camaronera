<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="login_change_signup_link" inherit_id="auth_signup.login">
    <xpath expr="//a[contains(@href, 'signup') or contains(@t-attf-href, 'signup') or contains(@t-att-href, 'signup')]" position="attributes">
      <attribute name="href">/registro</attribute>
      <attribute name="t-att-href"></attribute>
      <attribute name="t-attf-href"></attribute>
    </xpath>
  </template>
</odoo>