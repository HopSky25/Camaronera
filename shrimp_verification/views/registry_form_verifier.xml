<odoo>

  <!-- ============================================================
       REGISTRO DEDICADO DEL VERIFICADOR (/registro/verificador)
       Formulario propio, separado del registro de los tres roles del
       marketplace. Guarda todos los datos de la empresa verificadora,
       su acreditación (certificados), cuenta bancaria y, opcionalmente,
       su equipo de técnicos.
       ============================================================ -->
  <template id="registry_form_verifier" name="Registro - Verificador">
    <t t-call="website.layout">
      <t t-set="certs"
         t-value="request.env['shrimp.certificate'].sudo().search([('active','=',True),('role','in',['verificador','all'])], order='sequence, name')"/>
      <t t-set="roles" t-value="request.env['shrimp.tech.role'].sudo().search([])"/>
      <div class="shrimp-bg">
        <div class="shrimp-page shrimp-page--full py-4 sf-fields">

          <div class="sf-banner mb-4">
            <div class="sf-banner-row">
              <div class="sf-banner-txt">
                <h1>Regístrate como verificador</h1>
                <p>Crea la cuenta de tu empresa verificadora: acreditación, cobertura,
                   tarifa y la cuenta donde recibes tus honorarios. Podrás agregar a
                   tu equipo aquí mismo o después.</p>
              </div>
              <span class="sf-kicker"><i class="fa fa-shield"></i> Acreditación</span>
            </div>
          </div>

          <t t-if="error">
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle me-1"/> <t t-esc="error"/></div>
          </t>

          <form method="post" action="/registro/submit" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="shrimp_user_type" value="verificador"/>

            <!-- ===== Datos básicos ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-user"></i></span>
                <h3 class="mp-sec-title">Datos de la cuenta</h3>
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Nombre para mostrar <span class="text-danger">*</span></label>
                  <input class="form-control" name="name" required="required" placeholder="Ej. Verificadora del Pacífico" t-att-value="values.get('name') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">RUC o Cédula <span class="text-danger">*</span></label>
                  <input class="form-control" name="vat_or_id" required="required" placeholder="Ej. 0999999999001" t-att-value="values.get('vat_or_id') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Correo (será tu usuario) <span class="text-danger">*</span></label>
                  <input type="email" class="form-control" name="email" required="required" placeholder="correo@ejemplo.com" t-att-value="values.get('email') if values else ''"/>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Contraseña <span class="text-danger">*</span></label>
                  <input type="password" class="form-control" name="password" id="regPass" minlength="8" required="required" placeholder="Mínimo 8 caracteres"/>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Confirmar <span class="text-danger">*</span></label>
                  <input type="password" class="form-control" id="regPass2" placeholder="Repite la contraseña"/>
                  <div class="form-text" id="regPassMsg"></div>
                </div>
              </div>
            </div></div>

            <!-- ===== Empresa y acreditación ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-building"></i></span>
                <h3 class="mp-sec-title">Empresa y acreditación</h3>
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Razón social <span class="text-danger">*</span></label>
                  <input class="form-control" name="ver_razon_social" required="required" t-att-value="values.get('ver_razon_social') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Responsable técnico <span class="text-danger">*</span></label>
                  <input class="form-control" name="ver_representante" required="required" t-att-value="values.get('ver_representante') if values else ''"/>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Teléfono <span class="text-danger">*</span></label>
                  <input class="form-control" name="ver_telefono" required="required" t-att-value="values.get('ver_telefono') if values else ''"/>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Ubicación / base</label>
                  <input class="form-control" name="ver_ubicacion" t-att-value="values.get('ver_ubicacion') if values else ''"/>
                </div>
                <div class="col-md-4">
                  <label class="form-label">N.º de licencia / registro</label>
                  <input class="form-control" name="ver_registro_num" t-att-value="values.get('ver_registro_num') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Entidad que acredita</label>
                  <input class="form-control" name="ver_entidad_acredita" t-att-value="values.get('ver_entidad_acredita') if values else ''"/>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Vigencia</label>
                  <input type="date" class="form-control" name="ver_acred_vigencia" t-att-value="values.get('ver_acred_vigencia') if values else ''"/>
                </div>
              </div>
            </div></div>

            <!-- ===== Contacto operativo ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-address-book"></i></span>
                <h3 class="mp-sec-title">Contacto operativo</h3>
              </div>
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label">Email de avisos</label>
                  <input type="email" class="form-control" name="ver_email_avisos" t-att-value="values.get('ver_email_avisos') if values else ''"/>
                </div>
                <div class="col-md-4">
                  <label class="form-label">WhatsApp / teléfono alterno</label>
                  <input class="form-control" name="ver_whatsapp" t-att-value="values.get('ver_whatsapp') if values else ''"/>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Horario de atención</label>
                  <input class="form-control" name="ver_horario" placeholder="Lun-Vie 8:00-17:00" t-att-value="values.get('ver_horario') if values else ''"/>
                </div>
              </div>
            </div></div>

            <!-- ===== Cobertura y logística ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-map-o"></i></span>
                <h3 class="mp-sec-title">Cobertura y logística</h3>
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Provincias / zonas que cubre</label>
                  <input class="form-control" name="ver_provincias" placeholder="Guayas, El Oro, Manabí…" t-att-value="values.get('ver_provincias') if values else ''"/>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Radio (km)</label>
                  <input type="number" min="0" class="form-control" name="ver_radio_km" t-att-value="values.get('ver_radio_km') if values else ''"/>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Tiempo de respuesta</label>
                  <input class="form-control" name="ver_tiempo_respuesta" placeholder="24 h" t-att-value="values.get('ver_tiempo_respuesta') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Zona de cobertura (detalle)</label>
                  <input class="form-control" name="ver_cobertura" t-att-value="values.get('ver_cobertura') if values else ''"/>
                </div>
                <div class="col-12">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="1" id="ver_equipo_propio" name="ver_equipo_propio"/>
                    <label class="form-check-label" for="ver_equipo_propio">Moviliza equipo propio (vehículo/instrumentos) a campo</label>
                  </div>
                </div>
              </div>
            </div></div>

            <!-- ===== Capacidades técnicas ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-flask"></i></span>
                <h3 class="mp-sec-title">Capacidades técnicas</h3>
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Tipos de análisis que realiza</label>
                  <textarea class="form-control" name="ver_analisis_tipos" rows="2" placeholder="Peso, presentación, metabisulfito, clasificación, sabor…"><t t-esc="values.get('ver_analisis_tipos') if values else ''"/></textarea>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Equipos / instrumentos</label>
                  <textarea class="form-control" name="ver_equipos" rows="2" placeholder="Balanza calibrada, kit de metabisulfito…"><t t-esc="values.get('ver_equipos') if values else ''"/></textarea>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Capacidad diaria de lotes</label>
                  <input type="number" min="0" class="form-control" name="ver_capacidad_lotes_dia" t-att-value="values.get('ver_capacidad_lotes_dia') if values else ''"/>
                </div>
              </div>
            </div></div>

            <!-- ===== Facturación ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-file-text-o"></i></span>
                <h3 class="mp-sec-title">Facturación</h3>
              </div>
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label">RUC</label>
                  <input class="form-control" name="ver_ruc" t-att-value="values.get('ver_ruc') if values else ''"/>
                </div>
                <div class="col-md-8">
                  <label class="form-label">Razón social fiscal</label>
                  <input class="form-control" name="ver_razon_fiscal" t-att-value="values.get('ver_razon_fiscal') if values else ''"/>
                </div>
                <div class="col-12">
                  <label class="form-label">Dirección fiscal</label>
                  <input class="form-control" name="ver_dir_fiscal" t-att-value="values.get('ver_dir_fiscal') if values else ''"/>
                </div>
              </div>
            </div></div>

            <!-- ===== Tarifa ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-money"></i></span>
                <h3 class="mp-sec-title">Tarifa</h3>
              </div>
              <p class="text-muted" style="font-size:13px; margin-top:-6px;">Se muestra al comprador al elegirte.</p>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Honorario base por verificación (USD)</label>
                  <input type="number" step="0.01" min="0" class="form-control" name="ver_fee_base" t-att-value="values.get('ver_fee_base') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Honorario por libra (USD)</label>
                  <input type="number" step="0.0001" min="0" class="form-control" name="ver_fee_por_lb" t-att-value="values.get('ver_fee_por_lb') if values else ''"/>
                </div>
              </div>
            </div></div>

            <!-- ===== Cuenta bancaria ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-university"></i></span>
                <h3 class="mp-sec-title">Cuenta bancaria para cobros</h3>
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Banco</label>
                  <input class="form-control" name="ver_bank_name" t-att-value="values.get('ver_bank_name') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Tipo de cuenta</label>
                  <select class="form-select" name="ver_bank_account_type">
                    <option value="">— Seleccionar —</option>
                    <option value="ahorros">Ahorros</option>
                    <option value="corriente">Corriente</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">N.º de cuenta</label>
                  <input class="form-control" name="ver_bank_account_number" t-att-value="values.get('ver_bank_account_number') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Titular</label>
                  <input class="form-control" name="ver_bank_holder" t-att-value="values.get('ver_bank_holder') if values else ''"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Cédula/RUC del titular</label>
                  <input class="form-control" name="ver_bank_holder_id" t-att-value="values.get('ver_bank_holder_id') if values else ''"/>
                </div>
              </div>
            </div></div>

            <!-- ===== Certificados / acreditación (archivos) ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head">
                <span class="mp-sec-ico"><i class="fa fa-certificate"></i></span>
                <h3 class="mp-sec-title">Certificados y acreditación</h3>
              </div>
              <p class="text-muted" style="font-size:13px; margin-top:-6px;">
                Adjunta al menos la acreditación que te autoriza a verificar (PDF/JPG/PNG).
                Sube solo los que tengas; el resto déjalos vacíos.
              </p>
              <t t-if="certs">
                <div class="table-responsive">
                  <table class="table align-middle mb-0">
                    <thead>
                      <tr><th>Certificado</th><th>N.º / código</th><th>Emisión</th><th>Vigencia</th><th>Archivo</th></tr>
                    </thead>
                    <tbody>
                      <t t-foreach="certs" t-as="c">
                        <tr>
                          <td style="min-width:180px;">
                            <input type="hidden" t-attf-name="cert_line_#{c_index}_id" t-att-value="c.id"/>
                            <strong t-esc="c.name"/>
                            <div class="sv-muted small"><t t-esc="c.issuer"/></div>
                          </td>
                          <td><input class="form-control form-control-sm" t-attf-name="cert_line_#{c_index}_number"/></td>
                          <td><input type="date" class="form-control form-control-sm" t-attf-name="cert_line_#{c_index}_issue_date"/></td>
                          <td><input type="date" class="form-control form-control-sm" t-attf-name="cert_line_#{c_index}_expiry_date"/></td>
                          <td><input type="file" class="form-control form-control-sm" t-attf-name="cert_line_#{c_index}_file" accept=".pdf,.jpg,.jpeg,.png"/></td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </div>
              </t>
              <t t-else="">
                <div class="alert alert-warning mb-0">No hay certificados de verificador configurados en el catálogo.</div>
              </t>
            </div></div>

            <!-- ===== Mi equipo (opcional) ===== -->
            <div class="mp-table-card mb-4"><div class="card-body p-4">
              <div class="mp-sec-head" style="justify-content:space-between;">
                <div style="display:flex; align-items:center; gap:12px;">
                  <span class="mp-sec-ico"><i class="fa fa-users"></i></span>
                  <h3 class="mp-sec-title">Mi equipo <span class="sv-muted" style="font-weight:600; font-size:14px;">(opcional)</span></h3>
                </div>
                <button type="button" class="s-btn s-btn-ghost btn-sm" id="teamAdd"><i class="fa fa-plus me-1"/> Agregar técnico</button>
              </div>
              <p class="text-muted" style="font-size:13px; margin-top:-6px;">
                Cada técnico entra con su propia cuenta. Puedes agregarlos ahora o después desde “Mi equipo”.
              </p>
              <div id="teamRows"></div>
            </div></div>

            <div class="alert alert-info d-flex align-items-start gap-2" role="alert">
              <i class="fa fa-info-circle mt-1"/>
              <div>
                <strong>Aprobación requerida.</strong>
                Al enviar este formulario, la creación de su cuenta quedará sujeta a la
                revisión y aprobación de los administradores de la plataforma. Podrá
                comenzar a operar como verificador únicamente una vez que su registro y
                su acreditación hayan sido validados. Le notificaremos por correo el
                resultado de la revisión.
              </div>
            </div>

            <div class="text-end mb-5">
              <button type="submit" class="s-btn s-btn-primary"><i class="fa fa-check me-1"/> Crear cuenta</button>
            </div>
          </form>

        </div>
      </div>

      <!-- Filas de equipo dinámicas y validación de contraseña -->
      <script>
        (function () {
          // ---- Confirmación de contraseña ----
          var p1 = document.getElementById('regPass'),
              p2 = document.getElementById('regPass2'),
              msg = document.getElementById('regPassMsg');
          function checkPass() {
            if (p2.value &amp;&amp; p1.value !== p2.value) {
              msg.textContent = 'No coinciden'; msg.style.color = '#b3261e';
              p2.setCustomValidity('Las contraseñas no coinciden');
            } else {
              msg.textContent = ''; p2.setCustomValidity('');
            }
          }
          if (p1 &amp;&amp; p2) { p1.addEventListener('input', checkPass); p2.addEventListener('input', checkPass); }

          // ---- Filas dinámicas de equipo ----
          var rows = document.getElementById('teamRows'), n = 0;
          var roleOpts = '<option value="">— Cargo —</option>' +
            [<t t-foreach="roles" t-as="r">{"id": <t t-esc="r.id"/>, "name": "<t t-esc="r.name"/>"},</t>]
            .map(function (r) { return '<option value="' + r.id + '">' + r.name + '</option>'; }).join('');
          function addRow() {
            var i = n++;
            var div = document.createElement('div');
            div.className = 'row g-2 align-items-end mb-2';
            div.innerHTML =
              '<div class="col-md-3"><input class="form-control form-control-sm" name="team_' + i + '_name" placeholder="Nombre"/></div>' +
              '<div class="col-md-3"><input type="email" class="form-control form-control-sm" name="team_' + i + '_email" placeholder="Correo"/></div>' +
              '<div class="col-md-2"><input type="text" class="form-control form-control-sm" name="team_' + i + '_password" placeholder="Contraseña"/></div>' +
              '<div class="col-md-3"><select class="form-select form-select-sm" name="team_' + i + '_role">' + roleOpts + '</select></div>' +
              '<div class="col-md-1"><button type="button" class="s-btn s-btn-ghost btn-sm w-100" title="Quitar">&#215;</button></div>';
            div.querySelector('button').addEventListener('click', function () { div.remove(); });
            rows.appendChild(div);
          }
          var addBtn = document.getElementById('teamAdd');
          if (addBtn) addBtn.addEventListener('click', addRow);
        })();
      </script>
    </t>
  </template>

</odoo>
