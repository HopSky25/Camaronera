<odoo>

  <record id="view_shrimp_taste_criterion_list" model="ir.ui.view">
    <field name="name">shrimp.taste.criterion.list</field>
    <field name="model">shrimp.taste.criterion</field>
    <field name="arch" type="xml">
      <list string="Criterios de cata" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_shrimp_taste_criterion_form" model="ir.ui.view">
    <field name="name">shrimp.taste.criterion.form</field>
    <field name="model">shrimp.taste.criterion</field>
    <field name="arch" type="xml">
      <form string="Criterio de cata">
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_shrimp_taste_criterion" model="ir.actions.act_window">
    <field name="name">Criterios de cata</field>
    <field name="res_model">shrimp.taste.criterion</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_shrimp_taste_criterion"
            name="Criterios de cata"
            parent="menu_shrimp_verification_root"
            action="action_shrimp_taste_criterion"
            sequence="40"/>

</odoo>
