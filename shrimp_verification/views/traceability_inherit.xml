<odoo>

  <template id="traceability_screen_verification"
            inherit_id="shrimp_marketplace.traceability_screen"
            name="Trazabilidad - bloque de verificación">

    <!-- El certificado PDF no se ofrece mientras la compra sigue pendiente:
         la cadena de custodia todavía no existe. -->
    <xpath expr="//button[hasclass('js-cert-view')]" position="attributes">
      <attribute name="t-if">tx.state not in ('pending_verification', 'cancel')</attribute>
    </xpath>

    <!-- La verificación en campo forma parte de la trazabilidad del lote. -->
    <xpath expr="//div[hasclass('mp-table-card')][1]" position="after">
      <t t-set="ver" t-value="tx.verification_id[:1]"/>
      <t t-if="ver">
        <div class="mp-table-card mb-4">
          <div class="card-body p-4">
            <div class="mp-sec-head">
              <span class="mp-sec-ico"><i class="fa fa-shield"/></span>
              <h3 class="mp-sec-title">Verificación en campo</h3>
            </div>

            <div t-attf-class="sv-alert sv-alert--#{'ready' if ver.state in ('approved','approved_obs') else ('wait' if ver.state in ('assigned','in_field','done') else 'wait')} mb-3">
              <strong>
                <t t-if="ver.state == 'assigned'">Asignada, pendiente de visita</t>
                <t t-elif="ver.state == 'in_field'">Inspección en curso</t>
                <t t-elif="ver.state == 'done'">Informe completo, a la espera del veredicto</t>
                <t t-elif="ver.state == 'approved'">Aprobada</t>
                <t t-elif="ver.state == 'approved_obs'">Aprobada con observaciones</t>
                <t t-elif="ver.state == 'rejected'">Rechazada</t>
                <t t-else="">Cancelada</t>
              </strong>
              <div class="small mt-1">
                <t t-esc="ver.name"/> · verificador
                <strong t-esc="ver.verifier_partner_id.name"/>
                <t t-if="ver.verified_date"> · <t t-esc="ver.verified_date"/></t>
              </div>
            </div>

            <div class="mp-spec-grid">
              <div class="mp-spec">
                <span class="mp-spec-ico"><i class="fa fa-user-o"/></span>
                <div class="mp-spec-body">
                  <div class="mp-spec-label">Verificador</div>
                  <div class="mp-spec-value"><t t-esc="ver.verifier_partner_id.name"/></div>
                </div>
              </div>
              <div class="mp-spec" t-if="ver.batch_code">
                <span class="mp-spec-ico"><i class="fa fa-barcode"/></span>
                <div class="mp-spec-body">
                  <div class="mp-spec-label">Lote verificado</div>
                  <div class="mp-spec-value"><t t-esc="ver.batch_code"/></div>
                </div>
              </div>

              <!-- Camarón adulto: los cinco análisis -->
              <t t-if="ver.scope == 'adult'">
                <div class="mp-spec" t-if="ver.total_processed_lb">
                  <span class="mp-spec-ico"><i class="fa fa-line-chart"/></span>
                  <div class="mp-spec-body">
                    <div class="mp-spec-label">Rendimiento</div>
                    <div class="mp-spec-value"><t t-esc="'{:.2f} %'.format(ver.yield_pct)"/></div>
                  </div>
                </div>
                <div class="mp-spec" t-if="ver.total_processed_lb">
                  <span class="mp-spec-ico"><i class="fa fa-star-o"/></span>
                  <div class="mp-spec-body">
                    <div class="mp-spec-label">Clase A / B</div>
                    <div class="mp-spec-value">
                      <t t-esc="'{:.2f}'.format(ver.yield_class_a_pct)"/> % /
                      <t t-esc="'{:.2f}'.format(ver.yield_class_b_pct)"/> %
                    </div>
                  </div>
                </div>
                <div class="mp-spec" t-if="ver.metabisulfite_ppm">
                  <span class="mp-spec-ico"><i class="fa fa-flask"/></span>
                  <div class="mp-spec-body">
                    <div class="mp-spec-label">Metabisulfito</div>
                    <div class="mp-spec-value">
                      <t t-esc="'{:.2f}'.format(ver.metabisulfite_ppm)"/> ppm
                      <t t-if="ver.metabisulfite_result == 'pass'"> · conforme</t>
                      <t t-if="ver.metabisulfite_result == 'fail'"> · no conforme</t>
                    </div>
                  </div>
                </div>
                <div class="mp-spec" t-if="ver.taste_result">
                  <span class="mp-spec-ico"><i class="fa fa-cutlery"/></span>
                  <div class="mp-spec-body">
                    <div class="mp-spec-label">Sabor</div>
                    <div class="mp-spec-value"><t t-esc="ver.taste_result"/></div>
                  </div>
                </div>
              </t>

              <!-- Larva: cantidad, supervivencia, tamaño y sanidad -->
              <t t-else="">
                <div class="mp-spec" t-if="ver.larvae_qty_verified">
                  <span class="mp-spec-ico"><i class="fa fa-cubes"/></span>
                  <div class="mp-spec-body">
                    <div class="mp-spec-label">Cantidad verificada</div>
                    <div class="mp-spec-value">
                      <t t-esc="'{:.2f}'.format(ver.larvae_qty_verified)"/>
                      <t t-if="ver.larvae_qty_diff_pct">
                        (<t t-esc="'{:.2f} %'.format(ver.larvae_qty_diff_pct)"/>)
                      </t>
                    </div>
                  </div>
                </div>
                <div class="mp-spec" t-if="ver.larvae_survival_rate">
                  <span class="mp-spec-ico"><i class="fa fa-heartbeat"/></span>
                  <div class="mp-spec-body">
                    <div class="mp-spec-label">Supervivencia medida</div>
                    <div class="mp-spec-value"><t t-esc="'{:.2f} %'.format(ver.larvae_survival_rate)"/></div>
                  </div>
                </div>
                <div class="mp-spec" t-if="ver.larvae_avg_size_mg">
                  <span class="mp-spec-ico"><i class="fa fa-balance-scale"/></span>
                  <div class="mp-spec-body">
                    <div class="mp-spec-label">Tamaño medido</div>
                    <div class="mp-spec-value"><t t-esc="'{:.3f}'.format(ver.larvae_avg_size_mg)"/> mg</div>
                  </div>
                </div>
                <div class="mp-spec" t-if="ver.larvae_health_status">
                  <span class="mp-spec-ico"><i class="fa fa-stethoscope"/></span>
                  <div class="mp-spec-body">
                    <div class="mp-spec-label">Estado sanitario</div>
                    <div class="mp-spec-value"><t t-esc="ver.larvae_health_status"/></div>
                  </div>
                </div>
              </t>
            </div>

            <!-- Clasificación por tallas: es el corazón del parte de planta -->
            <t t-if="ver.scope == 'adult' and ver.line_ids">
              <h4 class="mt-4" style="font-size:15px;font-weight:700;color:#123e5c;">
                Clasificación por talla
              </h4>
              <table class="table table-sm mt-2">
                <thead>
                  <tr>
                    <th>Clase</th><th>Talla</th>
                    <th class="text-end">Libras</th><th class="text-end">% del total</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="ver.line_ids" t-as="ln">
                    <tr>
                      <td><t t-esc="dict(ln._fields['quality_class'].selection).get(ln.quality_class)"/></td>
                      <td><t t-esc="ln.size_code"/></td>
                      <td class="text-end"><t t-esc="'{:.2f}'.format(ln.weight_lb)"/></td>
                      <td class="text-end"><t t-esc="'{:.2f}'.format(ln.percent_of_total)"/></td>
                    </tr>
                  </t>
                  <tr style="font-weight:700;">
                    <td colspan="2">Total procesado</td>
                    <td class="text-end"><t t-esc="'{:.2f}'.format(ver.total_processed_lb)"/></td>
                    <td class="text-end">100,00</td>
                  </tr>
                </tbody>
              </table>
              <div class="sv-muted small">
                Peso enviado <t t-esc="'{:.2f}'.format(ver.weight_sent_lb)"/> ·
                en planta <t t-esc="'{:.2f}'.format(ver.weight_plant_lb)"/> ·
                basura <t t-esc="'{:.2f}'.format(ver.trash_lb)"/> ·
                neto <t t-esc="'{:.2f}'.format(ver.net_weight_lb)"/> lb
              </div>
            </t>

            <!-- Evidencia fotográfica tomada en campo -->
            <t t-if="ver.photo_ids">
              <h4 class="mt-4" style="font-size:15px;font-weight:700;color:#123e5c;">
                Evidencia de campo
              </h4>
              <div class="d-flex flex-wrap gap-2 mt-2">
                <t t-foreach="ver.photo_ids" t-as="foto">
                  <a t-attf-href="/marketplace/verificacion/#{ver.uuid_ref}/foto/#{foto.id}"
                     target="_blank" class="sv-evidence">
                    <img t-attf-src="/marketplace/verificacion/#{ver.uuid_ref}/foto/#{foto.id}"
                         t-att-alt="foto.name or 'Foto de campo'"/>
                  </a>
                </t>
              </div>
            </t>

            <!-- Quién verificó y con qué acreditación -->
            <t t-if="ver.verifier_partner_id.verifier_accreditation_line_id">
              <div class="mt-3">
                <a t-attf-href="/marketplace/verificador/#{ver.verifier_partner_id.uuid_ref}/acreditacion"
                   target="_blank" class="s-btn s-btn-ghost">
                  <i class="fa fa-id-badge me-1"/> Ver acreditación del verificador
                </a>
              </div>
            </t>

            <div t-if="ver.incident_notes" class="alert alert-warning mt-3 mb-0">
              <strong>Incidencias registradas:</strong>
              <div class="small mt-1"><t t-esc="ver.incident_notes"/></div>
            </div>
            <div t-if="ver.verdict_notes" class="mt-3 sv-muted small">
              <strong>Conclusión del verificador:</strong> <t t-esc="ver.verdict_notes"/>
            </div>
          </div>
        </div>
      </t>
    </xpath>

  </template>

</odoo>
