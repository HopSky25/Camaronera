<odoo>

  <!-- Portada del sitio de verificadores -->
  <template id="verifier_landing" name="Verificadores - Portada">
    <t t-call="website.layout">
      <div class="vw-page">

        <!-- ================= HERO ================= -->
        <section class="vw-hero">
          <span class="vw-orb vw-orb--1" aria-hidden="true"></span>
          <span class="vw-orb vw-orb--2" aria-hidden="true"></span>
          <span class="vw-grid" aria-hidden="true"></span>

          <div class="vw-hero-inner">
            <div class="vw-badge"><span class="vw-badge-dot"></span> Plataforma de verificación en campo</div>

            <h1 class="vw-display">
              Verifica el camarón
              <span class="vw-grad">antes de cerrar la compra.</span>
            </h1>

            <p class="vw-lead">
              Inspecciona los lotes en campo, registra los cinco análisis —peso,
              cuerpo o cola, metabisulfito, clasificación y sabor— y emite tu
              veredicto desde donde estés. El comprador solo concreta la compra
              cuando tú apruebas.
            </p>

            <div class="vw-cta">
              <t t-if="request.env.user._is_public()">
                <a href="/web/login" class="vw-btn vw-btn--primary"><i class="fa fa-sign-in me-2"/>Entrar</a>
                <a href="/registro" class="vw-btn vw-btn--glass"><i class="fa fa-shield me-2"/>Registrarme como verificador</a>
              </t>
              <t t-else="">
                <a href="/verificador/bandeja" class="vw-btn vw-btn--primary"><i class="fa fa-inbox me-2"/>Ir a mi bandeja</a>
              </t>
            </div>

            <div class="vw-hero-stats">
              <div class="vw-stat"><div class="vw-stat-num">5</div><div class="vw-stat-lbl">análisis por lote</div></div>
              <div class="vw-stat"><div class="vw-stat-num">100%</div><div class="vw-stat-lbl">trazable</div></div>
              <div class="vw-stat"><div class="vw-stat-num">Móvil</div><div class="vw-stat-lbl">informe en campo</div></div>
            </div>
          </div>
        </section>

        <!-- ================= CÓMO FUNCIONA ================= -->
        <section class="vw-section">
          <div class="vw-sec-head">
            <span class="vw-kicker">Cómo funciona</span>
            <h2>Tres pasos, de la asignación al veredicto</h2>
          </div>
          <div class="vw-steps">
            <div class="vw-step">
              <div class="vw-step-num">1</div>
              <h3>Recibes la asignación</h3>
              <p>El comprador te elige al comprar. La orden entra en tu bandeja con el lote, el vendedor y la cantidad.</p>
            </div>
            <div class="vw-step">
              <div class="vw-step-num">2</div>
              <h3>Inspeccionas en campo</h3>
              <p>Registras los análisis desde el móvil. El informe se guarda por partes: no hace falta completarlo de una sentada.</p>
            </div>
            <div class="vw-step">
              <div class="vw-step-num">3</div>
              <h3>Emites tu veredicto</h3>
              <p>Apruebas, apruebas con observaciones o rechazas. El comprador recibe el aviso y solo entonces se concreta la compra.</p>
            </div>
          </div>
        </section>

        <!-- ================= LOS 5 ANÁLISIS ================= -->
        <section class="vw-section">
          <div class="vw-analisis">
            <div class="vw-analisis-head">
              <h3><i class="fa fa-flask me-2"/>Los cinco análisis del camarón adulto</h3>
              <p class="vw-muted">Se calculan los rendimientos y el parte para WhatsApp sale en el formato de siempre.</p>
            </div>
            <div class="vw-chips">
              <span class="vw-chip"><i class="fa fa-balance-scale"/> Peso</span>
              <span class="vw-chip"><i class="fa fa-cutlery"/> Cuerpo o cola</span>
              <span class="vw-chip"><i class="fa fa-tint"/> Metabisulfito</span>
              <span class="vw-chip"><i class="fa fa-sort-amount-desc"/> Clasificación</span>
              <span class="vw-chip"><i class="fa fa-spoon"/> Sabor</span>
            </div>
            <p class="vw-analisis-note">
              <i class="fa fa-info-circle me-1"/> En larvas el informe se adapta: cantidad, supervivencia, tamaño y estado sanitario.
            </p>
          </div>
        </section>

      </div>
    </t>
  </template>

</odoo>
