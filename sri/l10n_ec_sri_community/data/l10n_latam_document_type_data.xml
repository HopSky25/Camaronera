<odoo noupdate="1">
    <!-- l10n_ec no trae la guía de remisión (06) como tipo de documento nativo. Se crea
         aquí para que cada línea del punto de emisión apunte a un tipo nativo de Odoo.
         Sin internal_type, así nunca aparece como opción en facturas. -->
    <record id="ec_dt_06_delivery_guide" model="l10n_latam.document.type">
        <field name="code">06</field>
        <field name="name">Guía de remisión</field>
        <field name="report_name">Guía de remisión</field>
        <field name="doc_code_prefix">GuiaR</field>
        <field name="country_id" ref="base.ec"/>
        <field name="sequence">60</field>
    </record>
</odoo>
