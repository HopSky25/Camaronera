<odoo>
    <!-- Permisos del módulo: en la ficha del usuario aparece "Ecuador SRI" con
         NO / Usuario / Administrador. Sin grupo (NO) se puede facturar igual: elegir
         sucursal y punto y numerar; lo que se reserva es emitir y administrar el SRI. -->
    <record id="res_groups_privilege_sri" model="res.groups.privilege">
        <field name="name">Ecuador SRI</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">8</field>
    </record>
    <record id="group_sri_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sri"/>
        <field name="comment">Envía comprobantes al SRI, consulta su autorización, corrige rechazos, imprime el RIDE, y emite retenciones y guías.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_sri_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sri"/>
        <field name="comment">Además: sucursales, puntos de emisión y secuenciales, ajustes del SRI, anulaciones, contabilización de retenciones, reportes (ATS) y cajas del POS.</field>
        <field name="implied_ids" eval="[(4, ref('group_sri_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_document_company" model="ir.rule">
        <field name="name">SRI: empresas permitidas</field><field name="model_id" ref="model_ec_sri_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_point_company" model="ir.rule">
        <field name="name">SRI puntos: empresas permitidas</field><field name="model_id" ref="model_ec_sri_point"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_retention_company" model="ir.rule">
        <field name="name">SRI retenciones: empresas permitidas</field><field name="model_id" ref="model_ec_sri_retention_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_event_company" model="ir.rule">
        <field name="name">SRI historial: empresas permitidas</field><field name="model_id" ref="model_ec_sri_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_report_company" model="ir.rule">
        <field name="name">SRI reportes: empresas permitidas</field><field name="model_id" ref="model_ec_sri_report_wizard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_driver_company" model="ir.rule">
        <field name="name">SRI transportistas: empresas permitidas</field><field name="model_id" ref="model_ec_sri_driver"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_vehicle_company" model="ir.rule">
        <field name="name">SRI vehículos: empresas permitidas</field><field name="model_id" ref="model_ec_sri_vehicle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_establishment_company" model="ir.rule">
        <field name="name">SRI establecimientos: empresas permitidas</field><field name="model_id" ref="model_ec_sri_establishment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
