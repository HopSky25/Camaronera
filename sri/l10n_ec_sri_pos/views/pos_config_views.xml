<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_sri" model="ir.ui.view">
        <field name="name">pos.config.form.sri</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Facturación electrónica SRI" name="ec_sri">
                    <field name="ec_sri_point_id"/>
                    <field name="ec_sri_final_consumer_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
